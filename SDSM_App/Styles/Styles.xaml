<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
                    xmlns:helpers="clr-namespace:Telerik.Windows.Controls.Theming.Helpers;assembly=Telerik.Windows.Controls"
                    xmlns:animation="clr-namespace:Telerik.Windows.Controls.Animation;assembly=Telerik.Windows.Controls"
                    xmlns:converter="clr-namespace:SDSM_App.Converters"
                    xmlns:behavior="clr-namespace:SDSM_App.Behaviors">

    <converter:StringToBoolConverter x:Key="StringToBoolConverter"/>

    <FontFamily x:Key="DefaultFontFamily">application:,,,/Assets/Fonts/#KoPubWorld돋움체</FontFamily>
    <FontFamily x:Key="High1FontFamily">application:,,,/Assets/Fonts/#하이원 제목 원추리체</FontFamily>
    <FontFamily x:Key="ROKGFontFamily">application:,,,/Assets/Fonts/#대한민국정부상징체 R</FontFamily>
    <sys:Double x:Key="DefaultFontSize">14.5</sys:Double>

    <!--너비-->
    <sys:Double x:Key="ContentMaxWidth">3120</sys:Double>
    <sys:Double x:Key="ContentSmallMaxWidth">1980</sys:Double>
    <sys:Double x:Key="ContentXSmallMaxWidth">1240</sys:Double>

    <!--기본높이-->
    <sys:Double x:Key="DefaultHeight">40</sys:Double>
    <sys:Double x:Key="TitleBarHeight">50</sys:Double>

    <DropShadowEffect x:Key="VisualEffect" BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.2"/>
    <DropShadowEffect x:Key="EditorVisualEffect" BlurRadius="30" ShadowDepth="1" Direction="270" Opacity="0.5"/>

    <Style x:Key="CaptionPointStyle" TargetType="telerik:RadGlyph">
        <Setter Property="Glyph" Value="{StaticResource GlyphRoundCorners}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0 2 5 0"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=IconBrush}"/>
    </Style>
    
    <!--가로선-->
    <Style x:Key="HorizontalRectangleStyle" TargetType="Rectangle">
        <Setter Property="Stroke" Value="{telerik:Windows11Resource ResourceKey=SecondaryBorderBrush}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Height" Value="1"/>
    </Style>

    <!--세로선-->
    <Style x:Key="VerticalRectangleStyle" TargetType="Rectangle">
        <Setter Property="Stroke" Value="{telerik:Windows11Resource ResourceKey=SecondaryBorderBrush}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Width" Value="1"/>
    </Style>

    <Style x:Key="ContentBoxStyle" TargetType="Border">
        <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=PrimaryBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="{telerik:Windows11Resource ResourceKey=OverlayCornerRadius}"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="PrimaryTextBlcokStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
    </Style>

    <Style x:Key="PrimaryTitleTextBlcokStyle" TargetType="TextBlock" BasedOn="{StaticResource PrimaryTextBlcokStyle}">
        <Setter Property="FontFamily" Value="{StaticResource High1FontFamily}"/>
    </Style>

    <Style x:Key="TitleStackPanelStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Margin" Value="30 20 30 0"/>
        <Setter Property="Height" Value="40"/>
    </Style>

    <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource PrimaryTextBlcokStyle}">
        <Setter Property="FontFamily" Value="{StaticResource High1FontFamily}"/>
        <Setter Property="FontSize" Value="26"/>
    </Style>

    <Style x:Key="SubTitleTextBlcokStyle" TargetType="TextBlock" BasedOn="{StaticResource PrimaryTextBlcokStyle}">
        <Setter Property="FontFamily" Value="{StaticResource High1FontFamily}"/>
        <Setter Property="FontSize" Value="19"/>
    </Style>

    <Style x:Key="TitleRadGlyphStyle" TargetType="telerik:RadGlyph">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=IconBrush}"/>
    </Style>

    <Style x:Key="InfoIconStyle" TargetType="icon:PackIconVaadinIcons">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=IconBrush}"/>
        <Setter Property="Margin" Value="0 0 15 0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="EffectBorder" TargetType="Border">
        <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=PrimaryBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="{telerik:Windows11Resource ResourceKey=OverlayCornerRadius}"/>
        <Setter Property="Effect" Value="{StaticResource VisualEffect}"/>
        <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!--종목록-->
    <Style x:Key="SubViewContentBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=OverlayBrush}"/>
        <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1 0 0 0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0 0 0 0"/>
        <Setter Property="Padding" Value="20 20 20 20"/>
        <Setter Property="MinWidth" Value="840"/>
        <Setter Property="Width" Value="840"/>
        <Setter Property="MaxWidth" Value="840"/>
    </Style>
    
    <Style x:Key="SideCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="true"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="UseLayoutRounding" Value="true"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="IsThreeState" Value="False"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
        <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=PrimaryBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="helpers:ThemeHelper.DisabledForegroundBrush" Value="{telerik:Windows11Resource ResourceKey=DisabledForegroundBrush}"/>
        <Setter Property="helpers:ThemeHelper.DisabledBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=DisabledBackgroundBrush}"/>
        <Setter Property="helpers:ThemeHelper.DisabledBrush" Value="{telerik:Windows11Resource ResourceKey=DisabledBorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Border" 
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}"
                            Padding="10 0"
                            Height="{TemplateBinding Height}"
                            CornerRadius="{telerik:Windows11Resource ResourceKey=CornerRadius}">
                        <StackPanel x:Name="Content" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="출현종 목록" VerticalAlignment="Center"/>
                            <telerik:RadGlyph x:Name="Icon" Margin="5 0 0 0" Glyph="{StaticResource GlyphArrowLeft}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" TargetName="Border" Value="{telerik:Windows11Resource ResourceKey=FocusBrush}"/>
                            <Setter Property="Background" TargetName="Border" Value="{telerik:Windows11Resource ResourceKey=MouseOverBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=AccentControlForegroundBrush}"/>
                            <Setter TargetName="Border" Property="Background" Value="{telerik:Windows11Resource ResourceKey=AccentBrush}"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=AccentBrush}"/>
                            <Setter Property="Glyph" TargetName="Icon" Value="{StaticResource GlyphClose}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Border" Property="Background" Value="{telerik:Windows11Resource ResourceKey=AccentMouseOverBrush}"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=AccentMouseOverBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledBackgroundBrush)}"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledBrush)}"/>
                            <Setter TargetName="Content" Property="TextBlock.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledForegroundBrush)}"/>
                            <Setter TargetName="Content" Property="Opacity" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AddColonyCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="true"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="UseLayoutRounding" Value="true"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="IsThreeState" Value="False"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
        <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=PrimaryBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="helpers:ThemeHelper.DisabledForegroundBrush" Value="{telerik:Windows11Resource ResourceKey=DisabledForegroundBrush}"/>
        <Setter Property="helpers:ThemeHelper.DisabledBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=DisabledBackgroundBrush}"/>
        <Setter Property="helpers:ThemeHelper.DisabledBrush" Value="{telerik:Windows11Resource ResourceKey=DisabledBorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="border" 
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}"
                            Padding="10 0"
                            Height="{TemplateBinding Height}"
                            CornerRadius="{telerik:Windows11Resource ResourceKey=CornerRadius}">
                        <Grid x:Name="content">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="25"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="textBlock" Text="새로추가" VerticalAlignment="Center"/>
                            <telerik:RadGlyph x:Name="icon" Grid.Column="1" Glyph="{StaticResource GlyphArrowChevronDown}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" TargetName="border" Value="{telerik:Windows11Resource ResourceKey=FocusBrush}"/>
                            <Setter Property="Background" TargetName="border" Value="{telerik:Windows11Resource ResourceKey=MouseOverBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=AccentControlForegroundBrush}"/>
                            <Setter TargetName="border" Property="Background" Value="#00695C"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#00695C"/>
                            <Setter Property="Glyph" TargetName="icon" Value="{StaticResource GlyphClose}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="Background" Value="#00897B"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#00897B"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledBackgroundBrush)}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledBrush)}"/>
                            <Setter TargetName="content" Property="TextBlock.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledForegroundBrush)}"/>
                            <Setter TargetName="content" Property="Opacity" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CustomCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="true"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="UseLayoutRounding" Value="true"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="IsThreeState" Value="False"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
        <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=PrimaryBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=ButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="helpers:ThemeHelper.MouseOverBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=MouseOverBackgroundBrush}"/>
        <Setter Property="helpers:ThemeHelper.DisabledForegroundBrush" Value="{telerik:Windows11Resource ResourceKey=DisabledForegroundBrush}"/>
        <Setter Property="helpers:ThemeHelper.DisabledBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=DisabledBackgroundBrush}"/>
        <Setter Property="helpers:ThemeHelper.DisabledBrush" Value="{telerik:Windows11Resource ResourceKey=DisabledBorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Border" 
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{telerik:Windows11Resource ResourceKey=CornerRadius}">
                        <ContentPresenter x:Name="Content"
                                          Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource NullToVisibilityConverter}}"
                                          RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" TargetName="Border" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBrush)}"/>
                            <Setter Property="Background" TargetName="Border" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBackgroundBrush)}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="BorderBrush" TargetName="Border" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.CheckedBrush)}"/>
                            <Setter Property="Background" TargetName="Border" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.CheckedBackgroundBrush)}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="BorderBrush" TargetName="Border" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBrush)}"/>
                            <Setter Property="Background" TargetName="Border" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBackgroundBrush)}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledBackgroundBrush)}"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledBrush)}"/>
                            <Setter TargetName="Content" Property="TextBlock.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledForegroundBrush)}"/>
                            <Setter TargetName="Content" Property="Opacity" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--#region 작성폼 -->
    <sys:Double x:Key="FormControlBigWidth">480</sys:Double>
    <sys:Double x:Key="FormControlWidth">240</sys:Double>
    <sys:Double x:Key="FormControlLargeWidth">650</sys:Double>
    <sys:Double x:Key="FormControlMiddleWidth">149.5</sys:Double>
    <sys:Double x:Key="FormControlSmallWidth">120</sys:Double>

    <sys:Double x:Key="FormControlHeight">40</sys:Double>
    <sys:Double x:Key="FormControlLargeHeight">60</sys:Double>

    <!--Wartermark Close Button-->
    <DataTemplate x:Key="ClearWatermarkTextBoxAdditionalContentTemplate">
        <telerik:RadButton Focusable="False"  
                       IsBackgroundVisible="False"  
                       Padding="8 0"
                       Cursor="Hand"
                       helpers:ThemeHelper.FocusVisualMargin="0"
                       helpers:ThemeHelper.CornerRadius="0"
                       Command="telerik:RadWatermarkTextBoxCommands.Clear"  
                       CommandTarget="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadWatermarkTextBox}}">
            <telerik:RadGlyph Glyph="&#xe11b;" FontSize="12"/>
            <telerik:RadButton.Style>
                <Style TargetType="telerik:RadButton" BasedOn="{StaticResource RadButtonStyle}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadWatermarkTextBox}}" Value="True"/>
                                <Condition Binding="{Binding Path=Text, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadWatermarkTextBox}, Converter={StaticResource StringToBoolConverter}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsFocused, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadWatermarkTextBox}}" Value="True"/>
                                <Condition Binding="{Binding Path=Text, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadWatermarkTextBox}, Converter={StaticResource StringToBoolConverter}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </telerik:RadButton.Style>
        </telerik:RadButton>
    </DataTemplate>

    <!--작성폼 레이아웃-->
    <Style x:Key="EditorLayoutStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OpacityBackgroundBrush}"/>
        <Setter Property="Margin" Value="0 0 0 0"/>
    </Style>

    <Style x:Key="FormLayoutBorderStyle" TargetType="Border">
        <Setter Property="Background"  Value="{telerik:Windows11Resource ResourceKey=OverlayBrush}"/>
        <Setter Property="BorderBrush"  Value="{telerik:Windows11Resource ResourceKey=TertiaryForegroundBrush}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Margin" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FormTopBorderStyle" TargetType="Border">
        <Setter Property="Background"  Value="{telerik:Windows11Resource ResourceKey=AlternativeBrush}"/>
        <Setter Property="BorderBrush"  Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0 0 0 1"/>
        <Setter Property="CornerRadius" Value="8 8 0 0"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="Padding" Value="10 0 0 0"/>
    </Style>

    <Style x:Key="FormBottomBorderStyle" TargetType="Border">
        <Setter Property="Background"  Value="{telerik:Windows11Resource ResourceKey=AlternativeBrush}"/>
        <Setter Property="BorderBrush"  Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0 1 0 0"/>
        <Setter Property="CornerRadius" Value="0 0 8 8"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="Padding" Value="20 0"/>
    </Style>

    <Style x:Key="FormStackPanelStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <!--작성항목 좌 그룹-->
    <Style x:Key="FormGroupStackPanelStyle" TargetType="StackPanel">
        <Setter Property="Width" Value="60"/>
        <Setter Property="Margin" Value="20 0 0 0"/>
    </Style>
    
    <!--작성항목 좌 그룹 설명 제목-->
    <Style x:Key="FormGroupBorderStyle" TargetType="Border">
        <Setter Property="Background"  Value="{telerik:Windows11Resource ResourceKey=AlternativeBrush}"/>
        <Setter Property="BorderBrush"  Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1 1 0 1"/>
        <Setter Property="CornerRadius" Value="8 0 0 8"/>
        <Setter Property="Padding" Value="5 2"/>
    </Style>

    <!--작성항목 좌 그룹 설명 내용-->
    <Style x:Key="FormGroupTextBlockStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource High1FontFamily}"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>

    <Style x:Key="FormLabelBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="160"/>
        <Setter Property="Height" Value="{StaticResource DefaultHeight}"/>
        <Setter Property="Background"  Value="{telerik:Windows11Resource ResourceKey=AlternativeBrush}"/>
        <Setter Property="BorderBrush"  Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{telerik:Windows11Resource ResourceKey=CornerRadius}"/>
        <Setter Property="Margin" Value="5 2 3 2"/>
        <Setter Property="Padding" Value="5 0"/>
    </Style>

    <Style x:Key="FormLabelStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin"  Value="5 0 0 0"/>
        <Setter Property="TextWrapping"  Value="Wrap"/>
        <Setter Property="FontSize"  Value="15"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
    </Style>

    <Style x:Key="FormLabelRequiredStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment"  Value="Center"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=ValidationBrush}"/>
        <Setter Property="Margin" Value="2 0 0 0"/>
        <Setter Property="FontFamily" Value="{StaticResource DefaultFontFamily}"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="FontSize" Value="20"/>
    </Style>

    <Style x:Key="FormReadOnlyTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxStyle}">
        <Setter Property="Width" Value="{StaticResource FormControlWidth}"/>
        <Setter Property="Height" Value="{StaticResource FormControlHeight}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
    </Style>

    <Style x:Key="FormRadDatePickerStyle" TargetType="telerik:RadDatePicker" BasedOn="{StaticResource RadDateTimePickerStyle}">
        <Setter Property="Width" Value="{StaticResource FormControlWidth}"/>
        <Setter Property="Height" Value="{StaticResource FormControlHeight}"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
        <Setter Property="AllowParsingWithoutSeparator" Value="True"/>
    </Style>

    <Style x:Key="FormRadDateTimePickerStyle" TargetType="telerik:RadDateTimePicker" BasedOn="{StaticResource RadDateTimePickerStyle}">
        <Setter Property="Width" Value="{StaticResource FormControlWidth}"/>
        <Setter Property="Height" Value="{StaticResource FormControlHeight}"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
        <Setter Property="AllowParsingWithoutSeparator" Value="True"/>
    </Style>

    <Style x:Key="FormIntNumericUpDownStyle" TargetType="telerik:RadNumericUpDown" BasedOn="{StaticResource RadNumericUpDownStyle}">
        <Setter Property="NullValue" Value="{x:Null}"/>
        <Setter Property="IsInteger" Value="True"/>
        <Setter Property="Width" Value="{StaticResource FormControlWidth}"/>
        <Setter Property="Height" Value="{StaticResource FormControlHeight}"/>
        <Setter Property="SmallChange" Value="1"/>

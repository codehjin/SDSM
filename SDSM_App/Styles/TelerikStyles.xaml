<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"   
                    xmlns:helpers="clr-namespace:Telerik.Windows.Controls.Theming.Helpers;assembly=Telerik.Windows.Controls"                   
                    xmlns:dataPager="clr-namespace:Telerik.Windows.Controls.Data.DataPager;assembly=Telerik.Windows.Controls.Data"
                    xmlns:controls="clr-namespace:Telerik.Windows.Controls;assembly=Telerik.Windows.Controls.Data"
                    xmlns:mat="clr-namespace:Telerik.Windows.Controls.MaterialControls;assembly=Telerik.Windows.Controls"
                    xmlns:controlsInput="clr-namespace:Telerik.Windows.Controls;assembly=Telerik.Windows.Controls.Input"
                    xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:main="clr-namespace:SDSM_App"
                    xmlns:converter="clr-namespace:SDSM_App.Converters">

    <converter:IndexToNumberConverter x:Key="IndexToNumberConverter"/>
    
    <Style TargetType="telerik:RadButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="{StaticResource DefaultHeight}"/>
        <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
        <Setter Property="helpers:ThemeHelper.MouseOverBrush" Value="{telerik:Windows11Resource ResourceKey=FocusBrush}"/>
    </Style>

    <!--검색텍스트-->
    <Style x:Key="SearhcBoxStyle" TargetType="telerik:RadAutoSuggestBox">
        <Setter Property="Width" Value="240"/>
        <Setter Property="MinWidth" Value="240"/>
        <Setter Property="MinHeight" Value="{StaticResource DefaultHeight}"/>
        <Setter Property="IsDropDownOpen" Value="False"/>
        <Setter Property="WatermarkContent" Value="검색"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
        <Setter Property="InputMethod.PreferredImeState" Value="On"/>
        <Setter Property="InputMethod.PreferredImeConversionMode" Value="Native"/>
    </Style>

    <!--새로고침-->
    <Style x:Key="ReloadButtonStyle" TargetType="telerik:RadButton">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Margin" Value="5 0 0 0"/>
        <Setter Property="Height" Value="{StaticResource DefaultHeight}"/>
        <Setter Property="helpers:ThemeHelper.MouseOverBrush" Value="{telerik:Windows11Resource ResourceKey=FocusBrush}" />
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Content">
            <Setter.Value>
                <StackPanel Orientation="Horizontal">
                    <telerik:RadGlyph Glyph="{StaticResource GlyphReload}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{telerik:Windows11Resource ResourceKey=IconBrush}"/>
                    <TextBlock Text="새로고침" Margin="5 0 0 0"/>
                </StackPanel>
            </Setter.Value>
        </Setter>
    </Style>

    <!--상단 닫기-->
    <Style x:Key="TitleBarCloseButtonStyle" TargetType="telerik:RadButton">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="CornerRadius" Value="0 8 0 0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="helpers:ThemeHelper.MouseOverBackgroundBrush" Value="#FFCFCFCF" />
    </Style>
    
    <!--초기화-->
    <Style x:Key="ResetButtonStyle" TargetType="telerik:RadButton">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Content" Value="초기화"/>
        <Setter Property="Margin" Value="5 0 0 0"/>
        <Setter Property="helpers:ThemeHelper.MouseOverBrush" Value="{telerik:Windows11Resource ResourceKey=FocusBrush}" />
    </Style>

    <Style x:Key="ExportButtonBaseStyle" TargetType="telerik:RadButton">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Height" Value="{StaticResource DefaultHeight}"/>
        <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=PrimaryBackgroundBrush}"/>
        <Setter Property="helpers:ThemeHelper.MouseOverBrush" Value="{telerik:Windows11Resource ResourceKey=FocusBrush}" />
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!--페이지 출력-->
    <Style x:Key="ExportButtonStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource ExportButtonBaseStyle}">
        <Setter Property="Content">
            <Setter.Value>
                <StackPanel Orientation="Horizontal">
                    <icon:PackIconModern Kind="OfficeExcel" VerticalAlignment="Center" Width="14" Height="14"/>
                    <TextBlock Text="페이지 출력" Margin="5 0 0 0"/>
                </StackPanel>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=Items.Count, Mode=OneWay, ElementName=DataRadGridView}" Value="0">
                <Setter Property="IsEnabled" Value="False"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="TooltipRadCalloutStyle" TargetType="telerik:RadCallout">
        <Setter Property="CalloutType"  Value="RoundedRectangle"/>
        <Setter Property="ArrowType"  Value="None"/>
        <Setter Property="MinWidth"  Value="40"/>
        <Setter Property="MinHeight"  Value="32"/>
        <Setter Property="Margin"  Value="10"/>
        <Setter Property="Padding"  Value="10"/>
        <Setter Property="FontSize"  Value="14"/>
        <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
        <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}"/>
    </Style>

    <Style x:Key="WriterButtonStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource RadButtonStyle}">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="10 0 0 0"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="MinHeight" Value="{StaticResource DefaultHeight}"/>
        <Setter Property="Visibility" Value="Visible"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=DisabledForegroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--추가-->
    <Style x:Key="AddButtonStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource WriterButtonStyle}">
        <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=AccentBrush}"/>
        <Setter Property="helpers:ThemeHelper.MouseOverBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=AccentMouseOverBrush}"/>
        <Setter Property="helpers:ThemeHelper.PressedBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=AccentPressedBrush}"/>
        <Setter Property="helpers:ThemeHelper.FocusBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="Margin" Value="0 0 0 0"/>
    </Style>
    
    <!--수정-->
    <Style x:Key="EditButtonStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource WriterButtonStyle}">
        <Setter Property="helpers:ThemeHelper.MouseOverBrush" Value="{StaticResource GreenBrush}"/>
    </Style>

    <!--삭제-->
    <Style x:Key="DeleteButtonStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource WriterButtonStyle}">
        <Setter Property="helpers:ThemeHelper.MouseOverBrush" Value="{telerik:Windows11Resource ResourceKey=ValidationBrush}"/>
    </Style>
    
    <!--엑센트버튼-->
    <Style x:Key="AccentButtonStyle" TargetType="telerik:RadButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="{StaticResource DefaultHeight}"/>
        <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=AccentBrush}"/>
        <Setter Property="helpers:ThemeHelper.MouseOverBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=AccentMouseOverBrush}"/>
        <Setter Property="helpers:ThemeHelper.PressedBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=AccentPressedBrush}"/>
        <Setter Property="helpers:ThemeHelper.FocusBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=DisabledForegroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--검정 버튼-->
    <Style x:Key="DarkButtonStyle" TargetType="telerik:RadButton" >
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="{StaticResource DefaultHeight}"/>
        <Setter Property="Background" Value="#000000"/>
        <Setter Property="BorderBrush" Value="#000000"/>
        <Setter Property="helpers:ThemeHelper.MouseOverBackgroundBrush" Value="#333333"/>
        <Setter Property="helpers:ThemeHelper.MouseOverBrush" Value="#333333"/>
        <Setter Property="helpers:ThemeHelper.PressedBackgroundBrush" Value="#222222"/>
        <Setter Property="helpers:ThemeHelper.PressedBrush" Value="#222222"/>
        <Setter Property="helpers:ThemeHelper.FocusBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=AccentControlForegroundBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=DisabledForegroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--녹색 버튼-->
    <Style x:Key="GreenButtonStyle" TargetType="telerik:RadButton" >
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="{StaticResource DefaultHeight}"/>
        <Setter Property="Background" Value="#558B2F"/>
        <Setter Property="BorderBrush" Value="#558B2F"/>
        <Setter Property="helpers:ThemeHelper.MouseOverBackgroundBrush" Value="#689F38"/>
        <Setter Property="helpers:ThemeHelper.MouseOverBrush" Value="#689F38"/>
        <Setter Property="helpers:ThemeHelper.PressedBackgroundBrush" Value="#7CB342"/>
        <Setter Property="helpers:ThemeHelper.PressedBrush" Value="#7CB342"/>
        <Setter Property="helpers:ThemeHelper.FocusBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=AccentControlForegroundBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=DisabledForegroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OverlayStyle" TargetType="Rectangle">
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="Fill" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
    </Style>

    <!--BusyIndicator-->
    <Style x:Key="CustomRadBusyIndicatorStyle" TargetType="telerik:RadBusyIndicator" BasedOn="{StaticResource RadBusyIndicatorStyle}">
        <Setter Property="DisplayAfter" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="IsBusy" Value="True"/>
        <Setter Property="IsIndeterminate" Value="True"/>
        <Setter Property="FontFamily" Value="{StaticResource High1FontFamily}"/>
        <Setter Property="OverlayStyle" Value="{StaticResource OverlayStyle}"/>
        <Setter Property="BusyContent" Value="{Binding Path=(main:GB.BusyContent)}"/>
    </Style>

    <!--RadGridView 진행표시-->
    <DataTemplate x:Key="ExportBusyGridViewTemplate">
        <Border CornerRadius="{telerik:Windows11Resource ResourceKey=CornerRadius}" Padding="40 60 40 20" Margin="0 -60 0 0" Background="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}">
            <Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}" VerticalAlignment="Center" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="파일 작성중..." FontFamily="{StaticResource High1FontFamily}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding BusyIndicatorProgressValue}" FontFamily="{StaticResource High1FontFamily}"/>
                    <TextBlock Text="%" FontFamily="{StaticResource High1FontFamily}"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>
    
    <!--Page Size-->
    <Style x:Key="PageSizeRadNumericUpDownStyle" TargetType="telerik:RadNumericUpDown">
        <Setter Property="Minimum" Value="{Binding Path=(main:GB.MinPageSize)}"/>
        <Setter Property="Maximum" Value="{Binding Path=(main:GB.MaxPageSize)}"/>
        <Setter Property="SmallChange" Value="10"/>
        <Setter Property="LargeChange" Value="1000"/>
        <Setter Property="ShowButtons" Value="False"/>
        <Setter Property="IsInteger" Value="True"/>
        <Setter Property="Width" Value="90"/>
        <Setter Property="Height" Value="{StaticResource DefaultHeight}"/>
        <Setter Property="Margin" Value="5 0 10 0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="PageButtonStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource RadButtonStyle}">
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=IconBrush}"/>
        <Setter Property="IsBackgroundVisible" Value="False"/>
        <Setter Property="MinWidth" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=DisabledForegroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <!--DataPagerPresenter Template-->
    <ControlTemplate x:Key="CustomDataPagerPresenterTemplate" TargetType="dataPager:DataPagerPresenter">
        <Border x:Name="BorderVisual" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <Grid VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Background="Transparent"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    HorizontalAlignment="Center">

                    <!-- FirstPage Button -->
                    <!--추가 Cursor-->
                    <telerik:RadButton
                    Name="MoveToFirstPageButton"
                    Cursor="Hand"
                    Style="{StaticResource PageButtonStyle}"
                    Command="{x:Static controls:RadDataPagerCommands.MoveToFirstPage}"
                    Visibility="{Binding PagerControlsVisibility.MoveToFirstPageControlVisibility, RelativeSource={RelativeSource TemplatedParent}}">
                        <telerik:RadGlyph Glyph="{StaticResource GlyphArrowBackward}"/>
                    </telerik:RadButton>

                    <!-- PreviousPage Button -->
                    <telerik:RadButton 
                    Name="MoveToPreviousPageButton"
                    Cursor="Hand"
                    Style="{StaticResource PageButtonStyle}"
                    Command="{x:Static controls:RadDataPagerCommands.MoveToPreviousPage}"
                    Visibility="{Binding PagerControlsVisibility.MoveToPreviousPageControlVisibility, RelativeSource={RelativeSource TemplatedParent}}">
                        <telerik:RadGlyph Glyph="{StaticResource GlyphArrow60Left}"/>
                    </telerik:RadButton>

                    <!-- NumericPresenter -->
                    <Border VerticalAlignment="Center" Visibility="{Binding PagerControlsVisibility.NumericElementsControlVisibility,RelativeSource={RelativeSource TemplatedParent}}">
                        <dataPager:NumericElementsPresenter
                            NumericButtonStyle="{TemplateBinding NumericButtonStyle}"
                            AutoEllipsisMode="{TemplateBinding AutoEllipsisMode}"
                            PageIndex="{TemplateBinding PageIndex}"
                            PageCount="{TemplateBinding PageCount}"
                            NumericButtonCount="{TemplateBinding NumericButtonCount}"/>
                    </Border>

                    <!-- NextPage Button -->
                    <telerik:RadButton
                        Name="MoveToNextPageButton"
                    Cursor="Hand"
                        Style="{StaticResource PageButtonStyle}"
                        Command="{x:Static controls:RadDataPagerCommands.MoveToNextPage}"
                        Visibility="{Binding PagerControlsVisibility.MoveToNextPageControlVisibility, RelativeSource={RelativeSource TemplatedParent}}">
                        <telerik:RadGlyph Glyph="{StaticResource GlyphArrow60Right}"/>
                    </telerik:RadButton>

                    <!-- LastPage Button -->
                    <telerik:RadButton
                        Name="MoveToLastPageButton"
                    Cursor="Hand"
                        Style="{StaticResource PageButtonStyle}"
                        Command="{x:Static controls:RadDataPagerCommands.MoveToLastPage}"
                        Visibility="{Binding PagerControlsVisibility.MoveToLastPageControlVisibility, RelativeSource={RelativeSource TemplatedParent}}">
                        <telerik:RadGlyph Glyph="{StaticResource GlyphArrowForward}"/>
                    </telerik:RadButton>
                </StackPanel>
                <Grid
                Background="Transparent"
                Grid.Column="2"
                Visibility="{Binding PagerControlsVisibility.TextControlVisibility,RelativeSource={RelativeSource TemplatedParent}}"
                Margin="{telerik:Windows11Resource ResourceKey=DataPagerTextControlMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="PageTextBlock"
                        Grid.Column="0" Visibility="Collapsed"
                        telerik:LocalizationManager.ResourceKey="RadDataPagerPage"
                        TextAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{TemplateBinding FontSize}"/>
                    <dataPager:DataPagerTextBox x:Name="DataPagerTextBox"
                        Grid.Column="1" 
                        AutomationProperties.Name="DataPagerTextBox"
                        Style="{TemplateBinding TextBoxStyle}"
                        Command="{x:Static controls:RadDataPagerCommands.MoveToPage}"
                        PageIndex="{TemplateBinding PageIndex}"
                        FontSize="{TemplateBinding FontSize}"/>
                    <TextBlock x:Name="OfTextBlock"
                        Grid.Column="2"
                        telerik:LocalizationManager.ResourceKey="RadDataPagerOf"
                        TextAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0 0 4 0"
                        FontSize="{TemplateBinding FontSize}"/>
                    <TextBlock x:Name="PageCountTextBlock"
                        Grid.Column="3"
                        Text="{Binding PageCount, RelativeSource={RelativeSource TemplatedParent}, StringFormat=N0}"
                        TextAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{TemplateBinding FontSize}"/>
                </Grid>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PageTextBlock" Property="Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledForegroundBrush)}"/>
                <Setter TargetName="PageTextBlock" Property="Opacity" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}"/>
                <Setter TargetName="OfTextBlock" Property="Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledForegroundBrush)}"/>
                <Setter TargetName="OfTextBlock" Property="Opacity" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}"/>
                <Setter TargetName="PageCountTextBlock" Property="Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledForegroundBrush)}"/>
                <Setter TargetName="PageCountTextBlock" Property="Opacity" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}"/>
                <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledBrush)}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="dataPager:DataPagerPresenter">
        <Setter Property="Template" Value="{StaticResource CustomDataPagerPresenterTemplate}"/>
    </Style>

    <!--DataPager 번호스타일-->
    <Style x:Key="DataPagerNumericButtonStyle" TargetType="telerik:RadRadioButton">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="2 0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
    </Style>

    <!--DataPager-->
    <Style TargetType="telerik:RadDataPager">
        <Setter Property="DisplayMode" Value="All"/>
        <Setter Property="AutoEllipsisMode" Value="Both"/>
        <Setter Property="IsTotalItemCountFixed" Value="True"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="NumericButtonStyle" Value="{StaticResource DataPagerNumericButtonStyle}"/>
        <Setter Property="NumericButtonCount" Value="5"/>
        <Setter Property="AutoEllipsisMode" Value="None"/>
        <Setter Property="PageSize" Value="{Binding Source={x:Static main:GB.CurrentPageSize}}"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
    </Style>

    <!--CommonHeader-->
    <Style TargetType="telerik:CommonHeaderPresenter" BasedOn="{StaticResource CommonHeaderPresenterStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
        <Setter Property="Padding" Value="5 0"/>
    </Style>

    <!--CommonHeader-->
    <Style TargetType="telerik:CommonColumnHeader" BasedOn="{StaticResource CommonColumnHeaderStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
        <Setter Property="Padding" Value="5 0"/>
    </Style>

    <!--GridView Header CheckBox-->
    <Style x:Key="HeaderCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="helpers:ThemeHelper.FocusBackgroundBrush" Value="Transparent"/>
        <Setter Property="helpers:ThemeHelper.FocusBrush" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!--GridView 컨텍스트메뉴-->
    <Style x:Key="GridViewMenuItemContainerStyle" TargetType="telerik:RadMenuItem">
        <Setter Property="Height" Value="44"/>
        <Setter Property="IconColumnWidth" Value="50"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!--GridView Footer Cell-->
    <Style TargetType="telerik:GridViewFooterCell">
        <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0 0 1 0"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style TargetType="telerik:AggregateResultsList">
        <Setter Property="ItemsSource" Value="{Binding}"/>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Caption}"/>
                        <TextBlock Grid.Column="1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding FormattedValue}"/>
                                    <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FormattedValue}" Value="{x:Null}">
                                            <Setter Property="Text" Value="-"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FormattedValue}" Value="">
                                            <Setter Property="Text" Value="-"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--GridView 머리글 셀-->
    <Style TargetType="telerik:GridViewHeaderCell" BasedOn="{StaticResource GridViewHeaderCellStyle}">
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!--GridView 머리글 셀-->
    <Style x:Key="NotSortingGridViewHeaderCellStyle" TargetType="telerik:GridViewHeaderCell" BasedOn="{StaticResource GridViewHeaderCellStyle}">
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!--GridView 머리글-->
    <Style x:Key="CustomRadGridViewHeaderRowStyle" TargetType="telerik:GridViewHeaderRow" BasedOn="{StaticResource GridViewHeaderRowStyle}">
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=PrimarySolidBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0 0 0 1"/>
        <Setter Property="MinHeight" Value="46"/>
        <Setter Property="Template" Value="{StaticResource GridViewHeaderRowTemplate}"/>
    </Style>

    <!--GridView 행-->
    <Style TargetType="telerik:GridViewRow" BasedOn="{StaticResource GridViewRowStyle}">
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="AllowDrop" Value="True"/>
    </Style>

    <Style x:Key="ActionBackgroundNullRowStyle" TargetType="telerik:GridViewRow" BasedOn="{StaticResource GridViewRowStyle}">
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="AllowDrop" Value="True"/>
        <Setter Property="SelectedBackground" Value="{x:Null}"/>
        <Setter Property="MouseOverBackground" Value="{x:Null}"/>
    </Style>

    <Style x:Key="OriginalMinHeightGridViewRowStyle" TargetType="telerik:GridViewRow" BasedOn="{StaticResource GridViewRowStyle}">
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="AllowDrop" Value="True"/>
    </Style>

    <!--Default Center GridView 행 셀-->
    <Style TargetType="telerik:GridViewCell" BasedOn="{StaticResource GridViewCellStyle}">
        <Setter Property="Padding" Value="7 0"/>

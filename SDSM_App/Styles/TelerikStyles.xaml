    <!--전체메뉴 드랍다운버튼 템플릿-->
    <ControlTemplate x:Key="AllMenuRadDropDownButtonTemplate" TargetType="telerik:RadDropDownButton">
        <Grid>
            <Border x:Name="FocusVisual" Style="{StaticResource FocusVisualBorderStyle}" CornerRadius="{TemplateBinding CornerRadius}"/>
            <Grid Margin="{TemplateBinding helpers:ThemeHelper.FocusVisualMargin}">
                <Grid SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" MinHeight="{TemplateBinding MinHeight}" MinWidth="{TemplateBinding MinWidth}">
                    <Border x:Name="BorderVisual"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="Content"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                        <Grid x:Name="DropDownIndicator"
                              Grid.Column="1"
                              Grid.Row="2"
                              Margin="{telerik:Windows11Resource ResourceKey=DropDownIndicatorMargin}"
                              Canvas.ZIndex="2"
                              IsHitTestVisible="False"
                              Visibility="{TemplateBinding DropDownIndicatorVisibility}">
                            <telerik:RadGlyph x:Name="arrow"
                                              FontSize="{telerik:Windows11Resource ResourceKey=GlyphFontSizeS}"
                                              Foreground="{telerik:Windows11Resource ResourceKey=IconSecondaryBrush}"
                                              Glyph="{StaticResource GlyphArrowChevronDown}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
            <Popup x:Name="DropDownPopup"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   Focusable="False"
                   Placement="Bottom"
                   PopupAnimation="{TemplateBinding PopupAnimation}"
                   HorizontalOffset="-800"
                   VerticalOffset="{telerik:Windows11Resource ResourceKey=PopupOffset}">
                <Grid Margin="{telerik:Windows11Resource ResourceKey=PopupMargin}">
                    <mat:Shadow Background="{telerik:Windows11Resource ResourceKey=TertiaryBackgroundBrush}" ShadowDepth="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mat:MaterialAssist.ShadowDepth)}" CornerRadius="{telerik:Windows11Resource ResourceKey=OverlayCornerRadius}"/>
                    <Border x:Name="DropDownPopupBorder"
                            MinWidth="{TemplateBinding DropDownMinWidth}"
                            MinHeight="{TemplateBinding DropDownMinHeight}"
                            Width="{TemplateBinding DropDownWidth}"
                            Height="{TemplateBinding DropDownHeight}"
                            MaxWidth="{TemplateBinding DropDownMaxWidth}"
                            MaxHeight="{TemplateBinding DropDownMaxHeight}"
                            CornerRadius="{telerik:Windows11Resource ResourceKey=OverlayCornerRadius}"
                            Background="{telerik:Windows11Resource ResourceKey=TertiaryBackgroundBrush}"
                            BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"
                            BorderThickness="1">
                        <ContentControl x:Name="DropDownPopupContent"
                                        Content="{TemplateBinding DropDownContent}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        ContentTemplate="{TemplateBinding DropDownContentTemplate}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        telerik:CornerRadiusHelper.ClipRadius="{telerik:Windows11Resource ResourceKey=OverlayCornerRadius}"
                                        DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DataContext}"
                                        ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                        ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                    </Border>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>

            <!-- background is hidden -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True"/>
                    <Condition Property="IsBackgroundVisible" Value="False"/>
                    <Condition Property="IsMouseOver" Value="False"/>
                    <Condition Property="IsOpen" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
            </MultiTrigger>

            <!-- General IsKeyboardFocused setters -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True"/>
                    <Condition Property="IsKeyboardFocused" Value="True"/>
                    <Condition Property="IsPressed" Value="False"/>
                    <Condition Property="IsMouseOver" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="FocusVisual" Property="Opacity" Value="1"/>
            </MultiTrigger>

            <!-- General setters for IsMouseOver -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBackgroundBrush)}"/>
                <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBrush)}"/>
            </Trigger>

            <!-- General setters for IsPressed -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsOpen" Value="False"/>
                    <Condition Property="IsPressed" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                <Setter TargetName="arrow" Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=TertiaryForegroundBrush}"/>
                <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.PressedBackgroundBrush)}"/>
                <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.PressedBrush)}"/>
            </MultiTrigger>

            <!-- General setters for IsOpen -->
            <Trigger Property="IsOpen" Value="True">
                <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
                <Setter TargetName="arrow" Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.CheckedBackgroundBrush)}"/>
                <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.CheckedBrush)}"/>
            </Trigger>

            <!-- disabled -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Content" Property="Opacity" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}"/>
                <Setter TargetName="DropDownIndicator" Property="Opacity" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}"/>
                <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledBackgroundBrush)}"/>
                <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledBrush)}"/>
                <Setter TargetName="Content" Property="TextBlock.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledForegroundBrush)}"/>
                <Setter TargetName="arrow" Property="Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledForegroundBrush)}"/>
            </Trigger>

            <!-- disabled and focused -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="False"/>
                    <Condition Property="IsKeyboardFocused" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="FocusVisual" Property="Opacity" Value="0"/>
            </MultiTrigger>

            <!-- disabled & background is hidden -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="False"/>
                    <Condition Property="IsBackgroundVisible" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="BorderVisual" Property="helpers:ThemeHelper.DisabledBackgroundBrush" Value="Transparent"/>
                <Setter TargetName="BorderVisual" Property="helpers:ThemeHelper.DisabledBrush" Value="Transparent"/>
            </MultiTrigger>

            <!-- DropDownButtonPosition and DropDownPacement -->
            <Trigger Property="DropDownButtonPosition" Value="Bottom"/>
            <Trigger Property="DropDownButtonPosition" Value="Left">
                <Setter TargetName="DropDownIndicator" Property="Grid.Column" Value="0"/>
                <Setter TargetName="DropDownIndicator" Property="Grid.Row" Value="1"/>
            </Trigger>
            <Trigger Property="DropDownButtonPosition" Value="Top">
                <Setter TargetName="DropDownIndicator" Property="Grid.Column" Value="1"/>
                <Setter TargetName="DropDownIndicator" Property="Grid.Row" Value="0"/>
            </Trigger>
            <Trigger Property="DropDownButtonPosition" Value="Right">
                <Setter TargetName="DropDownIndicator" Property="Grid.Column" Value="2"/>
                <Setter TargetName="DropDownIndicator" Property="Grid.Row" Value="1"/>
            </Trigger>
            <Trigger Property="DropDownPlacement" Value="Bottom"/>
            <Trigger Property="DropDownPlacement" Value="Top">
                <Setter TargetName="DropDownPopup" Property="HorizontalOffset" Value="0"/>
                <Setter TargetName="DropDownPopup" Property="VerticalOffset" Value="{Binding Source={x:Static telerik:Windows11Palette.Palette}, Path=PopupOffset, Converter={StaticResource MultiplyValueConverter}, ConverterParameter=-1}"/>
                <Setter TargetName="arrow" Property="Glyph" Value="{StaticResource GlyphArrowChevronUp}"/>
            </Trigger>
            <Trigger Property="DropDownPlacement" Value="Left">
                <Setter TargetName="DropDownPopup" Property="HorizontalOffset" Value="{Binding Source={x:Static telerik:Windows11Palette.Palette}, Path=PopupOffset, Converter={StaticResource MultiplyValueConverter}, ConverterParameter=-1}"/>
                <Setter TargetName="DropDownPopup" Property="VerticalOffset" Value="0"/>
                <Setter TargetName="arrow" Property="Glyph" Value="{StaticResource GlyphArrowChevronLeft}"/>
            </Trigger>
            <Trigger Property="DropDownPlacement" Value="Right">
                <Setter TargetName="DropDownPopup" Property="HorizontalOffset" Value="{telerik:Windows11Resource ResourceKey=PopupOffset}"/>
                <Setter TargetName="DropDownPopup" Property="VerticalOffset" Value="0"/>
                <Setter TargetName="arrow" Property="Glyph" Value="{StaticResource GlyphArrowChevronRight}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--서브메뉴-->
    <Style x:Key="SubMenuRadRadioButtonStyle" TargetType="telerik:RadRadioButton" BasedOn="{StaticResource RadRadioButtonStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0 0 10 0"/>
        <Setter Property="Padding" Value="10 8"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="GroupName" Value="subMenu"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="telerik:RadRadioButton">
                    <Border x:Name="Border" 
                            Cursor="Hand"
                            Background="{telerik:Windows11Resource ResourceKey=PrimaryBackgroundBrush}" 
                            BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}"
                            MinWidth="{TemplateBinding MinWidth}"
                            MinHeight="{TemplateBinding MinHeight}"
                            Height="{TemplateBinding Height}"
                            Margin="{TemplateBinding Margin}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{telerik:Windows11Resource ResourceKey=CornerRadius}">
                        <ContentPresenter x:Name="Content" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>

                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" TargetName="Border" Value="{telerik:Windows11Resource ResourceKey=MouseOverBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="Border" Value="{telerik:Windows11Resource ResourceKey=FocusBrush}"/>
                            <Setter Property="BorderThickness" TargetName="Border" Value="1"/>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                            <Setter Property="Background" TargetName="Border" Value="{telerik:Windows11Resource ResourceKey=PressedBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="Border" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" TargetName="Border" Value="{telerik:Windows11Resource ResourceKey=AccentBrush}"/>
                            <Setter Property="BorderBrush" TargetName="Border" Value="{telerik:Windows11Resource ResourceKey=AccentBrush}"/>
                            <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=AccentControlForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="{telerik:Windows11Resource ResourceKey=DisabledBackgroundBrush}"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=DisabledBorderBrush}"/>
                            <Setter TargetName="Content" Property="TextBlock.Foreground" Value="{telerik:Windows11Resource ResourceKey=DisabledForegroundBrush}"/>
                            <Setter TargetName="Content" Property="Opacity" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--하위메뉴-->
    <ControlTemplate x:Key="SubMenuBorderThicknessRadRadioButtonTemplate" TargetType="telerik:RadRadioButton">
        <Grid SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
            <Grid>
                <Grid SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" MinHeight="{TemplateBinding MinHeight}" MinWidth="{TemplateBinding MinWidth}" >
                    <Border x:Name="BorderVisual"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                            BorderThickness="0"
                            BorderBrush="{telerik:Windows11Resource ResourceKey=AccentBrush}"
                            Background="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"
                            CornerRadius="1 1 0 0"
                            MinHeight="46"
                            Padding="30 0"/>
                    <ContentPresenter x:Name="Content"
                                      Margin="{TemplateBinding Padding}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                      RecognizesAccessKey="True"/>
                </Grid>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>

            <!-- background is hidden -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsBackgroundVisible" Value="False"/>
                    <Condition Property="IsEnabled" Value="True"/>
                    <Condition Property="IsMouseOver" Value="False"/>
                    <Condition Property="IsChecked" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
            </MultiTrigger>

            <!-- General setters for IsMouseOver -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BorderVisual" Property="Background" Value="{telerik:Windows11Resource ResourceKey=SecondaryBorderBrush}"/>
            </Trigger>

            <!-- general setters for IsChecked -->
            <Trigger Property="IsChecked" Value="True">
                <!--<Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=AccentControlForegroundBrush}"/>-->
                <Setter TargetName="BorderVisual" Property="Background" Value="Transparent"/>
                <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=FocusBrush}"/>
                <Setter TargetName="BorderVisual" Property="CornerRadius" Value="5 5 0 0"/>
                <Setter TargetName="BorderVisual" Property="BorderThickness" Value="2 2 2 0"/>
            </Trigger>

            <!-- disabled -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledBackgroundBrush)}"/>
                <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledBrush)}"/>
                <Setter TargetName="Content" Property="TextBlock.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledForegroundBrush)}"/>
                <Setter TargetName="Content" Property="Opacity" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}"/>
            </Trigger>

        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--다중선택-->
    <DataTemplate x:Key="MultiSelectionBoxTemplate">
        <TextBlock>
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="{Binding Path=SelectedItems.Count, StringFormat='선택 : {0}', RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadComboBox}}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=SelectedItems.Count, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadComboBox}}" Value="1">
                            <Setter Property="Text" Value="{Binding Path=SelectedItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadComboBox}}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </DataTemplate>

    <DataTemplate x:Key="MultiCheckBoxItemTemplate">
        <CheckBox Foreground="{Binding RelativeSource={RelativeSource AncestorType=telerik:RadComboBoxItem}, Path=Foreground}"
                  IsChecked="{Binding RelativeSource={RelativeSource AncestorType=telerik:RadComboBoxItem}, Path=IsSelected}"
                  telerik:TouchManager.ShouldSuspendMousePromotion="True">
            <TextBlock Text="{Binding}"/>
        </CheckBox>
    </DataTemplate>

    <ControlTemplate x:Key="MultiNonEditableComboBox" TargetType="controlsInput:RadComboBox">
        <Grid>
            <Border x:Name="FocusVisual" Style="{StaticResource FocusVisualBorderStyle}" CornerRadius="{TemplateBinding helpers:ThemeHelper.CornerRadius}"/>
            <Grid Margin="{TemplateBinding helpers:ThemeHelper.FocusVisualMargin}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                <Grid MinHeight="{TemplateBinding MinHeight}">
                    <Border x:Name="BorderVisual"
                            IsHitTestVisible="False"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding helpers:ThemeHelper.CornerRadius}"/>
                    <telerik:RadToggleButton x:Name="PART_DropDownButton"
                                             SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                             Padding="{TemplateBinding Padding}"
                                             Content="{TemplateBinding SelectionBoxItem}"
                                             ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                             VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                             HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                             Style="{StaticResource NonEditableComboToggleButtonStyle}"
                                             CornerRadius="{TemplateBinding helpers:ThemeHelper.CornerRadius}"
                                             FontFamily="{TemplateBinding FontFamily}"
                                             FontSize="{TemplateBinding FontSize}"
                                             Focusable="{TemplateBinding Focusable}"/>
                    <Popup x:Name="PART_Popup" VerticalOffset="{telerik:Windows11Resource ResourceKey=PopupOffset}">
                        <Grid x:Name="PopupRoot" Margin="{telerik:Windows11Resource ResourceKey=PopupMargin}">
                            <mat:Shadow Background="{telerik:Windows11Resource ResourceKey=TertiaryBackgroundBrush}"
                                        CornerRadius="{telerik:Windows11Resource ResourceKey=OverlayCornerRadius}"
                                        ShadowDepth="{TemplateBinding mat:MaterialAssist.ShadowDepth}"
                                        SnapsToDevicePixels="True"/>
                            <Border x:Name="PART_ResizeBorder"
                                    SnapsToDevicePixels="True"
                                    Background="{telerik:Windows11Resource ResourceKey=TertiaryBackgroundBrush}"
                                    BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"
                                    BorderThickness="1"
                                    MinWidth="{TemplateBinding MinDropDownWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    CornerRadius="{telerik:Windows11Resource ResourceKey=OverlayCornerRadius}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <telerik:RadButton x:Name="PART_ClearButton"
                                                       Grid.Row="0"
                                                       Margin="1"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       FontFamily="{TemplateBinding FontFamily}"
                                                       Visibility="{TemplateBinding ClearSelectionButtonVisibility}"
                                                       Content="{TemplateBinding ClearSelectionButtonContent}"/>
                                    <Grid Grid.Row="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ScrollViewer x:Name="PART_ScrollViewer"
                                                      BorderThickness="0"
                                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                                      Foreground="{TemplateBinding Foreground}"
                                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                                            <ItemsPresenter Margin="2"/>
                                        </ScrollViewer>
                                        <Border x:Name="ControlBorder"
                                                Grid.Row="1"
                                                Padding="5" 
                                                Margin="2"
                                                BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"
                                                BorderThickness="0 1 0 0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Path=AllowMultipleSelection, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=controlsInput:RadComboBox}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <telerik:RadButton Visibility="Visible"
                                                                   Content="전체선택"
                                                                   BorderThickness="1"
                                                                   Margin="0 0 3 0"
                                                                   FontSize="14"
                                                                   Command="{x:Static telerik:RadComboBoxCommands.SelectAll}"
                                                                   CommandTarget="{Binding RelativeSource={RelativeSource Self}}"/>
                                                <telerik:RadButton Grid.Column="1"
                                                                   Visibility="Visible"
                                                                   Content="선택해제"
                                                                   BorderThickness="1"
                                                                   FontSize="14"
                                                                   Margin="3 0 0 0"
                                                                   Command="{x:Static telerik:RadComboBoxCommands.UnselectAll}"
                                                                   CommandTarget="{Binding RelativeSource={RelativeSource Self}}"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Popup>
                </Grid>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>

            <!-- IsKeyboardFocusWithin -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsKeyboardFocusWithin" Value="True"/>
                    <Condition Property="IsDropDownOpen" Value="False"/>
                    <Condition Property="IsMouseOver" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="FocusVisual" Property="Opacity" Value="1"/>
            </MultiTrigger>

            <!-- IsMouseOver -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" TargetName="BorderVisual" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBackgroundBrush), Mode=OneWay}"/>
                <Setter Property="BorderBrush" TargetName="BorderVisual" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBrush), Mode=OneWay}"/>
            </Trigger>

            <!-- IsDropDownOpen -->
            <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.CheckedBackgroundBrush)}"/>
                <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.CheckedBrush)}"/>
            </Trigger>

            <!-- ReadOnly -->
            <Trigger Property="IsReadOnly" Value="True">
                <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.ReadOnlyBackgroundBrush)}"/>
                <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.ReadOnlyBrush)}"/>
                <Setter TargetName="PART_DropDownButton" Property="Opacity" Value="{telerik:Windows11Resource ResourceKey=ReadOnlyOpacity}"/>
            </Trigger>

            <!-- Disabled -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledBackgroundBrush)}"/>
                <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledBrush)}"/>
                <Setter TargetName="PART_DropDownButton" Property="Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledForegroundBrush)}"/>
                <Setter TargetName="PART_DropDownButton" Property="Opacity" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="MultiRadComboBoxItemStyle" TargetType="controlsInput:RadComboBoxItem">
        <Setter Property="helpers:ThemeHelper.FocusBrush" Value="Transparent"/>
        <Setter Property="helpers:ThemeHelper.CornerRadius" Value="{telerik:Windows11Resource ResourceKey=CornerRadius}"/>
        <Setter Property="helpers:ThemeHelper.DisabledForegroundBrush" Value="{telerik:Windows11Resource ResourceKey=DisabledForegroundBrush}"/>
        <Setter Property="Padding" Value="{telerik:Windows11Resource ResourceKey=ItemWithPillPadding}"/>
        <Setter Property="MinHeight" Value="{telerik:Windows11Resource ResourceKey=DefaultItemMinHeight}"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
        <Setter Property="FontFamily" Value="{telerik:Windows11Resource ResourceKey=FontFamily}"/>
        <Setter Property="FontSize" Value="{telerik:Windows11Resource ResourceKey=FontSize}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controlsInput:RadComboBoxItem">
                    <Grid>
                        <Border x:Name="BorderVisual"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                CornerRadius="{TemplateBinding helpers:ThemeHelper.CornerRadius}"/>
                        <Rectangle x:Name="Pill" Margin="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ThicknessToOrientedThicknessConverter}, ConverterParameter=Left}" Style="{StaticResource DefaultItemPillStyle}">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleY="{telerik:Windows11Resource ResourceKey=PillScale}"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <ContentPresenter x:Name="Content"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Content" Property="Opacity" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}"/>
                            <Setter TargetName="Content" Property="TextBlock.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledForegroundBrush), Mode=OneWay}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BorderVisual" Property="Background" Value="{telerik:Windows11Resource ResourceKey=SelectedUnfocusedBrush}"/>
                            <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBrush), Mode=OneWay}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="BorderVisual" Property="Background" Value="Transparent"/>
                            <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.CheckedBrush), Mode=OneWay}"/>
                            <Setter TargetName="Pill" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.CheckedBackgroundBrush), Mode=OneWay}"/>
                            <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.CheckedBrush), Mode=OneWay}"/>
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type controlsInput:RadComboBox}}, Path=AllowMultipleSelection}" Value="True"/>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Mode=Self}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter TargetName="BorderVisual" Property="Background" Value="Transparent"/>
                            </MultiDataTrigger.Setters>
                        </MultiDataTrigger>

                        <!-- Selected and MouseOver -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="BorderVisual" Property="Background" Value="{telerik:Windows11Resource ResourceKey=SelectedUnfocusedBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MultiRadComboBoxStyle" TargetType="telerik:RadComboBox" BasedOn="{StaticResource RadComboBoxStyle}">
        <Setter Property="Template" Value="{StaticResource MultiNonEditableComboBox}"/>
        <Setter Property="NonEditableTemplate" Value="{StaticResource MultiNonEditableComboBox}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="AllowMultipleSelection" Value="True"/>
        <Setter Property="Width" Value="160"/>
        <Setter Property="Height" Value="{StaticResource DefaultHeight}"/>
        <Setter Property="MaxDropDownHeight" Value="1200"/>
        <Setter Property="DropDownButtonIconContent"  Value="&#xe006;"/>
        <Setter Property="ItemContainerStyle"  Value="{StaticResource MultiRadComboBoxItemStyle}"/>
    </Style>

    <Style x:Key="NonFillRadListBoxItemStyle" TargetType="telerik:RadListBoxItem">
        <Setter Property="helpers:ThemeHelper.MouseOverBackgroundBrush" Value="Transparent"/>
        <Setter Property="helpers:ThemeHelper.CheckedBackgroundBrush" Value="Transparent"/>
        <Setter Property="helpers:ThemeHelper.FocusBackgroundBrush" Value="Transparent"/>
        <Setter Property="helpers:ThemeHelper.FocusBrush" Value="Transparent"/>
        <Setter Property="helpers:ThemeHelper.DisabledForegroundBrush" Value="{telerik:Windows11Resource ResourceKey=DisabledForegroundBrush}"/>
        <Setter Property="helpers:ThemeHelper.CornerRadius" Value="{telerik:Windows11Resource ResourceKey=CornerRadius}"/>
        <Setter Property="FontFamily" Value="{telerik:Windows11Resource ResourceKey=FontFamily}"/>
        <Setter Property="FontSize" Value="{telerik:Windows11Resource ResourceKey=FontSize}"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="{telerik:Windows11Resource ResourceKey=ItemWithPillPadding}"/>
        <Setter Property="MinHeight" Value="{telerik:Windows11Resource ResourceKey=DefaultItemMinHeight}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Local"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="telerik:RadListBoxItem">
                    <Grid Background="#01FFFFFF">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BorderVisual"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding helpers:ThemeHelper.CornerRadius}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        <Border x:Name="FocusVisual"
                                Style="{StaticResource FocusVisualBorderStyle}"
                                CornerRadius="{TemplateBinding helpers:ThemeHelper.CornerRadius}"
                                Margin="0"/>
                        <ContentPresenter x:Name="contentPresenter"
                                          Margin="{TemplateBinding Padding}"
                                          Grid.Column="0"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>

                        <!-- MouseOver -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBackgroundBrush), Mode=OneWay}"/>
                            <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBrush), Mode=OneWay}"/>
                        </Trigger>

                        <!-- Focused -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Opacity" Value="1" TargetName="FocusVisual"/>
                            <Setter Property="BorderThickness" Value="3"/>
                        </Trigger>

                        <!-- Focused & MouseOver -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocusWithin" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="FocusVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBackgroundBrush), Mode=OneWay}"/>
                        </MultiTrigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="contentPresenter" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}" Property="Opacity"/>
                            <Setter TargetName="contentPresenter" Property="TextBlock.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledForegroundBrush), Mode=OneWay}"/>
                        </Trigger>

                        <!-- IsSelected general setters -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.CheckedBackgroundBrush), Mode=OneWay}"/>
                            <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.CheckedBrush), Mode=OneWay}"/>
                        </Trigger>

                        <!-- Selected and MouseOver -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBackgroundBrush), Mode=OneWay}"/>
                        </MultiTrigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
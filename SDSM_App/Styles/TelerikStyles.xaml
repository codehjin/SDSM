<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"   
                    xmlns:helpers="clr-namespace:Telerik.Windows.Controls.Theming.Helpers;assembly=Telerik.Windows.Controls"                   
                    xmlns:dataPager="clr-namespace:Telerik.Windows.Controls.Data.DataPager;assembly=Telerik.Windows.Controls.Data"
                    xmlns:controls="clr-namespace:Telerik.Windows.Controls;assembly=Telerik.Windows.Controls.Data"
                    xmlns:mat="clr-namespace:Telerik.Windows.Controls.MaterialControls;assembly=Telerik.Windows.Controls"
                    xmlns:controlsInput="clr-namespace:Telerik.Windows.Controls;assembly=Telerik.Windows.Controls.Input"
                    xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:main="clr-namespace:SDSM_App">

    <Style TargetType="telerik:RadButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="{StaticResource DefaultHeight}"/>
        <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
        <Setter Property="helpers:ThemeHelper.MouseOverBrush" Value="{telerik:Windows11Resource ResourceKey=FocusBrush}"/>
    </Style>
    
    <Style x:Key="TooltipRadCalloutStyle" TargetType="telerik:RadCallout">
        <Setter Property="CalloutType"  Value="RoundedRectangle"/>
        <Setter Property="ArrowType"  Value="None"/>
        <Setter Property="MinWidth"  Value="40"/>
        <Setter Property="MinHeight"  Value="32"/>
        <Setter Property="Margin"  Value="10"/>
        <Setter Property="Padding"  Value="10"/>
        <Setter Property="FontSize"  Value="14"/>
        <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
        <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}"/>
    </Style>

    <!--엑센트버튼-->
    <Style x:Key="AccentButtonStyle" TargetType="telerik:RadButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="{StaticResource DefaultHeight}"/>
        <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=AccentBrush}"/>
        <Setter Property="helpers:ThemeHelper.MouseOverBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=AccentMouseOverBrush}"/>
        <Setter Property="helpers:ThemeHelper.PressedBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=AccentPressedBrush}"/>
        <Setter Property="helpers:ThemeHelper.FocusBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=DisabledForegroundBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OverlayStyle" TargetType="Rectangle">
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="Fill" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
    </Style>

    <!--BusyIndicator-->
    <Style x:Key="CustomRadBusyIndicatorStyle" TargetType="telerik:RadBusyIndicator" BasedOn="{StaticResource RadBusyIndicatorStyle}">
        <Setter Property="DisplayAfter" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="IsBusy" Value="True"/>
        <Setter Property="IsIndeterminate" Value="True"/>
        <Setter Property="FontFamily" Value="{StaticResource High1FontFamily}"/>
        <Setter Property="OverlayStyle" Value="{StaticResource OverlayStyle}"/>
        <Setter Property="BusyContent" Value="{Binding Path=(main:GB.BusyContent)}"/>
    </Style>
    
    <!--RadGridView 진행표시-->
    <DataTemplate x:Key="ExportBusyGridViewTemplate">
        <Border CornerRadius="{telerik:Windows11Resource ResourceKey=CornerRadius}" Padding="60 60 60 20" Margin="0 -60 0 0" Background="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}">
            <StackPanel Orientation="Horizontal" DataContext="{Binding RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}" VerticalAlignment="Center" >
                <TextBlock Text="파일 작성중..." />
                <TextBlock Text="{Binding BusyIndicatorProgressValue}" />
                <TextBlock Text="%"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!--DataPagerPresenter Template-->
    <ControlTemplate x:Key="CustomDataPagerPresenterTemplate" TargetType="dataPager:DataPagerPresenter">
        <Border x:Name="BorderVisual" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <Grid VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Background="Transparent"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    HorizontalAlignment="Center">

                    <!-- FirstPage Button -->
                    <!--추가 Cursor-->
                    <telerik:RadButton
                    Name="MoveToFirstPageButton"
                    Cursor="Hand"
                    Style="{StaticResource PageButtonStyle}"
                    Command="{x:Static controls:RadDataPagerCommands.MoveToFirstPage}"
                    Visibility="{Binding PagerControlsVisibility.MoveToFirstPageControlVisibility, RelativeSource={RelativeSource TemplatedParent}}">
                        <telerik:RadGlyph Glyph="{StaticResource GlyphArrowBackward}"/>
                    </telerik:RadButton>

                    <!-- PreviousPage Button -->
                    <telerik:RadButton 
                    Name="MoveToPreviousPageButton"
                    Cursor="Hand"
                    Style="{StaticResource PageButtonStyle}"
                    Command="{x:Static controls:RadDataPagerCommands.MoveToPreviousPage}"
                    Visibility="{Binding PagerControlsVisibility.MoveToPreviousPageControlVisibility, RelativeSource={RelativeSource TemplatedParent}}">
                        <telerik:RadGlyph Glyph="{StaticResource GlyphArrow60Left}"/>
                    </telerik:RadButton>

                    <!-- NumericPresenter -->
                    <Border VerticalAlignment="Center" Visibility="{Binding PagerControlsVisibility.NumericElementsControlVisibility,RelativeSource={RelativeSource TemplatedParent}}">
                        <dataPager:NumericElementsPresenter
                            NumericButtonStyle="{TemplateBinding NumericButtonStyle}"
                            AutoEllipsisMode="{TemplateBinding AutoEllipsisMode}"
                            PageIndex="{TemplateBinding PageIndex}"
                            PageCount="{TemplateBinding PageCount}"
                            NumericButtonCount="{TemplateBinding NumericButtonCount}"/>
                    </Border>

                    <!-- NextPage Button -->
                    <telerik:RadButton
                        Name="MoveToNextPageButton"
                    Cursor="Hand"
                        Style="{StaticResource PageButtonStyle}"
                        Command="{x:Static controls:RadDataPagerCommands.MoveToNextPage}"
                        Visibility="{Binding PagerControlsVisibility.MoveToNextPageControlVisibility, RelativeSource={RelativeSource TemplatedParent}}">
                        <telerik:RadGlyph Glyph="{StaticResource GlyphArrow60Right}"/>
                    </telerik:RadButton>

                    <!-- LastPage Button -->
                    <telerik:RadButton
                        Name="MoveToLastPageButton"
                    Cursor="Hand"
                        Style="{StaticResource PageButtonStyle}"
                        Command="{x:Static controls:RadDataPagerCommands.MoveToLastPage}"
                        Visibility="{Binding PagerControlsVisibility.MoveToLastPageControlVisibility, RelativeSource={RelativeSource TemplatedParent}}">
                        <telerik:RadGlyph Glyph="{StaticResource GlyphArrowForward}"/>
                    </telerik:RadButton>
                </StackPanel>
                <Grid
                Background="Transparent"
                Grid.Column="2"
                Visibility="{Binding PagerControlsVisibility.TextControlVisibility,RelativeSource={RelativeSource TemplatedParent}}"
                Margin="{telerik:Windows11Resource ResourceKey=DataPagerTextControlMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="PageTextBlock"
                        Grid.Column="0" Visibility="Collapsed"
                        telerik:LocalizationManager.ResourceKey="RadDataPagerPage"
                        TextAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{TemplateBinding FontSize}"/>
                    <dataPager:DataPagerTextBox x:Name="DataPagerTextBox"
                        Grid.Column="1" 
                        AutomationProperties.Name="DataPagerTextBox"
                        Style="{TemplateBinding TextBoxStyle}"
                        Command="{x:Static controls:RadDataPagerCommands.MoveToPage}"
                        PageIndex="{TemplateBinding PageIndex}"
                        FontSize="{TemplateBinding FontSize}"/>
                    <TextBlock x:Name="OfTextBlock"
                        Grid.Column="2"
                        telerik:LocalizationManager.ResourceKey="RadDataPagerOf"
                        TextAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0 0 4 0"
                        FontSize="{TemplateBinding FontSize}"/>
                    <TextBlock x:Name="PageCountTextBlock"
                        Grid.Column="3"
                        Text="{Binding PageCount, RelativeSource={RelativeSource TemplatedParent}, StringFormat=N0}"
                        TextAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{TemplateBinding FontSize}"/>
                </Grid>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PageTextBlock" Property="Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledForegroundBrush)}"/>
                <Setter TargetName="PageTextBlock" Property="Opacity" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}"/>
                <Setter TargetName="OfTextBlock" Property="Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledForegroundBrush)}"/>
                <Setter TargetName="OfTextBlock" Property="Opacity" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}"/>
                <Setter TargetName="PageCountTextBlock" Property="Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledForegroundBrush)}"/>
                <Setter TargetName="PageCountTextBlock" Property="Opacity" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}"/>
                <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledBrush)}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="dataPager:DataPagerPresenter">
        <Setter Property="Template" Value="{StaticResource CustomDataPagerPresenterTemplate}"/>
    </Style>

    <!--DataPager 번호스타일-->
    <Style x:Key="DataPagerNumericButtonStyle" TargetType="telerik:RadRadioButton">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="2 0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
    </Style>

    <!--DataPager-->
    <Style TargetType="telerik:RadDataPager">
        <Setter Property="DisplayMode" Value="All"/>
        <Setter Property="AutoEllipsisMode" Value="Both"/>
        <Setter Property="IsTotalItemCountFixed" Value="True"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="NumericButtonStyle" Value="{StaticResource DataPagerNumericButtonStyle}"/>
        <Setter Property="NumericButtonCount" Value="5"/>
        <Setter Property="AutoEllipsisMode" Value="None"/>
        <Setter Property="PageSize" Value="{Binding Source={x:Static main:GB.CurrentPageSize}}"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
    </Style>

    <!--CommonHeader-->
    <Style TargetType="telerik:CommonHeaderPresenter" BasedOn="{StaticResource CommonHeaderPresenterStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
        <Setter Property="Padding" Value="5 0"/>
    </Style>

    <Style TargetType="telerik:CommonColumnHeader" BasedOn="{StaticResource CommonColumnHeaderStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
        <Setter Property="Padding" Value="5 0"/>
    </Style>

    <!--GridView 컨텍스트메뉴-->
    <Style x:Key="GridViewMenuItemContainerStyle" TargetType="telerik:RadMenuItem">
        <Setter Property="Height" Value="44"/>
        <Setter Property="IconColumnWidth" Value="50"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!--GridView Footer Cell-->
    <Style TargetType="telerik:GridViewFooterCell">
        <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0 0 1 0"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style TargetType="telerik:AggregateResultsList">
        <Setter Property="ItemsSource" Value="{Binding}"/>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Caption}"/>
                        <TextBlock Grid.Column="1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding FormattedValue}"/>
                                    <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FormattedValue}" Value="{x:Null}">
                                            <Setter Property="Text" Value="-"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FormattedValue}" Value="">
                                            <Setter Property="Text" Value="-"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--GridView 머리글 셀-->
    <Style TargetType="telerik:GridViewHeaderCell" BasedOn="{StaticResource GridViewHeaderCellStyle}">
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!--GridView 머리글 셀-->
    <Style x:Key="NotSortingGridViewHeaderCellStyle" TargetType="telerik:GridViewHeaderCell" BasedOn="{StaticResource GridViewHeaderCellStyle}">
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!--GridView 머리글-->
    <Style x:Key="CustomRadGridViewHeaderRowStyle" TargetType="telerik:GridViewHeaderRow" BasedOn="{StaticResource GridViewHeaderRowStyle}">
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=PrimarySolidBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0 0 0 1"/>
        <Setter Property="MinHeight" Value="54"/>
        <Setter Property="Template" Value="{StaticResource GridViewHeaderRowTemplate}"/>
    </Style>

    <!--GridView 행-->
    <Style TargetType="telerik:GridViewRow" BasedOn="{StaticResource GridViewRowStyle}">
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="AllowDrop" Value="True"/>
        <Setter Property="MinHeight" Value="50"/>
    </Style>

    <Style x:Key="OriginalMinHeightGridViewRowStyle" TargetType="telerik:GridViewRow" BasedOn="{StaticResource GridViewRowStyle}">
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="AllowDrop" Value="True"/>
    </Style>

    <!--Default Center GridView 행 셀-->
    <Style TargetType="telerik:GridViewCell" BasedOn="{StaticResource GridViewCellStyle}">
        <Setter Property="Padding" Value="7 0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>

    </Style>

    <!--Left GridView 행 셀-->
    <Style x:Key="GridViewCellLeftStyle" TargetType="telerik:GridViewCell" BasedOn="{StaticResource GridViewCellStyle}">
        <Setter Property="Padding" Value="7 0 7 0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <!--Center GridView 행 셀-->
    <Style x:Key="GridViewCellCenterStyle" TargetType="telerik:GridViewCell" BasedOn="{StaticResource GridViewCellStyle}">
        <Setter Property="Padding" Value="7 0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!--Rigth GridView 행 셀-->
    <Style x:Key="GridViewCellRightStyle" TargetType="telerik:GridViewCell" BasedOn="{StaticResource GridViewCellStyle}">
        <Setter Property="Padding" Value="7 0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <!--Stretch GridView 행 셀-->
    <Style x:Key="GridViewCellStretchStyle" TargetType="telerik:GridViewCell" BasedOn="{StaticResource GridViewCellStyle}">
        <Setter Property="Padding" Value="7 0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <!--Stretch Left GridView 행 셀-->
    <Style x:Key="GridViewCellStretchLeftStyle" TargetType="telerik:GridViewCell" BasedOn="{StaticResource GridViewCellStyle}">
        <Setter Property="Padding" Value="7 0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <!--Stretch Center GridView 행 셀-->
    <Style x:Key="GridViewCellStretchCenterStyle" TargetType="telerik:GridViewCell" BasedOn="{StaticResource GridViewCellStyle}">
        <Setter Property="Padding" Value="7 0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!--Enabled Rigth GridView 행 셀-->
    <Style x:Key="GridViewCellRightUnEnableStyle" TargetType="telerik:GridViewCell" BasedOn="{StaticResource GridViewCellStyle}">
        <Setter Property="Padding" Value="7 0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="IsEnabled" Value="False"/>
    </Style>

    <!--GridView Style-->
    <Style TargetType="telerik:RadGridView" BasedOn="{StaticResource RadGridViewStyle}">
        <Setter Property="MinHeight" Value="60"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="GroupRenderMode" Value="Flat"/>
        <Setter Property="CanUserResizeColumns" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="CanUserFreezeColumns" Value="True"/>
        <Setter Property="RowIndicatorVisibility" Value="Collapsed"/>
        <Setter Property="LeftFrozenColumnCount" Value="1"/>
        <Setter Property="FrozenColumnsSplitterVisibility" Value="Visible"/>
        <Setter Property="IsFilteringAllowed" Value="True"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="ClipboardCopyMode" Value="Cells,Header" />
        <Setter Property="ShowGroupPanel" Value="False"/>
        <Setter Property="ShowSearchPanel" Value="False"/>
        <Setter Property="CanUserSearch" Value="False"/>
        <Setter Property="SearchPanelBackground" Value="{telerik:Windows11Resource ResourceKey=OverlayBrush}"/>
        <Setter Property="SearchPanelCloseButtonVisibility" Value="Collapsed"/>
        <Setter Property="GridLinesVisibility" Value="Both"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="MaxWidth" Value="4000"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="IsSynchronizedWithCurrentItem" Value="True"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
        <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=FocusBrush}"/>
        <Setter Property="BorderThickness" Value="0 1 0 1"/>
        <Setter Property="IsPropertyChangedAggregationEnabled" Value="False"/>
        <Setter Property="DefaultDistinctValuesCount" Value="1000"/>
        <Setter Property="ValidatesOnDataErrors" Value="InEditMode"/>
        <Setter Property="telerik:TouchManager.TouchMode" Value="HitTestHidden"/>
        <Setter Property="IsSearchingDeferred" Value="True"/>
        <Setter Property="EnableLostFocusSelectedState" Value="False"/>
    </Style>

    <!--전체메뉴 드랍다운버튼 템플릿-->
    <ControlTemplate x:Key="AllMenuRadDropDownButtonTemplate" TargetType="telerik:RadDropDownButton">
        <Grid>
            <Border x:Name="FocusVisual" Style="{StaticResource FocusVisualBorderStyle}" CornerRadius="{TemplateBinding CornerRadius}"/>
            <Grid Margin="{TemplateBinding helpers:ThemeHelper.FocusVisualMargin}">
                <Grid SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" MinHeight="{TemplateBinding MinHeight}" MinWidth="{TemplateBinding MinWidth}">
                    <Border x:Name="BorderVisual"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="Content"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  TextBlock.Foreground="{TemplateBinding Foreground}"
                                  Margin="{TemplateBinding Padding}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True"/>
                        <Grid x:Name="DropDownIndicator"
                      Grid.Column="1"
                      Grid.Row="2"
                      Margin="{telerik:Windows11Resource ResourceKey=DropDownIndicatorMargin}"
                      Canvas.ZIndex="2"
                      IsHitTestVisible="False"
                      Visibility="{TemplateBinding DropDownIndicatorVisibility}">
                            <telerik:RadGlyph x:Name="arrow"
                                      FontSize="{telerik:Windows11Resource ResourceKey=GlyphFontSizeS}"
                                      Foreground="{telerik:Windows11Resource ResourceKey=IconSecondaryBrush}"
                                      Glyph="{StaticResource GlyphArrowChevronDown}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
            <Popup x:Name="DropDownPopup"
           AllowsTransparency="True"
           StaysOpen="False"
           Focusable="False"
           Placement="Bottom"
           PopupAnimation="{TemplateBinding PopupAnimation}"
           HorizontalOffset="-800"
           VerticalOffset="{telerik:Windows11Resource ResourceKey=PopupOffset}">
                <Grid Margin="{telerik:Windows11Resource ResourceKey=PopupMargin}">
                    <mat:Shadow Background="{telerik:Windows11Resource ResourceKey=TertiaryBackgroundBrush}" ShadowDepth="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mat:MaterialAssist.ShadowDepth)}" CornerRadius="{telerik:Windows11Resource ResourceKey=OverlayCornerRadius}"/>
                    <Border x:Name="DropDownPopupBorder"
                    MinWidth="{TemplateBinding DropDownMinWidth}"
                    MinHeight="{TemplateBinding DropDownMinHeight}"
                    Width="{TemplateBinding DropDownWidth}"
                    Height="{TemplateBinding DropDownHeight}"
                    MaxWidth="{TemplateBinding DropDownMaxWidth}"
                    MaxHeight="{TemplateBinding DropDownMaxHeight}"
                    CornerRadius="{telerik:Windows11Resource ResourceKey=OverlayCornerRadius}"
                    Background="{telerik:Windows11Resource ResourceKey=TertiaryBackgroundBrush}"
                    BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"
                    BorderThickness="1">
                        <ContentControl x:Name="DropDownPopupContent"
                                Content="{TemplateBinding DropDownContent}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                ContentTemplate="{TemplateBinding DropDownContentTemplate}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                telerik:CornerRadiusHelper.ClipRadius="{telerik:Windows11Resource ResourceKey=OverlayCornerRadius}"
                                DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DataContext}"
                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                    </Border>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>

            <!-- background is hidden -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True"/>
                    <Condition Property="IsBackgroundVisible" Value="False"/>
                    <Condition Property="IsMouseOver" Value="False"/>
                    <Condition Property="IsOpen" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
            </MultiTrigger>

            <!-- General IsKeyboardFocused setters -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="True"/>
                    <Condition Property="IsKeyboardFocused" Value="True"/>
                    <Condition Property="IsPressed" Value="False"/>
                    <Condition Property="IsMouseOver" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="FocusVisual" Property="Opacity" Value="1"/>
            </MultiTrigger>

            <!-- General setters for IsMouseOver -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBackgroundBrush)}"/>
                <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBrush)}"/>
            </Trigger>

            <!-- General setters for IsPressed -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsOpen" Value="False"/>
                    <Condition Property="IsPressed" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                <Setter TargetName="arrow" Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=TertiaryForegroundBrush}"/>
                <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.PressedBackgroundBrush)}"/>
                <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.PressedBrush)}"/>
            </MultiTrigger>

            <!-- General setters for IsOpen -->
            <Trigger Property="IsOpen" Value="True">
                <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
                <Setter TargetName="arrow" Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.CheckedBackgroundBrush)}"/>
                <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.CheckedBrush)}"/>
            </Trigger>

            <!-- disabled -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Content" Property="Opacity" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}"/>
                <Setter TargetName="DropDownIndicator" Property="Opacity" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}"/>
                <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledBackgroundBrush)}"/>
                <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledBrush)}"/>
                <Setter TargetName="Content" Property="TextBlock.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledForegroundBrush)}"/>
                <Setter TargetName="arrow" Property="Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledForegroundBrush)}"/>
            </Trigger>

            <!-- disabled and focused -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="False"/>
                    <Condition Property="IsKeyboardFocused" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="FocusVisual" Property="Opacity" Value="0"/>
            </MultiTrigger>

            <!-- disabled & background is hidden -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsEnabled" Value="False"/>
                    <Condition Property="IsBackgroundVisible" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="BorderVisual" Property="helpers:ThemeHelper.DisabledBackgroundBrush" Value="Transparent"/>
                <Setter TargetName="BorderVisual" Property="helpers:ThemeHelper.DisabledBrush" Value="Transparent"/>
            </MultiTrigger>

            <!-- DropDownButtonPosition and DropDownPacement -->
            <Trigger Property="DropDownButtonPosition" Value="Bottom"/>
            <Trigger Property="DropDownButtonPosition" Value="Left">
                <Setter TargetName="DropDownIndicator" Property="Grid.Column" Value="0"/>
                <Setter TargetName="DropDownIndicator" Property="Grid.Row" Value="1"/>
            </Trigger>
            <Trigger Property="DropDownButtonPosition" Value="Top">
                <Setter TargetName="DropDownIndicator" Property="Grid.Column" Value="1"/>
                <Setter TargetName="DropDownIndicator" Property="Grid.Row" Value="0"/>
            </Trigger>
            <Trigger Property="DropDownButtonPosition" Value="Right">
                <Setter TargetName="DropDownIndicator" Property="Grid.Column" Value="2"/>
                <Setter TargetName="DropDownIndicator" Property="Grid.Row" Value="1"/>
            </Trigger>
            <Trigger Property="DropDownPlacement" Value="Bottom"/>
            <Trigger Property="DropDownPlacement" Value="Top">
                <Setter TargetName="DropDownPopup" Property="HorizontalOffset" Value="0"/>
                <Setter TargetName="DropDownPopup" Property="VerticalOffset" Value="{Binding Source={x:Static telerik:Windows11Palette.Palette}, Path=PopupOffset, Converter={StaticResource MultiplyValueConverter}, ConverterParameter=-1}"/>
                <Setter TargetName="arrow" Property="Glyph" Value="{StaticResource GlyphArrowChevronUp}"/>
            </Trigger>
            <Trigger Property="DropDownPlacement" Value="Left">
                <Setter TargetName="DropDownPopup" Property="HorizontalOffset" Value="{Binding Source={x:Static telerik:Windows11Palette.Palette}, Path=PopupOffset, Converter={StaticResource MultiplyValueConverter}, ConverterParameter=-1}"/>
                <Setter TargetName="DropDownPopup" Property="VerticalOffset" Value="0"/>
                <Setter TargetName="arrow" Property="Glyph" Value="{StaticResource GlyphArrowChevronLeft}"/>
            </Trigger>
            <Trigger Property="DropDownPlacement" Value="Right">
                <Setter TargetName="DropDownPopup" Property="HorizontalOffset" Value="{telerik:Windows11Resource ResourceKey=PopupOffset}"/>
                <Setter TargetName="DropDownPopup" Property="VerticalOffset" Value="0"/>
                <Setter TargetName="arrow" Property="Glyph" Value="{StaticResource GlyphArrowChevronRight}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--서브메뉴-->
    <Style x:Key="SubMenuRadRadioButtonStyle" TargetType="telerik:RadRadioButton" BasedOn="{StaticResource RadRadioButtonStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0 0 10 0"/>
        <Setter Property="Padding" Value="10 8"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="GroupName" Value="subMenu"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="telerik:RadRadioButton">
                    <Border x:Name="Border" 
                        Cursor="Hand"
                        Background="{telerik:Windows11Resource ResourceKey=PrimaryBackgroundBrush}" 
                        BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}"
                        MinWidth="{TemplateBinding MinWidth}"
                        MinHeight="{TemplateBinding MinHeight}"
                        Height="{TemplateBinding Height}"
                        Margin="{TemplateBinding Margin}"
                        Padding="{TemplateBinding Padding}"
                        CornerRadius="{telerik:Windows11Resource ResourceKey=CornerRadius}">
                        <ContentPresenter x:Name="Content" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>

                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" TargetName="Border" Value="{telerik:Windows11Resource ResourceKey=MouseOverBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="Border" Value="{telerik:Windows11Resource ResourceKey=FocusBrush}"/>
                            <Setter Property="BorderThickness" TargetName="Border" Value="1"/>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                            <Setter Property="Background" TargetName="Border" Value="{telerik:Windows11Resource ResourceKey=PressedBackgroundBrush}"/>
                            <Setter Property="BorderBrush" TargetName="Border" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" TargetName="Border" Value="{telerik:Windows11Resource ResourceKey=AccentBrush}"/>
                            <Setter Property="BorderBrush" TargetName="Border" Value="{telerik:Windows11Resource ResourceKey=AccentBrush}"/>
                            <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=AccentControlForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="{telerik:Windows11Resource ResourceKey=DisabledBackgroundBrush}"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=DisabledBorderBrush}"/>
                            <Setter TargetName="Content" Property="TextBlock.Foreground" Value="{telerik:Windows11Resource ResourceKey=DisabledForegroundBrush}"/>
                            <Setter TargetName="Content" Property="Opacity" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
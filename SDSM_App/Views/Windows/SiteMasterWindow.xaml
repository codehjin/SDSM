<Window x:Class="SDSM_App.Views.Windows.SiteMasterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:viewmodel="clr-namespace:SDSM_App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type={x:Type viewmodel:SiteMasterWindowViewModel}}"
        Background="#FFFBFBFB"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        MinWidth="1180" Width="1320"
        MinHeight="720" Height="820"
        FontFamily="{StaticResource DefaultFontFamily}"
        FontSize="{StaticResource DefaultFontSize}"
        Title="조사지점 관리">

    <Window.Resources>
        <telerik:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 상단 파일 도구 -->
            <RowDefinition Height="*"/>      <!-- 트리 + 상세 -->
            <RowDefinition Height="Auto"/>   <!-- 상태 -->
        </Grid.RowDefinitions>

        <!-- 상단 : 마스터 파일 도구 -->
        <Border Grid.Row="0" Style="{StaticResource ContentBoxStyle}" Padding="12" Margin="0 0 0 10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="지점 마스터는 DB가 아니라 sites.json 파일이 원본입니다. 편집 후 [마스터 저장] → 조사자 배포는 [내보내기]."
                               Style="{StaticResource PrimaryTitleTextBlcokStyle}"/>
                    <TextBlock Text="{Binding MasterPath, StringFormat=마스터: {0}}" Margin="0 3 0 0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <telerik:RadButton Content="다시 읽기" MinWidth="90" Margin="0 0 6 0"
                                       Command="{Binding ReloadExecutedCommand}"/>
                    <telerik:RadButton Content="불러오기" MinWidth="90" Margin="0 0 6 0"
                                       Command="{Binding ImportExecutedCommand}"/>
                    <telerik:RadButton Content="마스터 저장" MinWidth="110" Margin="0 0 6 0"
                                       Style="{StaticResource AccentButtonStyle}"
                                       Command="{Binding SaveCatalogExecutedCommand}"/>
                    <telerik:RadButton Content="내보내기 (JSON)" MinWidth="130"
                                       Command="{Binding ExportExecutedCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 본문 : 좌 트리 / 우 상세 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="520"/>
            </Grid.ColumnDefinitions>

            <!-- 좌 : 4단계 트리 -->
            <Border Style="{StaticResource ContentBoxStyle}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="대분류 · 사업장 · 과업대표하천 · 지점"
                               Style="{StaticResource SubTitleTextBlcokStyle}" Margin="0 0 0 8"/>

                    <telerik:RadWatermarkTextBox Grid.Row="1" Margin="0 0 0 8"
                                                 WatermarkContent="지점명 · 설명 · 하천 · St번호 검색"
                                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>

                    <telerik:RadTreeView Grid.Row="2" x:Name="SiteTree"
                                         ItemsSource="{Binding Tree}"
                                         SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                                         IsLineEnabled="True"
                                         SelectionMode="Single">
                        <telerik:RadTreeView.ItemContainerStyle>
                            <Style TargetType="telerik:RadTreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            </Style>
                        </telerik:RadTreeView.ItemContainerStyle>
                        <telerik:RadTreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}"/>
                                    <TextBlock Text="{Binding Badge}" Margin="8 0 0 0"
                                               TextTrimming="CharacterEllipsis" MaxWidth="150"
                                               Foreground="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </telerik:RadTreeView.ItemTemplate>
                    </telerik:RadTreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- 우 : 상세 편집 -->
            <Border Grid.Column="2" Style="{StaticResource ContentBoxStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 상세 헤더 -->
                    <Grid Margin="0 0 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="지점 상세" Style="{StaticResource SubTitleTextBlcokStyle}" VerticalAlignment="Center"/>
                        <telerik:RadButton Grid.Column="1" Content="+ 새 지점" MinWidth="100"
                                           Command="{Binding NewSiteExecutedCommand}"/>
                    </Grid>

                    <!-- 지점 미선택 안내 -->
                    <TextBlock Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top"
                               Foreground="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"
                               Text="왼쪽 트리에서 지점을 고르거나 [+ 새 지점]을 누르세요."
                               Visibility="{Binding HasNoCurrent, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasCurrent, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>

                            <!-- 4단계 구분 -->
                            <TextBlock Text="구분 (SiteDivision 4단계)" Style="{StaticResource FormGroupTextBlockStyle}"/>
                            <WrapPanel>
                                <StackPanel Style="{StaticResource FormStackPanelStyle}">
                                    <Border Style="{StaticResource FormLabelBorderStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="대분류" Style="{StaticResource FormLabelStyle}"/>
                                            <TextBlock Text="*" Style="{StaticResource FormLabelRequiredStyle}"/>
                                        </StackPanel>
                                    </Border>
                                    <telerik:RadComboBox Width="{StaticResource FormControlWidth}" IsEditable="True"
                                                         Text="{Binding Project, UpdateSourceTrigger=PropertyChanged}">
                                        <telerik:RadComboBoxItem Content="방류하천"/>
                                        <telerik:RadComboBoxItem Content="생태현황"/>
                                    </telerik:RadComboBox>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormStackPanelStyle}">
                                    <Border Style="{StaticResource FormLabelBorderStyle}">
                                        <TextBlock Text="사업장" Style="{StaticResource FormLabelStyle}"/>
                                    </Border>
                                    <telerik:RadWatermarkTextBox Width="{StaticResource FormControlWidth}"
                                                                 WatermarkContent="기흥 / 화성 / 온양"
                                                                 Style="{StaticResource FormWatermarkTextBoxStyle}"
                                                                 Text="{Binding Workplace, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormStackPanelStyle}">
                                    <Border Style="{StaticResource FormLabelBorderStyle}">
                                        <TextBlock Text="과업 대표하천" Style="{StaticResource FormLabelStyle}"/>
                                    </Border>
                                    <telerik:RadWatermarkTextBox Width="{StaticResource FormControlWidth}"
                                                                 Style="{StaticResource FormWatermarkTextBoxStyle}"
                                                                 Text="{Binding River, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormStackPanelStyle}">
                                    <Border Style="{StaticResource FormLabelBorderStyle}">
                                        <TextBlock Text="지점그룹" Style="{StaticResource FormLabelStyle}"/>
                                    </Border>
                                    <telerik:RadWatermarkTextBox Width="{StaticResource FormControlWidth}"
                                                                 WatermarkContent="지천 구분 · 조사권역"
                                                                 Style="{StaticResource FormWatermarkTextBoxStyle}"
                                                                 Text="{Binding SiteGroup, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </WrapPanel>

                            <!-- 지점 식별 -->
                            <TextBlock Text="지점" Style="{StaticResource FormGroupTextBlockStyle}" Margin="0 14 0 0"/>
                            <WrapPanel>
                                <StackPanel Style="{StaticResource FormStackPanelStyle}">
                                    <Border Style="{StaticResource FormLabelBorderStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="DB상 지점명" Style="{StaticResource FormLabelStyle}"/>
                                            <TextBlock Text="*" Style="{StaticResource FormLabelRequiredStyle}"/>
                                        </StackPanel>
                                    </Border>
                                    <telerik:RadWatermarkTextBox Width="{StaticResource FormControlWidth}"
                                                                 WatermarkContent="예: 곡교천1"
                                                                 Style="{StaticResource FormWatermarkTextBoxStyle}"
                                                                 Text="{Binding SiteName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormStackPanelStyle}">
                                    <Border Style="{StaticResource FormLabelBorderStyle}">
                                        <TextBlock Text="조사장소 번호" Style="{StaticResource FormLabelStyle}"/>
                                    </Border>
                                    <telerik:RadWatermarkTextBox Width="{StaticResource FormControlWidth}"
                                                                 WatermarkContent="예: St.1"
                                                                 Style="{StaticResource FormWatermarkTextBoxStyle}"
                                                                 Text="{Binding StNo, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormStackPanelStyle}">
                                    <Border Style="{StaticResource FormLabelBorderStyle}">
                                        <TextBlock Text="지점 설명" Style="{StaticResource FormLabelStyle}"/>
                                    </Border>
                                    <telerik:RadWatermarkTextBox Width="{StaticResource FormControlBigWidth}"
                                                                 WatermarkContent="예: 배방야구장"
                                                                 Style="{StaticResource FormWatermarkTextBoxStyle}"
                                                                 Text="{Binding Desc, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormStackPanelStyle}">
                                    <Border Style="{StaticResource FormLabelBorderStyle}">
                                        <TextBlock Text="하천차수" Style="{StaticResource FormLabelStyle}"/>
                                    </Border>
                                    <telerik:RadNumericUpDown Width="{StaticResource FormControlSmallWidth}"
                                                              Minimum="0" Maximum="12" NumberDecimalDigits="0"
                                                              Style="{StaticResource FormIntNumericUpDownStyle}"
                                                              Value="{Binding Chasu, Mode=TwoWay, TargetNullValue=''}"/>
                                </StackPanel>
                            </WrapPanel>

                            <!-- 좌표 -->
                            <TextBlock Text="좌표 (십진 · DMS 모두 입력 가능 · 저장은 십진으로 통일)"
                                       Style="{StaticResource FormGroupTextBlockStyle}" Margin="0 14 0 0"/>
                            <WrapPanel>
                                <StackPanel Style="{StaticResource FormStackPanelStyle}">
                                    <Border Style="{StaticResource FormLabelBorderStyle}">
                                        <TextBlock Text="위도" Style="{StaticResource FormLabelStyle}"/>
                                    </Border>
                                    <telerik:RadWatermarkTextBox Width="{StaticResource FormControlWidth}"
                                                                 WatermarkContent="37.2122527 또는 37_12_44.11"
                                                                 Style="{StaticResource FormWatermarkTextBoxStyle}"
                                                                 Text="{Binding LatText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormStackPanelStyle}">
                                    <Border Style="{StaticResource FormLabelBorderStyle}">
                                        <TextBlock Text="경도" Style="{StaticResource FormLabelStyle}"/>
                                    </Border>
                                    <telerik:RadWatermarkTextBox Width="{StaticResource FormControlWidth}"
                                                                 WatermarkContent="127.0715531 또는 127_4_17.59"
                                                                 Style="{StaticResource FormWatermarkTextBoxStyle}"
                                                                 Text="{Binding LngText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Text="{Binding CoordPreview}" Margin="5 4 0 0" TextWrapping="Wrap"
                                       Foreground="{telerik:Windows11Resource ResourceKey=AccentBrush}"/>

                            <!-- 유효 연도 구간 -->
                            <TextBlock Text="유효 연도 구간 — 같은 지점명이 연도별로 다른 장소를 가리킬 때만 채운다"
                                       Style="{StaticResource FormGroupTextBlockStyle}" Margin="0 14 0 0"/>
                            <WrapPanel>
                                <StackPanel Style="{StaticResource FormStackPanelStyle}">
                                    <Border Style="{StaticResource FormLabelBorderStyle}">
                                        <TextBlock Text="시작 연도" Style="{StaticResource FormLabelStyle}"/>
                                    </Border>
                                    <telerik:RadNumericUpDown Width="{StaticResource FormControlSmallWidth}"
                                                              Minimum="2000" Maximum="2100" NumberDecimalDigits="0"
                                                              Style="{StaticResource FormIntNumericUpDownStyle}"
                                                              Value="{Binding ValidFrom, Mode=TwoWay, TargetNullValue=''}"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FormStackPanelStyle}">
                                    <Border Style="{StaticResource FormLabelBorderStyle}">
                                        <TextBlock Text="끝 연도" Style="{StaticResource FormLabelStyle}"/>
                                    </Border>
                                    <telerik:RadNumericUpDown Width="{StaticResource FormControlSmallWidth}"
                                                              Minimum="2000" Maximum="2100" NumberDecimalDigits="0"
                                                              Style="{StaticResource FormIntNumericUpDownStyle}"
                                                              Value="{Binding ValidTo, Mode=TwoWay, TargetNullValue=''}"/>
                                </StackPanel>
                                <TextBlock Text="비워 두면 제한 없음. 예) 진위천1 은 2023~2024 와 2025~ 두 건으로 나눈다."
                                           VerticalAlignment="Center" Margin="10 0 0 0" TextWrapping="Wrap" MaxWidth="330"
                                           Foreground="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                            </WrapPanel>

                            <!-- 적용 분류군 -->
                            <TextBlock Text="적용 분류군" Style="{StaticResource FormGroupTextBlockStyle}" Margin="0 14 0 0"/>
                            <ItemsControl ItemsSource="{Binding TaxaChecks}" Margin="5 0 0 0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Margin="0 0 16 6" VerticalContentAlignment="Center"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 연도별 지점명 이력 -->
                            <Grid Margin="0 14 0 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="연도별 지점명 이력 (연도구간 → 표기)" Style="{StaticResource FormGroupTextBlockStyle}"/>
                                <telerik:RadButton Grid.Column="1" Content="+ 행 추가" MinWidth="80" MinHeight="28"
                                                   Command="{Binding AddAliasExecutedCommand}"/>
                            </Grid>
                            <telerik:RadGridView ItemsSource="{Binding YearAliases}" AutoGenerateColumns="False"
                                                 ShowGroupPanel="False" RowIndicatorVisibility="Collapsed"
                                                 CanUserFreezeColumns="False" MinHeight="70" MaxHeight="150"
                                                 HeaderRowStyle="{StaticResource CustomRadGridViewHeaderRowStyle}">
                                <telerik:RadGridView.Columns>
                                    <telerik:GridViewDataColumn Header="연도구간" DataMemberBinding="{Binding Key}" Width="150"/>
                                    <telerik:GridViewDataColumn Header="표기" DataMemberBinding="{Binding Value}" Width="*"/>
                                    <telerik:GridViewDataColumn Header="" Width="60" IsReadOnly="True"
                                                                HeaderCellStyle="{StaticResource NotSortingGridViewHeaderCellStyle}">
                                        <telerik:GridViewDataColumn.CellTemplate>
                                            <DataTemplate>
                                                <telerik:RadButton Content="삭제" MinWidth="46" MinHeight="26" Margin="0"
                                                                   Command="{Binding DataContext.RemoveAliasExecutedCommand,
                                                                             RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </telerik:GridViewDataColumn.CellTemplate>
                                    </telerik:GridViewDataColumn>
                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>

                            <!-- 연도별 지도 번호 -->
                            <Grid Margin="0 14 0 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="연도별 지도 번호 (연도구간 → 번호)" Style="{StaticResource FormGroupTextBlockStyle}"/>
                                <telerik:RadButton Grid.Column="1" Content="+ 행 추가" MinWidth="80" MinHeight="28"
                                                   Command="{Binding AddMapNumberExecutedCommand}"/>
                            </Grid>
                            <telerik:RadGridView ItemsSource="{Binding MapNumbers}" AutoGenerateColumns="False"
                                                 ShowGroupPanel="False" RowIndicatorVisibility="Collapsed"
                                                 CanUserFreezeColumns="False" MinHeight="70" MaxHeight="150"
                                                 HeaderRowStyle="{StaticResource CustomRadGridViewHeaderRowStyle}">
                                <telerik:RadGridView.Columns>
                                    <telerik:GridViewDataColumn Header="연도구간" DataMemberBinding="{Binding Key}" Width="150"/>
                                    <telerik:GridViewDataColumn Header="번호" DataMemberBinding="{Binding Value}" Width="*"/>
                                    <telerik:GridViewDataColumn Header="" Width="60" IsReadOnly="True"
                                                                HeaderCellStyle="{StaticResource NotSortingGridViewHeaderCellStyle}">
                                        <telerik:GridViewDataColumn.CellTemplate>
                                            <DataTemplate>
                                                <telerik:RadButton Content="삭제" MinWidth="46" MinHeight="26" Margin="0"
                                                                   Command="{Binding DataContext.RemoveMapNumberExecutedCommand,
                                                                             RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </telerik:GridViewDataColumn.CellTemplate>
                                    </telerik:GridViewDataColumn>
                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>

                            <!-- 지점 사진 -->
                            <Grid Margin="0 14 0 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="지점 사진 (사진 루트로 복사되고 상대경로만 저장)"
                                           Style="{StaticResource FormGroupTextBlockStyle}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <telerik:RadButton Content="사진 추가" MinWidth="80" MinHeight="28" Margin="0 0 4 0"
                                                       Command="{Binding AddPhotoExecutedCommand}"/>
                                    <telerik:RadButton Content="열기" MinWidth="60" MinHeight="28" Margin="0 0 4 0"
                                                       Command="{Binding OpenPhotoExecutedCommand}"/>
                                    <telerik:RadButton Content="목록에서 빼기" MinWidth="110" MinHeight="28"
                                                       Command="{Binding RemovePhotoExecutedCommand}"/>
                                </StackPanel>
                            </Grid>
                            <telerik:RadGridView ItemsSource="{Binding Photos}"
                                                 SelectedItem="{Binding SelectedPhoto, Mode=TwoWay}"
                                                 AutoGenerateColumns="False" ShowGroupPanel="False"
                                                 RowIndicatorVisibility="Collapsed" CanUserFreezeColumns="False"
                                                 MinHeight="80" MaxHeight="170"
                                                 HeaderRowStyle="{StaticResource CustomRadGridViewHeaderRowStyle}">
                                <telerik:RadGridView.Columns>
                                    <telerik:GridViewDataColumn Header="파일" DataMemberBinding="{Binding FileName}" Width="200" IsReadOnly="True"/>
                                    <telerik:GridViewDataColumn Header="설명" DataMemberBinding="{Binding Caption}" Width="*"/>
                                    <telerik:GridViewDataColumn Header="연도" DataMemberBinding="{Binding Year}" Width="80"/>
                                    <telerik:GridViewDataColumn Header="상태" DataMemberBinding="{Binding StateText}" Width="90" IsReadOnly="True"/>
                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>
                            <Grid Margin="5 4 0 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding PhotoRoot, StringFormat=사진 루트: {0}}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Foreground="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                                <telerik:RadButton Grid.Column="1" Content="루트 변경" MinWidth="80" MinHeight="26"
                                                   Command="{Binding ChangePhotoRootExecutedCommand}"/>
                            </Grid>

                            <!-- 병합 -->
                            <TextBlock Text="병합 — 고른 지점을 현재 지점에 합치고 목록에서 지운다"
                                       Style="{StaticResource FormGroupTextBlockStyle}" Margin="0 14 0 0"/>
                            <StackPanel Orientation="Horizontal" Margin="5 0 0 0">
                                <telerik:RadComboBox Width="{StaticResource FormControlBigWidth}"
                                                     ItemsSource="{Binding MergeCandidates}"
                                                     SelectedItem="{Binding MergeTarget, Mode=TwoWay}"
                                                     DisplayMemberPath="DisplayWithPeriod"
                                                     IsEditable="True" IsFilteringEnabled="True"
                                                     EmptyText="합칠 지점 선택 (같은 대분류)"/>
                                <telerik:RadButton Content="병합" MinWidth="80" Margin="8 0 0 0"
                                                   Command="{Binding MergeSiteExecutedCommand}"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- 상세 하단 액션 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 12 0 0"
                                Visibility="{Binding HasCurrent, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <telerik:RadButton Content="지점 삭제" MinWidth="100" Margin="0 0 6 0"
                                           Command="{Binding DeleteSiteExecutedCommand}"/>
                        <telerik:RadButton Content="지점 저장" MinWidth="120"
                                           Style="{StaticResource AccentButtonStyle}"
                                           Command="{Binding SaveSiteExecutedCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 상태 -->
        <Grid Grid.Row="2" Margin="0 10 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{telerik:Windows11Resource ResourceKey=AccentBrush}"/>
            <telerik:RadButton Grid.Column="1" Content="닫기" MinWidth="90" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>

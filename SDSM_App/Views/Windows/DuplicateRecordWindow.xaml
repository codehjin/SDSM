<Window x:Class="SDSM_App.Views.Windows.DuplicateRecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Background="{telerik:Windows11Resource ResourceKey=PrimaryBackgroundBrush}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Width="620"
        FontFamily="{StaticResource DefaultFontFamily}"
        FontSize="{StaticResource DefaultFontSize}"
        Title="같은 기록이 있습니다">

    <!-- 일괄등록 중복 확인(2026-10-21 연계시험 문제 2·3) — [건너뛰기(기본)/바꾸기/추가] + 나머지도 같게 -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 12">
            <icon:PackIconMaterial Kind="AlertCircleOutline" Width="22" Height="22" VerticalAlignment="Center"
                                   Foreground="{telerik:Windows11Resource ResourceKey=AccentBrush}"/>
            <TextBlock x:Name="HeaderTextBlock" Style="{StaticResource PrimaryTitleTextBlcokStyle}" Margin="10 0 0 0"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource ContentBoxStyle}" Padding="14 10" Margin="0 0 0 8">
            <StackPanel>
                <TextBlock Text="새로 저장할 기록" Style="{StaticResource SubTitleTextBlcokStyle}" Margin="0 0 0 4"/>
                <TextBlock x:Name="NewTextBlock" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ContentBoxStyle}" Padding="14 10" Margin="0 0 0 12">
            <StackPanel>
                <TextBlock Text="DB에 이미 있는 기록" Style="{StaticResource SubTitleTextBlcokStyle}" Margin="0 0 0 4"/>
                <TextBlock x:Name="ExistingTextBlock" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" TextWrapping="Wrap" Margin="0 0 0 12"
                   Foreground="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"
                   Text="건너뛰기: 새 기록을 저장하지 않음 · 바꾸기: DB의 같은 기록을 지우고 새로 저장 · 추가: 둘 다 남김"/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="ApplyToRestCheckBox" Content="나머지 같은 기록에도 같게 적용" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <telerik:RadButton x:Name="SkipButton" Content="건너뛰기" MinWidth="96" Margin="0 0 6 0" IsDefault="True"
                                   Style="{StaticResource AccentButtonStyle}" Click="SkipButton_Click"/>
                <telerik:RadButton x:Name="ReplaceButton" Content="바꾸기" MinWidth="96" Margin="0 0 6 0" Click="ReplaceButton_Click"/>
                <telerik:RadButton x:Name="AddButton" Content="추가" MinWidth="96" Click="AddButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

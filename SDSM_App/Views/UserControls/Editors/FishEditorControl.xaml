                                    <Run Text="서식처"/>
                                    <LineBreak/>
                                    <Run Text="하상"/>
                                    <LineBreak/>
                                    <Run Text="구성"/>
                                </TextBlock>
                            </Border>
                            <Border Height="40" Margin="0 4 0 0" Style="{StaticResource FormGroupBorderStyle}">
                                <TextBlock Style="{StaticResource FormGroupTextBlockStyle}">
                                    <Run Text="서식처"/>
                                </TextBlock>
                            </Border>
                            <Border Height="84" Margin="0 4 0 0" Style="{StaticResource FormGroupBorderStyle}">

                                <TextBlock Style="{StaticResource FormGroupTextBlockStyle}">
                                    <Run Text="조사"/>
                                    <LineBreak/>
                                    <Run Text="개황"/>
                                </TextBlock>
                            </Border>
                            <Border Height="84" Margin="0 4 0 0" Style="{StaticResource FormGroupBorderStyle}">
                                <TextBlock Style="{StaticResource FormGroupTextBlockStyle}">
                                    <Run Text="채집"/>
                                    <LineBreak/>
                                    <Run Text="방법"/>
                                </TextBlock>
                            </Border>
                            <Border Height="84" Margin="0 48 0 0" Style="{StaticResource FormGroupBorderStyle}">
                                <TextBlock Style="{StaticResource FormGroupTextBlockStyle}">
                                    <Run Text="서식처"/>
                                    <LineBreak/>
                                    <Run Text="하천"/>
                                    <LineBreak/>
                                    <Run Text="유형"/>
                                </TextBlock>
                            </Border>
                            <Border Height="40" Margin="0 4 0 0" Style="{StaticResource FormGroupBorderStyle}">

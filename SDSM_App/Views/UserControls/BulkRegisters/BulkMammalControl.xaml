<UserControl x:Class="SDSM_App.Views.UserControls.BulkRegisters.BulkMammalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:helpers="clr-namespace:Telerik.Windows.Controls.Theming.Helpers;assembly=Telerik.Windows.Controls"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:viewmodel="clr-namespace:SDSM_App.ViewModels"
             d:DataContext="{d:DesignInstance Type={x:Type viewmodel:BulkMammalControlViewModel}}"
             x:Name="_this">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--엑셀 설정값-->
        <Border x:Name="SettingLayout" Style="{StaticResource ContentBoxStyle}">
            <StackPanel Orientation="Horizontal" Height="{StaticResource DefaultHeight}">
                <TextBlock Text="시트명" Style="{StaticResource PrimaryTextBlcokStyle}"/>
                <TextBox Text="{Binding Path=SheetName}" Width="160" Margin="10 0 20 0"/>
                <TextBlock Text="자료 시작 첫번째" Style="{StaticResource PrimaryTextBlcokStyle}"/>
                <TextBlock Text=" 행" Foreground="{telerik:Windows11Resource ResourceKey=ValidationBrush}" Style="{StaticResource PrimaryTextBlcokStyle}"/>
                <telerik:RadNumericUpDown Value="{Binding Path=FirstRowNumber, Mode=TwoWay}"
                                          Minimum="2"
                                          Maximum="9"
                                          IsInteger="True"
                                          HorizontalContentAlignment="Left"
                                          Width="90" 
                                          Margin="10 0"/>
                <TextBlock Text=" 열" Foreground="{telerik:Windows11Resource ResourceKey=ValidationBrush}" Style="{StaticResource PrimaryTextBlcokStyle}"/>
                <telerik:RadNumericUpDown Value="{Binding Path=FirstColumnNumber, Mode=TwoWay}"
                           Minimum="1"
                           Maximum="5"
                           IsInteger="True"
                           HorizontalContentAlignment="Left"
                           Width="90" 
                           Margin="10 0"/>
                <telerik:RadDropDownButton Content="항목 열 위치">

                </telerik:RadDropDownButton>
                <telerik:RadButton Content="자료 가져오기" Margin="10 0 0 0" Command="{Binding Path=DataImportExecutedCommand}" Style="{StaticResource DarkButtonStyle}"/>
            </StackPanel>
        </Border>

        <!--자료 선택-->
        <Grid Grid.Row="1" Margin="0 20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" >
                <telerik:RadToggleButton x:Name="ImportRadToggleButton" Content="가져온 자료" IsChecked="True"  Width="150" Height="44" Margin="0 0 5 0" Cursor="Hand"/>
                <telerik:RadToggleButton x:Name="ConvertedRadToggleButton" Content="변환된 자료" IsChecked="True" Width="150" Height="44" Cursor="Hand"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <telerik:RadButton Content="변환된 자료 일괄 저장" Command="{Binding Path=SaveExecutedCommand}" Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="*"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=IsChecked, ElementName=ImportRadToggleButton}" Value="False">
                                    <Setter Property="Width" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="*"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=IsChecked, ElementName=ConvertedRadToggleButton}" Value="False">
                                    <Setter Property="Width" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>

            <!--가져온 자료-->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ContentBoxStyle}">
                        <Setter Property="Margin" Value="0 0 0 0"/>
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=IsChecked, ElementName=ConvertedRadToggleButton}" Value="True">
                                <Setter Property="Margin" Value="0 0 5 0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=IsChecked, ElementName=ImportRadToggleButton}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 10" VerticalAlignment="Center">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PrimaryTextBlcokStyle}"/>
                        </StackPanel.Resources>
                        <TextBlock Text="가져온 자료"/>
                        <TextBlock Text="총" Margin="20 0 5 0"/>
                        <TextBlock Text="{Binding Path=ModelCollection.Count, Mode=OneWay, StringFormat={}{0:N0}건}"/>
                        <TextBlock Text="오류" Margin="10 0 5 0"/>
                        <TextBlock Text="{Binding Path=ErrorCount, StringFormat={}{0:N0}}" Foreground="{telerik:Windows11Resource ResourceKey=ValidationBrush}"/>
                        <TextBlock Text="건"/>
                    </StackPanel>
                    <telerik:RadButton Grid.Column="1" Margin="0 0 0 10" Tag="import" Click="DataExportButton_Click">
                        <telerik:RadButton.Style>
                            <Style TargetType="telerik:RadButton" BasedOn="{StaticResource ExportButtonBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=Items.Count, Mode=OneWay, ElementName=DataRadGridView}" Value="0">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </telerik:RadButton.Style>
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconModern Kind="OfficeExcel" VerticalAlignment="Center" Width="14" Height="14"/>
                            <TextBlock Text="목록 출력" Margin="5 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadGridView x:Name="DataRadGridView"
                                         Grid.Column="0"
                                         Grid.Row="1"
                                         Grid.ColumnSpan="2"
                                         ItemsSource="{Binding Path=ModelCollection}"
                                         HeaderRowStyle="{StaticResource CustomRadGridViewHeaderRowStyle}"
                                         BusyIndicatorContentTemplate="{StaticResource ExportBusyGridViewTemplate}"
                                         FrozenColumnsSplitterVisibility="Collapsed"
                                         LeftFrozenColumnCount="0"
                                         RowIndicatorVisibility="Collapsed"
                                         IsFilteringAllowed="False">
                        <telerik:RadGridView.Columns>
                            <telerik:GridViewDataColumn Header="오류 내용" DataMemberBinding="{Binding Path=ErrorContent}" MinWidth="60" MaxWidth="460" TextTrimming="CharacterEllipsis"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=YearChsu}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SurveyDate}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Weather}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=River}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Site}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SpeciesKo}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SpeciesEn}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Feature}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Lat_Do}" MinWidth="60" Width="200" MaxWidth="200"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Lat_Bun}" MinWidth="60" Width="200" MaxWidth="200"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Lat_Cho}" MinWidth="60" Width="200" MaxWidth="200"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Lng_Do}" MinWidth="60" Width="200" MaxWidth="200"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Lng_Bun}" MinWidth="60" Width="200" MaxWidth="200"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Lng_Cho}" MinWidth="60" Width="200" MaxWidth="200"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Lat}" MinWidth="60" Width="200" MaxWidth="200"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Lng}" MinWidth="60" Width="200" MaxWidth="200"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=ObservationSite}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Trace1}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Trace2}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Trace3}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Trace4}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Trace5}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Trace6}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Trace7}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Trace8}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Trace9}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Trace10}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Trace11}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Trace12}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Surveyor}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Note}" MinWidth="60" Width="160" MaxWidth="160"/>
                        </telerik:RadGridView.Columns>
                    </telerik:RadGridView>
                </Grid>
            </Border>

            <!--변환된 자료-->
            <Border Grid.Column="1">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ContentBoxStyle}">
                        <Setter Property="Margin" Value="0 0 0 0"/>
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=IsChecked, ElementName=ImportRadToggleButton}" Value="True">
                                <Setter Property="Margin" Value="5 0 0 0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=IsChecked, ElementName=ConvertedRadToggleButton}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 10" VerticalAlignment="Center">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PrimaryTextBlcokStyle}"/>
                        </StackPanel.Resources>
                        <TextBlock Text="변환된 자료"/>
                        <TextBlock Text="총" Margin="20 0 5 0"/>
                        <TextBlock Text="{Binding Path=ConvertedCollection.Count, Mode=OneWay, StringFormat={}{0:N0}건}"/>
                        <TextBlock Text="오류" Margin="10 0 5 0"/>
                        <TextBlock Text="{Binding Path=ErrorCount, StringFormat={}{0:N0}}" Foreground="{telerik:Windows11Resource ResourceKey=ValidationBrush}"/>
                        <TextBlock Text="건"/>
                    </StackPanel>
                    <telerik:RadButton Grid.Column="1" Margin="0 0 0 10" Tag="converted" Click="DataExportButton_Click">
                        <telerik:RadButton.Style>
                            <Style TargetType="telerik:RadButton" BasedOn="{StaticResource ExportButtonBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=Items.Count, Mode=OneWay, ElementName=ConvertedDataRadGridView}" Value="0">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </telerik:RadButton.Style>
                        <StackPanel Orientation="Horizontal">
                            <icon:PackIconModern Kind="OfficeExcel" VerticalAlignment="Center" Width="14" Height="14"/>
                            <TextBlock Text="목록 출력" Margin="5 0 0 0"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadGridView x:Name="ConvertedDataRadGridView"
                                         Grid.Column="0"
                                         Grid.Row="1"
                                         Grid.ColumnSpan="2"
                                         ItemsSource="{Binding Path=ConvertedCollection}"
                                         HeaderRowStyle="{StaticResource CustomRadGridViewHeaderRowStyle}"
                                         BusyIndicatorContentTemplate="{StaticResource ExportBusyGridViewTemplate}"
                                         FrozenColumnsSplitterVisibility="Collapsed"
                                         LeftFrozenColumnCount="0"
                                         RowIndicatorVisibility="Collapsed"
                                         IsFilteringAllowed="False">
                        <telerik:RadGridView.Columns>
                            <telerik:GridViewDataColumn Header="오류 내용" DataMemberBinding="{Binding Path=ErrorContent}" MinWidth="60" MaxWidth="460" TextTrimming="CharacterEllipsis"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=YearChsu}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SurveyDate}" DataFormatString="{}{0:yyyy-MM-dd}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Weather}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=River}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Site}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SpeciesKo}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SpeciesEn}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Feature}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Lat_Do}" MinWidth="60" Width="200" MaxWidth="200"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Lat_Bun}" MinWidth="60" Width="200" MaxWidth="200"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Lat_Cho}" MinWidth="60" Width="200" MaxWidth="200"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Lng_Do}" MinWidth="60" Width="200" MaxWidth="200"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Lng_Bun}" MinWidth="60" Width="200" MaxWidth="200"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Lng_Cho}" MinWidth="60" Width="200" MaxWidth="200"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Lat}" MinWidth="60" Width="200" MaxWidth="200"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Lng}" MinWidth="60" Width="200" MaxWidth="200"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=ObservationSite}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Trace1}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Trace2}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Trace3}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Trace4}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Trace5}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Trace6}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Trace7}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Trace8}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Trace9}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Trace10}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Trace11}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Trace12}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Surveyor}" MinWidth="60" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Note}" MinWidth="60" Width="160" MaxWidth="160"/>
                        </telerik:RadGridView.Columns>
                    </telerik:RadGridView>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>

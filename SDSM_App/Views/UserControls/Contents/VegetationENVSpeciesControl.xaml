<UserControl x:Class="SDSM_App.Views.UserControls.VegetationENVSpeciesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:helpers="clr-namespace:Telerik.Windows.Controls.Theming.Helpers;assembly=Telerik.Windows.Controls"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:uc="clr-namespace:SDSM_App.Views.UserControls"
             xmlns:viewmodel="clr-namespace:SDSM_App.ViewModels"
             d:DataContext="{d:DesignInstance Type={x:Type viewmodel:FishSpeciesControlViewModel}}"
             x:Name="_this">
    <Border Background="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}" Margin="20 0 20 20" Padding="0"  Style="{StaticResource ContentBoxStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Margin="20 20 20 0" Padding="0" BorderThickness="0" Background="Transparent" Style="{StaticResource ContentBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="SearchLayout" Margin="0 0 0 5" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                        <Grid Height="{StaticResource DefaultHeight}" Margin="0 0 0 5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Height="{StaticResource DefaultHeight}">
                                <StackPanel.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PrimaryTextBlcokStyle}"/>
                                </StackPanel.Resources>
                                <TextBlock Text="전체" Margin="0 0 5 0"/>
                                <TextBlock Text="{Binding Path=ModelCollection.Count, Mode=OneWay, StringFormat={}{0:N0}}" Margin="3 0 0 0"/>
                                <TextBlock Text="건" Margin="0 0 5 0"/>
                                <TextBlock Text="/" Margin="5 0"/>
                                <TextBlock Text="페이지" Margin="5 0 5 0"/>
                                <TextBlock Text="{Binding Path=Items.Count, Mode=OneWay, ElementName=SpeciesDataRadGridView, StringFormat={}{0:N0}}" Margin="3 0 0 0" Foreground="{telerik:Windows11Resource ResourceKey=ValidationBrush}"/>
                                <TextBlock Text="건"/>
                            </StackPanel>

                            <!--검색/출력-->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10 0">
                                <telerik:RadComboBox ItemsSource="{Binding Path=SearchModeSource}" 
                                                     SelectedValue="{Binding Path=SearchModeSelectedValue}"
                                                     DisplayMemberPath="DisplayName"
                                                     SelectedValuePath="Value"
                                                     Width="120"
                                                     IsTabStop="False"
                                                     Margin="0 0 5 0"
                                                     Cursor="Hand"/>
                                <telerik:RadAutoSuggestBox Text="{Binding Path=SearchText}" Style="{StaticResource SearhcBoxStyle}" QuerySubmitted="SearchBox_QuerySubmitted" KeyDown="SearchBox_KeyDown"/>
                                <!--새로고침-->
                                <telerik:RadButton Style="{StaticResource ResetButtonStyle}" Click="ResetButton_Click"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Height="{StaticResource DefaultHeight}">
                                <!--페이지 출력-->
                                <telerik:RadButton Cursor="Hand" helpers:ThemeHelper.MouseOverBrush="{telerik:Windows11Resource ResourceKey=FocusBrush}" Click="DataExportButton_Click">
                                    <telerik:RadButton.Style>
                                        <Style TargetType="telerik:RadButton">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=Items.Count, Mode=OneWay, ElementName=SpeciesDataRadGridView}" Value="0">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </telerik:RadButton.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <icon:PackIconModern Kind="OfficeExcel" VerticalAlignment="Center" Width="14" Height="14"/>
                                        <TextBlock Text="페이지 출력" Margin="5 0 0 0"/>
                                    </StackPanel>
                                </telerik:RadButton>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!--종 목록-->
                    <telerik:RadGridView x:Name="SpeciesDataRadGridView"
                                 Grid.Row="1"
                                 ItemsSource="{Binding Path=ModelCollection}"
                                 HeaderRowStyle="{StaticResource CustomRadGridViewHeaderRowStyle}"
                                 BusyIndicatorContentTemplate="{StaticResource ExportBusyGridViewTemplate}"
                                 BusyIndicatorIsIndeterminate="False"
                                 FrozenColumnsSplitterVisibility="Visible"
                                 RowIndicatorVisibility="Collapsed"
                                 LeftFrozenColumnCount="0">
                        <telerik:RadGridView.ColumnGroups>
                            <telerik:GridViewColumnGroup Name="species" Header="출현종"/>
                        </telerik:RadGridView.ColumnGroups>
                        <telerik:RadGridView.Columns>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Project}" MinWidth="80" Width="140" MaxWidth="140"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Workplace}" MinWidth="80" Width="140" MaxWidth="140"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=WorkplaceRiver}" MinWidth="80" Width="140" MaxWidth="140"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SurveyYear}" MinWidth="80" Width="120" MaxWidth="120"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Chsu}" MinWidth="80" Width="120" MaxWidth="120"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SurveyDate}" DataFormatString="{}{0:yyyy-MM-dd}" MinWidth="80" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Weather}" MinWidth="80" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Site}" MinWidth="80" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=River}" MinWidth="80" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Surveyor}" MinWidth="80" Width="180" MaxWidth="180" TextWrapping="Wrap"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=StartLat}" DataFormatString="F6" MinWidth="80" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=StartLng}" DataFormatString="F6" MinWidth="80" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=StartAddress}" MinWidth="80" Width="320" MaxWidth="320" TextWrapping="Wrap"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=EndLat}" DataFormatString="F6" MinWidth="80" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=EndLng}" DataFormatString="F6" MinWidth="80" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=StartAzimuth}" MinWidth="80" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=RLSubstrateStructure}" MinWidth="80" Width="160" MaxWidth="160" TextWrapping="Wrap"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=RLDisturbance}" MinWidth="80" Width="160" MaxWidth="160" TextWrapping="Wrap"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=ILLeftLandUse}" MinWidth="80" Width="180" MaxWidth="180" TextWrapping="Wrap"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=ILRightLandUse}" MinWidth="80" Width="180" MaxWidth="180" TextWrapping="Wrap"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Distance}" MinWidth="80" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Slope}" MinWidth="80" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=DepthWater}" MinWidth="80" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=HashingMaterial}" MinWidth="80" Width="160" MaxWidth="160" TextWrapping="Wrap"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Cluster}" MinWidth="80" Width="160" MaxWidth="160" TextWrapping="Wrap"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=T1Height}" MinWidth="80" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=T1CoverDegree}" MinWidth="80" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=T2Height}" MinWidth="80" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=T2CoverDegree}" MinWidth="80" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SHeight}" MinWidth="80" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SCoverDegree}" MinWidth="80" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=HHeight}" MinWidth="80" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=HCoverDegree}" MinWidth="80" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Layer}" MinWidth="80" Width="160" MaxWidth="160"  ColumnGroupName="species"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SpeciesKo}" MinWidth="80" Width="240" MaxWidth="240" TextWrapping="Wrap" ColumnGroupName="species"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=CoverDegree}" MinWidth="80" Width="160" MaxWidth="160" ColumnGroupName="species"/>
                        </telerik:RadGridView.Columns>
                    </telerik:RadGridView>
                </Grid>
            </Border>

            <!--페이징-->
            <Grid Grid.Row="1" Margin="20 10 20 20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <uc:PageSizeCommandControl MinCommand="{Binding Path=PageSizeMinExecutedCommand}" AvgCommand="{Binding Path=PageSizeAvgExecutedCommand}" MaxCommand="{Binding Path=PageSizeMaxExecutedCommand}"/>
                    <telerik:RadNumericUpDown Value="{Binding Path=PageSize}" Style="{StaticResource PageSizeRadNumericUpDownStyle}">
                        <telerik:EventToCommandBehavior.EventBindings>
                            <telerik:EventBinding EventName="ValueChanged" Command="{Binding Path=PageSizeChangedExecutedCommand}" PassEventArgsToCommand="True"/>
                        </telerik:EventToCommandBehavior.EventBindings>
                    </telerik:RadNumericUpDown>
                </StackPanel>

                <telerik:RadDataPager Grid.Column="1"
                                      ItemCount="{Binding Path=ModelTotal}"
                                      PageSize="{Binding Path=PageSize}"
                                      PageIndex="{Binding Path=PageIndex, Mode=TwoWay}"
                                      Margin="0">
                    <telerik:EventToCommandBehavior.EventBindings>
                        <telerik:EventBinding EventName="PageIndexChanged" Command="{Binding Path=PageIndexChangedExecutedCommand}" PassEventArgsToCommand="True"/>
                    </telerik:EventToCommandBehavior.EventBindings>
                </telerik:RadDataPager>
            </Grid>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="SDSM_App.Views.UserControls.PasswordChangeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="비밀번호 변경" Style="{StaticResource PrimaryTitleTextBlcokStyle}" Margin="0 0 0 10"/>
        <telerik:RadPasswordBox x:Name="CurrentPasswordBox"
                                Grid.Row="1"
                                Label="현재 비밀번호" 
                                MaxLength="20"
                                Height="62" 
                                Margin="0 0 0 5"
                                Tag="password"
                                TextChanged="CurrentPasswordBox_TextChanged"/>
        <telerik:RadPasswordBox x:Name="NewPasswordBox"
                                Grid.Row="2"
                                Label="새 비밀번호" 
                                MaxLength="20"
                                Height="62" 
                                Margin="0 0 0 5"
                                Tag="newpassword"
                                TextChanged="NewPasswordBox_TextChanged"/>
        <telerik:RadPasswordBox x:Name="NewCheckPasswordBox"
                                Grid.Row="3"
                                Label="새 비밀번호 확인" 
                                MaxLength="20"
                                Height="62"
                                Margin="0 0 0 15"
                                Tag="newpasswordcheck"
                                TextChanged="NewCheckPasswordBox_TextChanged"/>
        <telerik:RadButton x:Name="SaveButton"
                           Grid.Row="4" 
                           Content="확인" 
                           Height="50"
                           Style="{StaticResource AccentButtonStyle}"
                           Click="SaveButton_Click"/>

        <TextBlock x:Name="ErrorTextBlock" 
                   Grid.Row="5" 
                   Margin="0 10 0 0"
                   Text=""
                   Visibility="Collapsed"
                   Foreground="{telerik:Windows11Resource ResourceKey=ValidationBrush}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"/>

    </Grid>
</UserControl>

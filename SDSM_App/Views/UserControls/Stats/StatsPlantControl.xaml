<UserControl x:Class="SDSM_App.Views.UserControls.StatsPlantControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:chartView="clr-namespace:Telerik.Windows.Controls.ChartView;assembly=Telerik.Windows.Controls.Chart"
             xmlns:helpers="clr-namespace:Telerik.Windows.Controls.Theming.Helpers;assembly=Telerik.Windows.Controls"
             xmlns:ani="clr-namespace:SDSM_App.Animations"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behavior="clr-namespace:SDSM_App.Behaviors"
             xmlns:converter="clr-namespace:SDSM_App.Converters"
             xmlns:common="clr-namespace:SDSM_App.Commons"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:viewmodel="clr-namespace:SDSM_App.ViewModels"
             d:DataContext="{d:DesignInstance Type={x:Type viewmodel:StatsPlantControlViewModel}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--검색-->
        <Grid Grid.Row="2" Margin="30 10 30 10" MaxWidth="{StaticResource ContentMaxWidth}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" >
                <StackPanel Orientation="Horizontal" Margin="0 0 50 0">
                    <telerik:RadGlyph Glyph="{StaticResource GlyphCheck}"/>
                    <TextBlock Text="{Binding Path=SearchCondition}" Style="{StaticResource SubTitleTextBlcokStyle}" Foreground="{telerik:Windows11Resource ResourceKey=AccentBrush}" Margin="5 0 10 0" FontSize="18"/>
                    <TextBlock Text="(년)" Style="{StaticResource SubTitleTextBlcokStyle}"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource ContentBoxStyle}" Padding="20 10" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Height="{StaticResource DefaultHeight}" HorizontalAlignment="Left">
                        <TextBlock Text="연도 선택" Style="{StaticResource PrimaryTextBlcokStyle}"/>
                        <telerik:RadComboBox ItemsSource="{Binding Path=SearchCollection}"
                                             Margin="10 0"
                                             ItemTemplate="{StaticResource MultiCheckBoxItemTemplate}"
                                             MultipleSelectionBoxTemplate="{StaticResource MultiSelectionBoxTemplate}"
                                             Style="{StaticResource MultiRadComboBoxStyle}">
                            <telerik:RadComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid>
                                        <UniformGrid.Style>
                                            <Style TargetType="UniformGrid">
                                                <Setter Property="Columns" Value="5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadComboBox}}" Value="1">
                                                        <Setter Property="Columns" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadComboBox}}" Value="2">
                                                        <Setter Property="Columns" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadComboBox}}" Value="3">
                                                        <Setter Property="Columns" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadComboBox}}" Value="4">
                                                        <Setter Property="Columns" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </UniformGrid.Style>
                                    </UniformGrid>
                                </ItemsPanelTemplate>
                            </telerik:RadComboBox.ItemsPanel>
                            <i:Interaction.Behaviors>
                                <behavior:RadComboBoxSelectedItemsBehavior SelectedItems="{Binding Path=SearchSelectedItems, Mode=TwoWay}" />
                            </i:Interaction.Behaviors>
                        </telerik:RadComboBox>
                        <telerik:RadButton Padding="20 0" Command="{Binding Path=SearchExecutedCommand}">
                            <telerik:RadButton.Style>
                                <Style TargetType="telerik:RadButton" BasedOn="{StaticResource AccentButtonStyle}">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=SearchSelectedItems.Count, Mode=OneWay}" Value="0">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </telerik:RadButton.Style>
                            <StackPanel Orientation="Horizontal">
                                <telerik:RadGlyph Glyph="{StaticResource GlyphZoom}"/>
                                <TextBlock Text="검색" Margin="5 0 0 0"/>
                            </StackPanel>
                        </telerik:RadButton>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Height="44" Margin="0 0 3 0">
                <telerik:RadButton Margin="10 0" Height="44" Click="AllExportRadButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="전체 출력 ( "/>
                        <telerik:RadGlyph Glyph="{StaticResource GlyphAlignBottomElements}"/>
                        <telerik:RadGlyph Glyph="{StaticResource GlyphCrosstab}" Margin="3 0 0 0"/>
                        <TextBlock Text=" )"/>
                    </StackPanel>
                </telerik:RadButton>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="0 -20 3 0" Padding="0 30 0 0">
            <StackPanel MaxWidth="{StaticResource ContentMaxWidth}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Margin" Value="30 0 30 40"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=ComputedVerticalScrollBarVisibility, ElementName=ContentScrollViewer}" Value="Visible">
                                <Setter Property="Margin" Value="30 0 16 40"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!--연도별 자료수-->
                <StackPanel Margin="0 10">
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 10" Height="{StaticResource DefaultHeight}">
                        <icon:PackIconMaterial Kind="Rhombus" Style="{StaticResource RhombusSplitIconStyle}"/>
                        <TextBlock Text="연도별 자료" Style="{StaticResource SubTitleTextBlcokStyle}" Margin="0 0 10 0"/>
                    </StackPanel>
                    <Border Style="{StaticResource ContentBoxStyle}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!--범례-->
                            <Grid Grid.Column="0" Grid.Row="0" Margin="0 0 0 10">
                                <telerik:RadLegend Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Items="{Binding LegendItems, ElementName=YearChart}">
                                    <telerik:RadLegend.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBlock Text="{Binding Title}" Margin="15 0 0 0" Style="{StaticResource PrimaryTitleTextBlcokStyle}"/>
                                                <Path Width="12" Height="12" Fill="{Binding MarkerFill}" HorizontalAlignment="Left">
                                                    <Path.Data>
                                                        <Binding Path="ActualMarkerGeometry" RelativeSource="{RelativeSource AncestorType=telerik:LegendItemControl}"/>
                                                    </Path.Data>
                                                </Path>
                                            </Grid>
                                        </DataTemplate>
                                    </telerik:RadLegend.ItemTemplate>
                                </telerik:RadLegend>
                            </Grid>
                        
                            <!--그래프-->
                            <telerik:RadCartesianChart x:Name="YearChart" Grid.Row="1" Palette="Fluent" HoverMode="FadeOtherSeries" Height="465" Background="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}">
                                <telerik:RadCartesianChart.Behaviors>
                                    <telerik:ChartSelectionBehavior DataPointSelectionMode="Single"/>
                                    <telerik:ChartTooltipBehavior Placement="Right" HorizontalOffset="5" VerticalOffset="0" ShowDuration="30000" InitialShowDelay="0" BetweenShowDelay="0"/>
                                </telerik:RadCartesianChart.Behaviors>
                                <telerik:RadCartesianChart.TooltipTemplate>
                                    <DataTemplate>
                                        <Border Background="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}" 
                                                BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"
                                                BorderThickness="1"
                                                Padding="10"
                                                Opacity="0.8"
                                                CornerRadius="{telerik:Windows11Resource ResourceKey=CornerRadius}"
                                                TextElement.Foreground="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="5"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="5"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.ColumnSpan="3" Text="{Binding Category, StringFormat={}{0}년}" FontSize="14" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="0" Grid.Row="4" Text="자료 수" FontSize="14"/>
                                                <TextBlock Grid.Column="1" Grid.Row="4" Text=":" FontSize="14" Margin="0 0 3 0"/>
                                                <TextBlock Grid.Column="2" Grid.Row="4" Text="{Binding DataItem.YVal1, StringFormat={}{0:N0}}" FontSize="14" FontWeight="Bold"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </telerik:RadCartesianChart.TooltipTemplate>
                                <telerik:RadCartesianChart.HorizontalAxis>
                                    <telerik:CategoricalAxis LabelFormat="{}{0}년" LabelFitMode="MultiLine" FontSize="14">
                                        <telerik:CategoricalAxis.Style>
                                            <Style TargetType="telerik:CategoricalAxis">
                                                <Setter Property="GapLength" Value="0.5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=YearCollection.Count, Mode=OneWay}" Value="1">
                                                        <Setter Property="GapLength" Value="0.95"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=YearCollection.Count, Mode=OneWay}" Value="2">
                                                        <Setter Property="GapLength" Value="0.9"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=YearCollection.Count, Mode=OneWay}" Value="3">
                                                        <Setter Property="GapLength" Value="0.85"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=YearCollection.Count, Mode=OneWay}" Value="4">
                                                        <Setter Property="GapLength" Value="0.8"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=YearCollection.Count, Mode=OneWay}" Value="5">
                                                        <Setter Property="GapLength" Value="0.75"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=YearCollection.Count, Mode=OneWay}" Value="6">
                                                        <Setter Property="GapLength" Value="0.7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=YearCollection.Count, Mode=OneWay}" Value="7">
                                                        <Setter Property="GapLength" Value="0.65"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=YearCollection.Count, Mode=OneWay}" Value="8">
                                                        <Setter Property="GapLength" Value="0.6"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=YearCollection.Count, Mode=OneWay}" Value="9">
                                                        <Setter Property="GapLength" Value="0.55"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </telerik:CategoricalAxis.Style>
                                    </telerik:CategoricalAxis>
                                </telerik:RadCartesianChart.HorizontalAxis>
                                <telerik:RadCartesianChart.VerticalAxis>
                                    <telerik:LinearAxis Minimum="0" LabelFormat="N0" FontSize="14" SmartLabelsMode="SmartStepAndRange"/>
                                </telerik:RadCartesianChart.VerticalAxis>
                                <telerik:RadCartesianChart.Series>
                                    <chartView:BarSeries ItemsSource="{Binding Path=YearCollection}"
                                                         CategoryBinding="XCat"
                                                         ValueBinding="YVal1"
                                                         ShowLabels="True"
                                                         ClipToPlotArea="False"
                                                         ani:ChartAnimationUtilities.CartesianAnimation="RiseWithDelay">
                                        <telerik:BarSeries.LegendSettings>
                                            <telerik:SeriesLegendSettings Title="연도별 자료 수" />
                                        </telerik:BarSeries.LegendSettings>
                                        <telerik:BarSeries.LabelDefinitions>
                                            <telerik:ChartSeriesLabelDefinition HorizontalAlignment="Center" VerticalAlignment="Top">
                                                <telerik:ChartSeriesLabelDefinition.Template>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DataItem.YVal1, StringFormat={}{0:N0}}"
                                                                   Margin="0 0 0 5"
                                                                   FontSize="14" 
                                                                   Foreground="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                                                    </DataTemplate>
                                                </telerik:ChartSeriesLabelDefinition.Template>
                                            </telerik:ChartSeriesLabelDefinition>
                                        </telerik:BarSeries.LabelDefinitions>
                                    </chartView:BarSeries>
                                </telerik:RadCartesianChart.Series>
                                <!--눈금선-->
                                <telerik:RadCartesianChart.Grid>
                                    <telerik:CartesianChartGrid StripLinesVisibility="None" MajorLinesVisibility="Y" Opacity="0.2"/>
                                </telerik:RadCartesianChart.Grid>
                            </telerik:RadCartesianChart>

                            <Grid Grid.Column="2" Grid.Row="0" Height="{StaticResource DefaultHeight}" Margin="0 0 0 10">
                                <TextBlock Text="통계표" Style="{StaticResource PrimaryTitleTextBlcokStyle}"/>
                            </Grid>

                            <!--통계표-->
                            <telerik:RadGridView x:Name="YearDataRadGridView"
                                                 Grid.Column="2"
                                                 Grid.Row="1"
                                                 ItemsSource="{Binding Path=YearCollection}"
                                                 HeaderRowStyle="{StaticResource CustomRadGridViewHeaderRowStyle}"
                                                 BusyIndicatorContentTemplate="{StaticResource ExportBusyGridViewTemplate}"
                                                 BusyIndicatorIsIndeterminate="False"
                                                 FrozenColumnsSplitterVisibility="Collapsed"
                                                 LeftFrozenColumnCount="0"
                                                 RowIndicatorVisibility="Collapsed"
                                                 Height="465"
                                                 IsFilteringAllowed="False"
                                                 IsSynchronizedWithCurrentItem="{x:Null}"
                                                 ElementExportingToDocument="RadGridView_ElementExportingToDocument"
                                                 RowStyle="{StaticResource ActionBackgroundNullRowStyle}">
                                <telerik:RadGridView.Columns>
                                    <telerik:GridViewDataColumn Header="연도" DataMemberBinding="{Binding Path=XCat}" DataFormatString="{}{0}년" MinWidth="80" Width="120" MaxWidth="120" TextWrapping="Wrap" />
                                    <telerik:GridViewDataColumn Header="자료 수" DataMemberBinding="{Binding Path=YVal1}" DataFormatString="N0" MinWidth="80" Width="140" MaxWidth="140" TextWrapping="Wrap" />
                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>
                        </Grid>
                    </Border>
                </StackPanel>

                <!--사업장 대표하천별 종수-->
                <StackPanel Margin="0 10">
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 10" Height="{StaticResource DefaultHeight}">
                        <icon:PackIconMaterial Kind="Rhombus" Style="{StaticResource RhombusSplitIconStyle}"/>
                        <TextBlock Text="사업장 출현종" Style="{StaticResource SubTitleTextBlcokStyle}" Margin="0 0 10 0"/>
                    </StackPanel>

                    <Border Style="{StaticResource ContentBoxStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0 0 0 10" Height="{StaticResource DefaultHeight}">
                                <TextBlock Text="사업장" Style="{StaticResource PrimaryTitleTextBlcokStyle}" Margin="0 0 5 0"/>
                                <TextBlock Style="{StaticResource PrimaryTitleTextBlcokStyle}">
                                    <Run Text="{Binding Path=ProjectTotalWorkplace, StringFormat={}{0:N0}}" Foreground="{telerik:Windows11Resource ResourceKey=ValidationBrush}"/>
                                    <Run Text="건"/>
                                </TextBlock>
                                <TextBlock Text="과업 대표하천" Style="{StaticResource PrimaryTitleTextBlcokStyle}" Margin="10 0 5 0"/>
                                <TextBlock Style="{StaticResource PrimaryTitleTextBlcokStyle}">
                                    <Run Text="{Binding Path=ProjectTotalWorkplaceRiver, StringFormat={}{0:N0}}" Foreground="{telerik:Windows11Resource ResourceKey=ValidationBrush}"/>
                                    <Run Text="건"/>
                                </TextBlock>

                                <telerik:RadButton Content="출현종 자세히 보기" Margin="20 0 0 0" Click="ViewerOpenRadButton_Click"/>
                            </StackPanel>
                            <telerik:RadGridView x:Name="ProjectRadGridView"
                                                 Grid.Row="1"
                                                 ItemsSource="{Binding Path=ProjectDataTable.DefaultView}"
                                                 HeaderRowStyle="{StaticResource CustomRadGridViewHeaderRowStyle}"
                                                 BusyIndicatorContentTemplate="{StaticResource ExportBusyGridViewTemplate}"
                                                 BusyIndicatorIsIndeterminate="False"
                                                 FrozenColumnsSplitterVisibility="Visible"
                                                 LeftFrozenColumnCount="0"
                                                 RowIndicatorVisibility="Collapsed"
                                                 MinHeight="465"
                                                 MaxHeight="880"
                                                 IsFilteringAllowed="False"
                                                 IsSynchronizedWithCurrentItem="{x:Null}"                                                 
                                                 AutoGenerateColumns="True"
                                                 AutoGeneratingColumn="ProjectRadGridView_AutoGeneratingColumn"
                                                 ElementExportingToDocument="RadGridView_ElementExportingToDocument"
                                                 RowStyle="{StaticResource ActionBackgroundNullRowStyle}">
                            </telerik:RadGridView>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0 0 0 10" Height="{StaticResource DefaultHeight}">
                                <TextBlock Text="출현종" Style="{StaticResource PrimaryTitleTextBlcokStyle}" Margin="0 0 10 0"/>
                                <TextBlock Style="{StaticResource PrimaryTitleTextBlcokStyle}">
                                    <Run Text="{Binding Path=ProjectTotalSpecies, Mode=OneWay, StringFormat={}{0:N0}}" Foreground="{telerik:Windows11Resource ResourceKey=ValidationBrush}"/>
                                    <Run Text="종"/>
                                </TextBlock>
                            </StackPanel>
                            <telerik:RadGridView x:Name="ProjectSpeciesRadGridView"
                                                 Grid.Column="2"
                                                 Grid.Row="1"
                                                 ItemsSource="{Binding Path=ProjectSpeciesCollection}"
                                                 HeaderRowStyle="{StaticResource CustomRadGridViewHeaderRowStyle}"
                                                 BusyIndicatorContentTemplate="{StaticResource ExportBusyGridViewTemplate}"
                                                 BusyIndicatorIsIndeterminate="False"
                                                 FrozenColumnsSplitterVisibility="Collapsed"
                                                 LeftFrozenColumnCount="0"
                                                 RowIndicatorVisibility="Collapsed"
                                                 Height="{Binding Path=ActualHeight, ElementName=ProjectRadGridView}"
                                                 IsFilteringAllowed="False"
                                                 IsSynchronizedWithCurrentItem="{x:Null}"
                                                 ElementExportingToDocument="RadGridView_ElementExportingToDocument"
                                                 RowStyle="{StaticResource ActionBackgroundNullRowStyle}">
                                <telerik:RadGridView.Columns>
                                    <telerik:GridViewDataColumn Header="출현종" DataMemberBinding="{Binding}" MinWidth="80" Width="240" MaxWidth="240" TextWrapping="Wrap"/>
                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>
                        </Grid>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <ContentControl x:Name="ProjectSpeciesViewerContentControl" Grid.Row="0" Grid.RowSpan="4"/>
    </Grid>
</UserControl>

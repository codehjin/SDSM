<UserControl x:Class="SDSM_App.Views.UserControls.StatsMammalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:chartView="clr-namespace:Telerik.Windows.Controls.ChartView;assembly=Telerik.Windows.Controls.Chart"
             xmlns:helpers="clr-namespace:Telerik.Windows.Controls.Theming.Helpers;assembly=Telerik.Windows.Controls"
             xmlns:ani="clr-namespace:SDSM_App.Animations"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behavior="clr-namespace:SDSM_App.Behaviors"
             xmlns:converter="clr-namespace:SDSM_App.Converters"
             xmlns:common="clr-namespace:SDSM_App.Commons"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:viewmodel="clr-namespace:SDSM_App.ViewModels"
             d:DataContext="{d:DesignInstance Type={x:Type viewmodel:StatsMammalControlViewModel}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--검색-->
        <Grid Grid.Row="2" Margin="30 10 30 10" MaxWidth="{StaticResource ContentMaxWidth}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" >
                <StackPanel Orientation="Horizontal" Margin="0 0 50 0">
                    <telerik:RadGlyph Glyph="{StaticResource GlyphCheck}"/>
                    <TextBlock Text="{Binding Path=SearchCondition}" Style="{StaticResource SubTitleTextBlcokStyle}" Foreground="{telerik:Windows11Resource ResourceKey=AccentBrush}" Margin="5 0 10 0" FontSize="18"/>
                    <TextBlock Text="(년)" Style="{StaticResource SubTitleTextBlcokStyle}"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource ContentBoxStyle}" Padding="20 10" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Height="{StaticResource DefaultHeight}" HorizontalAlignment="Left">
                        <TextBlock Text="연도 선택" Style="{StaticResource PrimaryTextBlcokStyle}"/>
                        <telerik:RadComboBox ItemsSource="{Binding Path=SearchCollection}"
                                             Margin="10 0"
                                             ItemTemplate="{StaticResource MultiCheckBoxItemTemplate}"
                                             MultipleSelectionBoxTemplate="{StaticResource MultiSelectionBoxTemplate}"
                                             Style="{StaticResource MultiRadComboBoxStyle}">
                            <telerik:RadComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid>
                                        <UniformGrid.Style>
                                            <Style TargetType="UniformGrid">
                                                <Setter Property="Columns" Value="5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadComboBox}}" Value="1">
                                                        <Setter Property="Columns" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadComboBox}}" Value="2">
                                                        <Setter Property="Columns" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadComboBox}}" Value="3">
                                                        <Setter Property="Columns" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadComboBox}}" Value="4">
                                                        <Setter Property="Columns" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </UniformGrid.Style>
                                    </UniformGrid>
                                </ItemsPanelTemplate>
                            </telerik:RadComboBox.ItemsPanel>
                            <i:Interaction.Behaviors>
                                <behavior:RadComboBoxSelectedItemsBehavior SelectedItems="{Binding Path=SearchSelectedItems, Mode=TwoWay}" />
                            </i:Interaction.Behaviors>
                        </telerik:RadComboBox>
                        <telerik:RadButton Padding="20 0" Command="{Binding Path=SearchExecutedCommand}">
                            <telerik:RadButton.Style>
                                <Style TargetType="telerik:RadButton" BasedOn="{StaticResource AccentButtonStyle}">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=SearchSelectedItems.Count, Mode=OneWay}" Value="0">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </telerik:RadButton.Style>
                            <StackPanel Orientation="Horizontal">
                                <telerik:RadGlyph Glyph="{StaticResource GlyphZoom}"/>
                                <TextBlock Text="검색" Margin="5 0 0 0"/>
                            </StackPanel>
                        </telerik:RadButton>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Height="44" Margin="0 0 3 0">
                <TextBlock Text="그래프, 통계표" Style="{StaticResource PrimaryTextBlcokStyle}"/>
                <telerik:RadButton Content="전체 출력" Margin="10 0" Height="44" Click="AllExportRadButton_Click"/>
                <telerik:RadDropDownButton Content="개별 출력" 
                                           Cursor="Hand"
                                           helpers:ThemeHelper.FocusBrush="Transparent"
                                           helpers:ThemeHelper.MouseOverBrush="{telerik:Windows11Resource ResourceKey=FocusBrush}"
                                           helpers:ThemeHelper.CheckedBrush="{telerik:Windows11Resource ResourceKey=FocusBrush}">
                    <telerik:RadDropDownButton.DropDownContent>
                        <StackPanel Margin="10">
                            <ItemsControl ItemsSource="{Binding Path=ExportCollection}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Path=Caption}" VerticalAlignment="Center" />
                                            <CheckBox Grid.Column="1" Content="그래프" Cursor="Hand" IsChecked="{Binding Path=IsCheckedChart}" Margin="0 0 10 0"/>
                                            <CheckBox Grid.Column="2" Content="통계표" Cursor="Hand" IsChecked="{Binding Path=IsCheckedTable}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <telerik:RadButton Content="출력" Margin="0 10 0 0" Click="EachExportRadButton_Click"/>
                        </StackPanel>
                    </telerik:RadDropDownButton.DropDownContent>
                </telerik:RadDropDownButton>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="0 -20 3 0" Padding="0 30 0 0">
            <StackPanel MaxWidth="{StaticResource ContentMaxWidth}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Margin" Value="30 0 30 40"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=ComputedVerticalScrollBarVisibility, ElementName=ContentScrollViewer}" Value="Visible">
                                <Setter Property="Margin" Value="30 0 16 40"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!--사업장 대표하천별 종수-->
                <StackPanel Margin="0 20">
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 10" Height="{StaticResource DefaultHeight}">
                        <icon:PackIconMaterial Kind="Rhombus" Style="{StaticResource RhombusSplitIconStyle}"/>
                        <TextBlock Text="사업장 과업 대표하천별 종" Style="{StaticResource SubTitleTextBlcokStyle}" Margin="0 0 10 0"/>
                    </StackPanel>

                    <Border Style="{StaticResource ContentBoxStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="7*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0 0 0 10" Height="{StaticResource DefaultHeight}">
                                <TextBlock Text="사업장" Style="{StaticResource PrimaryTitleTextBlcokStyle}" Margin="0 0 5 0"/>
                                <TextBlock Style="{StaticResource PrimaryTitleTextBlcokStyle}">
                                    <Run Text="{Binding Path=TotalWorkplace, StringFormat={}{0:N0}}" Foreground="{telerik:Windows11Resource ResourceKey=ValidationBrush}"/>
                                    <Run Text="건"/>
                                </TextBlock>
                                <TextBlock Text="과업 대표하천" Style="{StaticResource PrimaryTitleTextBlcokStyle}" Margin="10 0 5 0"/>
                                <TextBlock Style="{StaticResource PrimaryTitleTextBlcokStyle}">
                                    <Run Text="{Binding Path=TotalWorkplaceRiver, StringFormat={}{0:N0}}" Foreground="{telerik:Windows11Resource ResourceKey=ValidationBrush}"/>
                                    <Run Text="건"/>
                                </TextBlock>
                                <TextBlock Text="포유류" Style="{StaticResource PrimaryTitleTextBlcokStyle}" Margin="10 0 5 0"/>
                                <TextBlock Style="{StaticResource PrimaryTitleTextBlcokStyle}">
                                    <Run Text="{Binding Path=TotalSpecies, StringFormat={}{0:N0}}" Foreground="{telerik:Windows11Resource ResourceKey=ValidationBrush}"/>
                                    <Run Text="종"/>
                                </TextBlock>
                            </StackPanel>
                            <telerik:RadGridView x:Name="ProjectRadGridView"
                                                 Grid.Row="1"
                                                 ItemsSource="{Binding Path=ProjectDataTable.DefaultView}"
                                                 HeaderRowStyle="{StaticResource CustomRadGridViewHeaderRowStyle}"
                                                 BusyIndicatorContentTemplate="{StaticResource ExportBusyGridViewTemplate}"
                                                 BusyIndicatorIsIndeterminate="False"
                                                 FrozenColumnsSplitterVisibility="Collapsed"
                                                 LeftFrozenColumnCount="0"
                                                 RowIndicatorVisibility="Collapsed"
                                                 MinHeight="110"
                                                 MaxHeight="460"
                                                 IsFilteringAllowed="False"
                                                 IsSynchronizedWithCurrentItem="{x:Null}"
                                                 AutoGenerateColumns="True"
                                                 AutoGeneratingColumn="ProjectRadGridView_AutoGeneratingColumn"
                                                 ElementExportingToDocument="RadGridView_ElementExportingToDocument"
                                                 RowStyle="{StaticResource SelectedBackgroundNullRowStyle}">
                            </telerik:RadGridView>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0 0 0 10" Height="{StaticResource DefaultHeight}">
                                <TextBlock Text="출현종" Style="{StaticResource PrimaryTitleTextBlcokStyle}" Margin="0 0 10 0"/>
                                <TextBlock Style="{StaticResource PrimaryTitleTextBlcokStyle}">
                                    <Run Text="{Binding Path=ProjectSpeciesCollection.Count, Mode=OneWay, StringFormat={}{0:N0}}" Foreground="{telerik:Windows11Resource ResourceKey=ValidationBrush}"/>
                                    <Run Text="종"/>
                                </TextBlock>
                            </StackPanel>
                            <telerik:RadGridView x:Name="ProjectSpeciesRadGridView"
                                                 Grid.Column="2"
                                                 Grid.Row="1"
                                                 ItemsSource="{Binding Path=ProjectSpeciesCollection}"
                                                 HeaderRowStyle="{StaticResource CustomRadGridViewHeaderRowStyle}"
                                                 BusyIndicatorContentTemplate="{StaticResource ExportBusyGridViewTemplate}"
                                                 BusyIndicatorIsIndeterminate="False"
                                                 FrozenColumnsSplitterVisibility="Collapsed"
                                                 LeftFrozenColumnCount="0"
                                                 RowIndicatorVisibility="Collapsed"
                                                 MinHeight="110"
                                                 MaxHeight="460"
                                                 IsFilteringAllowed="False"
                                                 IsSynchronizedWithCurrentItem="{x:Null}"
                                                 ElementExportingToDocument="RadGridView_ElementExportingToDocument"
                                                 RowStyle="{StaticResource SelectedBackgroundNullRowStyle}">
                                <telerik:RadGridView.Columns>
                                    <telerik:GridViewDataColumn Header="특징" DataMemberBinding="{Binding}" MinWidth="80" Width="*" MaxWidth="640" TextWrapping="Wrap" />
                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>
                        </Grid>
                    </Border>
                </StackPanel>

                <!--특징-->
                <StackPanel Margin="0 20">
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 10" Height="{StaticResource DefaultHeight}">
                        <icon:PackIconMaterial Kind="Rhombus" Style="{StaticResource RhombusSplitIconStyle}"/>
                        <TextBlock Text="특징" Style="{StaticResource SubTitleTextBlcokStyle}" Margin="0 0 10 0"/>
                    </StackPanel>

                    <Border Style="{StaticResource ContentBoxStyle}">
                        <Grid Margin="0 20 0 0" Visibility="{Binding Path=IsChecked, ElementName=FeatureCheckBox, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <telerik:RadPieChart x:Name="FeatureChart" Grid.Column="0" Grid.Row="1" Palette="Office2016" HoverMode="FadeOtherItems" Height="460" Background="{telerik:Windows11Resource ResourceKey=OverlayBrush}">
                                <telerik:RadPieChart.Behaviors>
                                    <telerik:ChartSelectionBehavior/>
                                    <telerik:ChartTooltipBehavior ShowDuration="30000" InitialShowDelay="0" BetweenShowDelay="0"/>
                                </telerik:RadPieChart.Behaviors>
                                <telerik:RadPieChart.TooltipTemplate>
                                    <DataTemplate>
                                        <Border Background="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}" 
                                                BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"
                                                BorderThickness="1"
                                                Padding="10"
                                                Opacity="0.9"
                                                CornerRadius="{telerik:Windows11Resource ResourceKey=CornerRadius}"
                                                TextElement.Foreground="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="5"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="5"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.ColumnSpan="3" Text="{Binding DataItem.XCatText}" FontSize="14" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="0" Grid.Row="2" Text="비율(%)" FontSize="14"/>
                                                <TextBlock Grid.Column="1" Grid.Row="2" Text=":" FontSize="14" Margin="0 0 3 0"/>
                                                <TextBlock Grid.Column="2" Grid.Row="2" Text="{Binding DataItem.YRatio1, StringFormat={}{0:F2}}" FontSize="14" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="0" Grid.Row="4" Text="개수" FontSize="14"/>
                                                <TextBlock Grid.Column="1" Grid.Row="4" Text=":" FontSize="14" Margin="0 0 3 0"/>
                                                <TextBlock Grid.Column="2" Grid.Row="4" Text="{Binding DataItem.YVal1, StringFormat={}{0:N0}}" FontSize="14" FontWeight="Bold"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </telerik:RadPieChart.TooltipTemplate>
                                <telerik:RadPieChart.SmartLabelsStrategy>
                                    <telerik:PieChartSmartLabelsStrategy DisplayMode="SpiderUnaligned"/>
                                </telerik:RadPieChart.SmartLabelsStrategy>

                                <telerik:RadPieChart.Series>
                                    <telerik:PieSeries ItemsSource="{Binding Path=FeatureCollection}" 
                                                       ValueBinding="YVal1" 
                                                       RadiusFactor="0.7" 
                                                       ClipToPlotArea="False"
                                                       ani:ChartAnimationUtilities.PieAnimation="Slice">
                                        <telerik:PieSeries.LegendSettings>
                                            <telerik:DataPointLegendSettings TitleBinding="XCatText"/>
                                        </telerik:PieSeries.LegendSettings>
                                        <telerik:PieSeries.AngleRange>
                                            <telerik:AngleRange StartAngle="-90" />
                                        </telerik:PieSeries.AngleRange>
                                        <telerik:PieSeries.LabelDefinitions>
                                            <telerik:ChartSeriesLabelDefinition>
                                                <telerik:ChartSeriesLabelDefinition.DefaultVisualStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="14"/>
                                                        <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                                                    </Style>
                                                </telerik:ChartSeriesLabelDefinition.DefaultVisualStyle>
                                                <telerik:ChartSeriesLabelDefinition.Template>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <StackPanel.Resources>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontSize" Value="14"/>
                                                                    <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                                                                </Style>
                                                            </StackPanel.Resources>
                                                            <TextBlock Text="{Binding Path=DataItem.XCatText}"/>
                                                            <TextBlock Text=", "/>
                                                            <TextBlock Text="{Binding Path=DataItem.YRatio1, StringFormat={}{0:F2}%}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </telerik:ChartSeriesLabelDefinition.Template>
                                            </telerik:ChartSeriesLabelDefinition>
                                        </telerik:PieSeries.LabelDefinitions>
                                        <telerik:PieSeries.LabelConnectorsSettings>
                                            <telerik:ChartSeriesLabelConnectorsSettings />
                                        </telerik:PieSeries.LabelConnectorsSettings>
                                    </telerik:PieSeries>
                                </telerik:RadPieChart.Series>
                            </telerik:RadPieChart>

                            <Grid Grid.Column="2" Grid.Row="0" Height="{StaticResource DefaultHeight}" Margin="0 0 0 10">
                                <TextBlock Text="통계표" Style="{StaticResource PrimaryTitleTextBlcokStyle}"/>
                            </Grid>

                            <!--통계표-->
                            <telerik:RadGridView x:Name="FeatureRadGridView"
                                                 Grid.Column="2"
                                                 Grid.Row="1"
                                                 ItemsSource="{Binding Path=FeatureCollection}"
                                                 HeaderRowStyle="{StaticResource CustomRadGridViewHeaderRowStyle}"
                                                 BusyIndicatorContentTemplate="{StaticResource ExportBusyGridViewTemplate}"
                                                 BusyIndicatorIsIndeterminate="False"
                                                 FrozenColumnsSplitterVisibility="Collapsed"
                                                 LeftFrozenColumnCount="0"
                                                 RowIndicatorVisibility="Collapsed"
                                                 Height="460"
                                                 IsFilteringAllowed="False"
                                                 IsSynchronizedWithCurrentItem="{x:Null}"
                                                 ElementExportingToDocument="RadGridView_ElementExportingToDocument"
                                                 RowStyle="{StaticResource SelectedBackgroundNullRowStyle}">
                                <telerik:RadGridView.Columns>
                                    <telerik:GridViewDataColumn Header="특징" DataMemberBinding="{Binding Path=XCatText}" MinWidth="80" Width="2*" TextWrapping="Wrap"/>
                                    <telerik:GridViewDataColumn Header="비율(%)" DataMemberBinding="{Binding Path=YRatio1}" DataFormatString="{}{0:F2}" MinWidth="80" Width="*" TextWrapping="Wrap" />
                                    <telerik:GridViewDataColumn Header="개수" DataMemberBinding="{Binding Path=YVal1}" DataFormatString="N0" MinWidth="80" Width="*" TextWrapping="Wrap"/>
                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>

                            <Grid Grid.Column="4" Grid.Row="0" Height="{StaticResource DefaultHeight}" Margin="0 0 0 10">
                                <TextBlock Text="출현종" Style="{StaticResource PrimaryTitleTextBlcokStyle}"/>
                            </Grid>
                        
                            <!--출현종-->
                            <telerik:RadGridView x:Name="FeatureSpeciesRadGridView"
                                                 Grid.Column="4"
                                                 Grid.Row="1"
                                                 ItemsSource="{Binding Path=FeatureSpeciesCollection}"
                                                 HeaderRowStyle="{StaticResource CustomRadGridViewHeaderRowStyle}"
                                                 BusyIndicatorContentTemplate="{StaticResource ExportBusyGridViewTemplate}"
                                                 BusyIndicatorIsIndeterminate="False"
                                                 FrozenColumnsSplitterVisibility="Collapsed"
                                                 LeftFrozenColumnCount="0"
                                                 RowIndicatorVisibility="Collapsed"
                                                 Height="460"
                                                 IsFilteringAllowed="False"
                                                 IsSynchronizedWithCurrentItem="{x:Null}"
                                                 ElementExportingToDocument="RadGridView_ElementExportingToDocument"
                                                 RowStyle="{StaticResource SelectedBackgroundNullRowStyle}">
                                <telerik:RadGridView.Columns>
                                    <telerik:GridViewDataColumn Header="특징" DataMemberBinding="{Binding Path=Category}" MinWidth="80" Width="2*" TextWrapping="Wrap" />
                                    <telerik:GridViewDataColumn Header="비율(%)" DataMemberBinding="{Binding Path=SubCategory}" DataFormatString="{}{0:F2}" MinWidth="80" Width="*" TextWrapping="Wrap" />
                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>
                        </Grid>
                    </Border>
                    </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>

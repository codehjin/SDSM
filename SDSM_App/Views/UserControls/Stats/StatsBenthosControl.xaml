<UserControl x:Class="SDSM_App.Views.UserControls.StatsBenthosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:chartView="clr-namespace:Telerik.Windows.Controls.ChartView;assembly=Telerik.Windows.Controls.Chart"
             xmlns:helpers="clr-namespace:Telerik.Windows.Controls.Theming.Helpers;assembly=Telerik.Windows.Controls"
             xmlns:ani="clr-namespace:SDSM_App.Animations"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behavior="clr-namespace:SDSM_App.Behaviors"
             xmlns:converter="clr-namespace:SDSM_App.Converters"
             xmlns:common="clr-namespace:SDSM_App.Commons"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:viewmodel="clr-namespace:SDSM_App.ViewModels"
             d:DataContext="{d:DesignInstance Type={x:Type viewmodel:StatsBenthosControlViewModel}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--검색-->
        <Grid Grid.Row="2" Margin="30 10 30 10" MaxWidth="{StaticResource ContentMaxWidth}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" >
                <StackPanel Orientation="Horizontal" Margin="0 0 50 0">
                    <telerik:RadGlyph Glyph="{StaticResource GlyphCheck}"/>
                    <TextBlock Text="{Binding Path=SearchCondition}" Style="{StaticResource SubTitleTextBlcokStyle}" Foreground="{telerik:Windows11Resource ResourceKey=AccentBrush}" Margin="5 0 10 0" FontSize="18"/>
                    <TextBlock Text="(년)" Style="{StaticResource SubTitleTextBlcokStyle}"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource ContentBoxStyle}" Padding="20 10" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Height="{StaticResource DefaultHeight}" HorizontalAlignment="Left">
                        <TextBlock Text="연도 선택" Style="{StaticResource PrimaryTextBlcokStyle}"/>
                        <telerik:RadComboBox ItemsSource="{Binding Path=SearchCollection}"
                                             Margin="10 0"
                                             ItemTemplate="{StaticResource MultiCheckBoxItemTemplate}"
                                             MultipleSelectionBoxTemplate="{StaticResource MultiSelectionBoxTemplate}"
                                             Style="{StaticResource MultiRadComboBoxStyle}">
                            <telerik:RadComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid>
                                        <UniformGrid.Style>
                                            <Style TargetType="UniformGrid">
                                                <Setter Property="Columns" Value="5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadComboBox}}" Value="1">
                                                        <Setter Property="Columns" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadComboBox}}" Value="2">
                                                        <Setter Property="Columns" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadComboBox}}" Value="3">
                                                        <Setter Property="Columns" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=Items.Count, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadComboBox}}" Value="4">
                                                        <Setter Property="Columns" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </UniformGrid.Style>
                                    </UniformGrid>
                                </ItemsPanelTemplate>
                            </telerik:RadComboBox.ItemsPanel>
                            <i:Interaction.Behaviors>
                                <behavior:RadComboBoxSelectedItemsBehavior SelectedItems="{Binding Path=SearchSelectedItems, Mode=TwoWay}" />
                            </i:Interaction.Behaviors>
                        </telerik:RadComboBox>
                        <telerik:RadButton Padding="20 0" Command="{Binding Path=SearchExecutedCommand}">
                            <telerik:RadButton.Style>
                                <Style TargetType="telerik:RadButton" BasedOn="{StaticResource AccentButtonStyle}">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=SearchSelectedItems.Count, Mode=OneWay}" Value="0">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </telerik:RadButton.Style>
                            <StackPanel Orientation="Horizontal">
                                <telerik:RadGlyph Glyph="{StaticResource GlyphZoom}"/>
                                <TextBlock Text="검색" Margin="5 0 0 0"/>
                            </StackPanel>
                        </telerik:RadButton>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Height="44" Margin="0 0 3 0">
                <TextBlock Text="그래프, 통계표" Style="{StaticResource PrimaryTextBlcokStyle}"/>
                <telerik:RadButton Content="전체 출력" Margin="10 0" Height="44" Click="AllExportRadButton_Click"/>
                <telerik:RadDropDownButton Content="개별 출력" 
                                           Cursor="Hand"
                                           helpers:ThemeHelper.FocusBrush="Transparent"
                                           helpers:ThemeHelper.MouseOverBrush="{telerik:Windows11Resource ResourceKey=FocusBrush}"
                                           helpers:ThemeHelper.CheckedBrush="{telerik:Windows11Resource ResourceKey=FocusBrush}">
                    <telerik:RadDropDownButton.DropDownContent>
                        <StackPanel Margin="10">
                            <ItemsControl ItemsSource="{Binding Path=ExportCollection}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Path=Caption}" VerticalAlignment="Center" />
                                            <CheckBox Grid.Column="1" Content="그래프" Cursor="Hand" IsChecked="{Binding Path=IsCheckedChart}" Margin="0 0 10 0"/>
                                            <CheckBox Grid.Column="2" Content="통계표" Cursor="Hand" IsChecked="{Binding Path=IsCheckedTable}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <telerik:RadButton Content="출력" Margin="0 10 0 0" Click="EachExportRadButton_Click"/>
                        </StackPanel>
                    </telerik:RadDropDownButton.DropDownContent>
                </telerik:RadDropDownButton>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="0 -20 3 0" Padding="0 30 0 0">
            <StackPanel MaxWidth="{StaticResource ContentMaxWidth}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Margin" Value="30 0 30 40"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=ComputedVerticalScrollBarVisibility, ElementName=ContentScrollViewer}" Value="Visible">
                                <Setter Property="Margin" Value="30 0 16 40"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!--연도별 자료수-->
                <Border Style="{StaticResource ContentBoxStyle}" Margin="0 0 0 10">
                    <StackPanel>
                        <CheckBox x:Name="YearCheckBox" IsChecked="True" Style="{StaticResource UpDownVisibleCheckBoxStyle}">
                            <TextBlock Text="연도별 자료" Style="{StaticResource SubTitleTextBlcokStyle}"/>
                        </CheckBox>
                        <Grid Margin="0 20 0 0" Visibility="{Binding Path=IsChecked, ElementName=YearCheckBox, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3.5*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!--범례-->
                            <Grid Grid.Column="0" Grid.Row="0" Margin="0 0 0 10">
                                <telerik:RadLegend Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Items="{Binding LegendItems, ElementName=YearChart}">
                                    <telerik:RadLegend.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBlock Text="{Binding Title}" Margin="15 0 0 0"/>
                                                <Path Width="12" Height="12" Fill="{Binding MarkerFill}" HorizontalAlignment="Left">
                                                    <Path.Data>
                                                        <Binding Path="ActualMarkerGeometry" RelativeSource="{RelativeSource AncestorType=telerik:LegendItemControl}"/>
                                                    </Path.Data>
                                                </Path>
                                            </Grid>
                                        </DataTemplate>
                                    </telerik:RadLegend.ItemTemplate>
                                </telerik:RadLegend>
                            </Grid>

                            <!--그래프-->
                            <telerik:RadCartesianChart x:Name="YearChart" Grid.Column="0" Grid.Row="1" Palette="Fluent" HoverMode="FadeOtherSeries" Height="460" Background="{telerik:Windows11Resource ResourceKey=OverlayBrush}">
                                <telerik:RadCartesianChart.Behaviors>
                                    <telerik:ChartSelectionBehavior DataPointSelectionMode="Single"/>
                                    <telerik:ChartTooltipBehavior Placement="Right" HorizontalOffset="5" VerticalOffset="0" ShowDuration="30000" InitialShowDelay="0" BetweenShowDelay="0"/>
                                </telerik:RadCartesianChart.Behaviors>
                                <telerik:RadCartesianChart.TooltipTemplate>
                                    <DataTemplate>
                                        <Border Background="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}" 
                                                BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"
                                                BorderThickness="1"
                                                Padding="10"
                                                Opacity="0.8"
                                                CornerRadius="{telerik:Windows11Resource ResourceKey=CornerRadius}"
                                                TextElement.Foreground="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="5"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="5"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.ColumnSpan="3" Text="{Binding Category, StringFormat={}{0}년}" FontSize="14" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="0" Grid.Row="4" Text="자료 수" FontSize="14"/>
                                                <TextBlock Grid.Column="1" Grid.Row="4" Text=":" FontSize="14" Margin="0 0 3 0"/>
                                                <TextBlock Grid.Column="2" Grid.Row="4" Text="{Binding DataItem.YVal1, StringFormat={}{0:N0}}" FontSize="14" FontWeight="Bold"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </telerik:RadCartesianChart.TooltipTemplate>
                                <telerik:RadCartesianChart.HorizontalAxis>
                                    <telerik:CategoricalAxis LabelFormat="{}{0}년" LabelFitMode="MultiLine" FontSize="14">
                                        <telerik:CategoricalAxis.Style>
                                            <Style TargetType="telerik:CategoricalAxis">
                                                <Setter Property="GapLength" Value="0.5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=YearCollection.Count, Mode=OneWay}" Value="1">
                                                        <Setter Property="GapLength" Value="0.95"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=YearCollection.Count, Mode=OneWay}" Value="2">
                                                        <Setter Property="GapLength" Value="0.9"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=YearCollection.Count, Mode=OneWay}" Value="3">
                                                        <Setter Property="GapLength" Value="0.85"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=YearCollection.Count, Mode=OneWay}" Value="4">
                                                        <Setter Property="GapLength" Value="0.8"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=YearCollection.Count, Mode=OneWay}" Value="5">
                                                        <Setter Property="GapLength" Value="0.75"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=YearCollection.Count, Mode=OneWay}" Value="6">
                                                        <Setter Property="GapLength" Value="0.7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=YearCollection.Count, Mode=OneWay}" Value="7">
                                                        <Setter Property="GapLength" Value="0.65"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=YearCollection.Count, Mode=OneWay}" Value="8">
                                                        <Setter Property="GapLength" Value="0.6"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=YearCollection.Count, Mode=OneWay}" Value="9">
                                                        <Setter Property="GapLength" Value="0.55"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </telerik:CategoricalAxis.Style>
                                    </telerik:CategoricalAxis>
                                </telerik:RadCartesianChart.HorizontalAxis>
                                <telerik:RadCartesianChart.VerticalAxis>
                                    <telerik:LinearAxis Minimum="0" LabelFormat="N0" FontSize="14" SmartLabelsMode="SmartStepAndRange"/>
                                </telerik:RadCartesianChart.VerticalAxis>
                                <telerik:RadCartesianChart.Series>
                                    <chartView:BarSeries ItemsSource="{Binding Path=YearCollection}"
                                                         CategoryBinding="XCat"
                                                         ValueBinding="YVal1"
                                                         ShowLabels="True"
                                                         ClipToPlotArea="False"
                                                         ani:ChartAnimationUtilities.CartesianAnimation="RiseWithDelay">
                                        <telerik:BarSeries.LegendSettings>
                                            <telerik:SeriesLegendSettings Title="연도별 자료 수" />
                                        </telerik:BarSeries.LegendSettings>
                                        <telerik:BarSeries.LabelDefinitions>
                                            <telerik:ChartSeriesLabelDefinition HorizontalAlignment="Center" VerticalAlignment="Top">
                                                <telerik:ChartSeriesLabelDefinition.Template>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DataItem.YVal1, StringFormat={}{0:N0}}"
                                                               Margin="0 0 0 5"
                                                               FontSize="14" 
                                                               Foreground="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                                                    </DataTemplate>
                                                </telerik:ChartSeriesLabelDefinition.Template>
                                            </telerik:ChartSeriesLabelDefinition>
                                        </telerik:BarSeries.LabelDefinitions>
                                    </chartView:BarSeries>
                                </telerik:RadCartesianChart.Series>
                                <!--눈금선-->
                                <telerik:RadCartesianChart.Grid>
                                    <telerik:CartesianChartGrid StripLinesVisibility="None" MajorLinesVisibility="Y" Opacity="0.2"/>
                                </telerik:RadCartesianChart.Grid>
                            </telerik:RadCartesianChart>

                            <Grid Grid.Column="2" Grid.Row="0" Margin="0 0 0 10">
                                <TextBlock Text="통계표" Style="{StaticResource PrimaryTextBlcokStyle}"/>
                            </Grid>

                            <!--통계표-->
                            <telerik:RadGridView x:Name="YearDataRadGridView"
                                                 Grid.Column="2"
                                                 Grid.Row="1"
                                                 ItemsSource="{Binding Path=YearCollection}"
                                                 HeaderRowStyle="{StaticResource CustomRadGridViewHeaderRowStyle}"
                                                 BusyIndicatorContentTemplate="{StaticResource ExportBusyGridViewTemplate}"
                                                 BusyIndicatorIsIndeterminate="False"
                                                 FrozenColumnsSplitterVisibility="Collapsed"
                                                 LeftFrozenColumnCount="0"
                                                 RowIndicatorVisibility="Collapsed"
                                                 ShowColumnFooters="True"
                                                 Height="460"
                                                 IsFilteringAllowed="False"
                                                 IsSynchronizedWithCurrentItem="{x:Null}"
                                                 ElementExportingToDocument="RadGridView_ElementExportingToDocument">
                                <telerik:RadGridView.Columns>
                                    <telerik:GridViewDataColumn Header="연도" DataMemberBinding="{Binding Path=XCat}" DataFormatString="{}{0}년" MinWidth="80" Width="*" TextWrapping="Wrap" FooterTextAlignment="Center">
                                        <telerik:GridViewDataColumn.AggregateFunctions>
                                            <telerik:CountFunction ResultFormatString="{}{0:N0}건"/>
                                        </telerik:GridViewDataColumn.AggregateFunctions>
                                    </telerik:GridViewDataColumn>
                                    <telerik:GridViewDataColumn Header="자료 수" DataMemberBinding="{Binding Path=YVal1}" DataFormatString="N0" MinWidth="80" Width="*" TextWrapping="Wrap" FooterTextAlignment="Center">
                                        <telerik:GridViewDataColumn.AggregateFunctions>
                                            <telerik:SumFunction ResultFormatString="{}{0:N0}건"/>
                                        </telerik:GridViewDataColumn.AggregateFunctions>
                                    </telerik:GridViewDataColumn>
                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--출현종-->
                <Border Style="{StaticResource ContentBoxStyle}" Margin="0 10">
                    <StackPanel>
                        <CheckBox x:Name="SpeciesCheckBox" IsChecked="True" Style="{StaticResource UpDownVisibleCheckBoxStyle}">
                            <TextBlock Text="출현종" Style="{StaticResource SubTitleTextBlcokStyle}"/>
                        </CheckBox>

                        <Grid Margin="0 20 0 0" Visibility="{Binding Path=IsChecked, ElementName=SpeciesCheckBox, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3.5*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!--범례-->
                            <Grid Grid.Column="0" Grid.Row="0" Margin="0 0 0 10">
                                <telerik:RadLegend Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Items="{Binding LegendItems, ElementName=SpeciesChart}">
                                    <telerik:RadLegend.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBlock Text="{Binding Title}" Margin="15 0 0 0"/>
                                                <Path Width="12" Height="12" Fill="{Binding MarkerFill}" HorizontalAlignment="Left">
                                                    <Path.Data>
                                                        <Binding Path="ActualMarkerGeometry" RelativeSource="{RelativeSource AncestorType=telerik:LegendItemControl}"/>
                                                    </Path.Data>
                                                </Path>
                                            </Grid>
                                        </DataTemplate>
                                    </telerik:RadLegend.ItemTemplate>
                                </telerik:RadLegend>
                            </Grid>

                            <!--그래프-->
                            <telerik:RadCartesianChart x:Name="SpeciesChart" Grid.Column="0" Grid.Row="1" Palette="Forest" HoverMode="FadeOtherSeries" Height="460" Background="{telerik:Windows11Resource ResourceKey=OverlayBrush}">
                                <telerik:RadCartesianChart.Behaviors>
                                    <telerik:ChartSelectionBehavior DataPointSelectionMode="Single"/>
                                    <telerik:ChartTooltipBehavior Placement="Right" HorizontalOffset="5" VerticalOffset="0" ShowDuration="30000" InitialShowDelay="0" BetweenShowDelay="0"/>
                                </telerik:RadCartesianChart.Behaviors>
                                <telerik:RadCartesianChart.TooltipTemplate>
                                    <DataTemplate>
                                        <Border Background="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}" 
                                                BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"
                                                BorderThickness="1"
                                                Padding="10"
                                                Opacity="0.8"
                                                CornerRadius="{telerik:Windows11Resource ResourceKey=CornerRadius}"
                                                TextElement.Foreground="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="5"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="5"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="5"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="5"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="5"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.ColumnSpan="3" Text="{Binding DataItem.XCatText}" FontSize="14" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="0" Grid.Row="2" Text="문" FontSize="14"/>
                                                <TextBlock Grid.Column="1" Grid.Row="2" Text=":" FontSize="14" Margin="0 0 3 0"/>
                                                <TextBlock Grid.Column="2" Grid.Row="2" Text="{Binding DataItem.YVal1, StringFormat={}{0:N0}}" FontSize="14" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="0" Grid.Row="4" Text="강" FontSize="14"/>
                                                <TextBlock Grid.Column="1" Grid.Row="4" Text=":" FontSize="14" Margin="0 0 3 0"/>
                                                <TextBlock Grid.Column="2" Grid.Row="4" Text="{Binding DataItem.YVal2, StringFormat={}{0:N0}}" FontSize="14" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="0" Grid.Row="6" Text="목" FontSize="14"/>
                                                <TextBlock Grid.Column="1" Grid.Row="6" Text=":" FontSize="14" Margin="0 0 3 0"/>
                                                <TextBlock Grid.Column="2" Grid.Row="6" Text="{Binding DataItem.YVal3, StringFormat={}{0:N0}}" FontSize="14" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="0" Grid.Row="8" Text="과" FontSize="14"/>
                                                <TextBlock Grid.Column="1" Grid.Row="8" Text=":" FontSize="14" Margin="0 0 3 0"/>
                                                <TextBlock Grid.Column="2" Grid.Row="8" Text="{Binding DataItem.YVal4, StringFormat={}{0:N0}}" FontSize="14" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="0" Grid.Row="10" Text="종" FontSize="14"/>
                                                <TextBlock Grid.Column="1" Grid.Row="10" Text=":" FontSize="14" Margin="0 0 3 0"/>
                                                <TextBlock Grid.Column="2" Grid.Row="10" Text="{Binding DataItem.YVal5, StringFormat={}{0:N0}}" FontSize="14" FontWeight="Bold"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </telerik:RadCartesianChart.TooltipTemplate>
                                <telerik:RadCartesianChart.HorizontalAxis>
                                    <telerik:CategoricalAxis LabelFitMode="MultiLine" FontSize="14">
                                        <telerik:CategoricalAxis.Style>
                                            <Style TargetType="telerik:CategoricalAxis">
                                                <Setter Property="GapLength" Value="0.5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=SpeciesCollection.Count, Mode=OneWay}" Value="1">
                                                        <Setter Property="GapLength" Value="0.95"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=SpeciesCollection.Count, Mode=OneWay}" Value="2">
                                                        <Setter Property="GapLength" Value="0.9"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=SpeciesCollection.Count, Mode=OneWay}" Value="3">
                                                        <Setter Property="GapLength" Value="0.85"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=SpeciesCollection.Count, Mode=OneWay}" Value="4">
                                                        <Setter Property="GapLength" Value="0.8"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=SpeciesCollection.Count, Mode=OneWay}" Value="5">
                                                        <Setter Property="GapLength" Value="0.75"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=SpeciesCollection.Count, Mode=OneWay}" Value="6">
                                                        <Setter Property="GapLength" Value="0.7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=v.Count, Mode=OneWay}" Value="7">
                                                        <Setter Property="GapLength" Value="0.65"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=SpeciesCollection.Count, Mode=OneWay}" Value="8">
                                                        <Setter Property="GapLength" Value="0.6"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=SpeciesCollection.Count, Mode=OneWay}" Value="9">
                                                        <Setter Property="GapLength" Value="0.55"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </telerik:CategoricalAxis.Style>
                                    </telerik:CategoricalAxis>
                                </telerik:RadCartesianChart.HorizontalAxis>
                                <telerik:RadCartesianChart.VerticalAxis>
                                    <telerik:LinearAxis Minimum="0" LabelFormat="N0" FontSize="14" SmartLabelsMode="SmartStepAndRange"/>
                                </telerik:RadCartesianChart.VerticalAxis>
                                <telerik:RadCartesianChart.Series>
                                    <chartView:BarSeries ItemsSource="{Binding Path=SpeciesCollection}"
                                                         CategoryBinding="XCatText"
                                                         ValueBinding="YVal5"
                                                         ShowLabels="True"
                                                         ClipToPlotArea="False"
                                                         ani:ChartAnimationUtilities.CartesianAnimation="RiseWithDelay">
                                        <telerik:BarSeries.LegendSettings>
                                            <telerik:SeriesLegendSettings Title="연도별 종수" />
                                        </telerik:BarSeries.LegendSettings>
                                        <telerik:BarSeries.LabelDefinitions>
                                            <telerik:ChartSeriesLabelDefinition HorizontalAlignment="Center" VerticalAlignment="Top">
                                                <telerik:ChartSeriesLabelDefinition.Template>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DataItem.YVal5, StringFormat={}{0:N0}}"
                                                                   Margin="0 0 0 5"
                                                                   FontSize="14" 
                                                                   Foreground="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                                                    </DataTemplate>
                                                </telerik:ChartSeriesLabelDefinition.Template>
                                            </telerik:ChartSeriesLabelDefinition>
                                        </telerik:BarSeries.LabelDefinitions>
                                    </chartView:BarSeries>
                                </telerik:RadCartesianChart.Series>
                                <!--눈금선-->
                                <telerik:RadCartesianChart.Grid>
                                    <telerik:CartesianChartGrid StripLinesVisibility="None" MajorLinesVisibility="Y" Opacity="0.2"/>
                                </telerik:RadCartesianChart.Grid>
                            </telerik:RadCartesianChart>

                            <Grid Grid.Column="2" Grid.Row="0" Margin="0 0 0 10">
                                <TextBlock Text="통계표" Style="{StaticResource PrimaryTextBlcokStyle}"/>
                            </Grid>

                            <!--통계표-->
                            <telerik:RadGridView x:Name="SpeciesDataRadGridView"
                                                 Grid.Column="2"
                                                 Grid.Row="1"
                                                 ItemsSource="{Binding Path=SpeciesCollection}"
                                                 HeaderRowStyle="{StaticResource CustomRadGridViewHeaderRowStyle}"
                                                 BusyIndicatorContentTemplate="{StaticResource ExportBusyGridViewTemplate}"
                                                 BusyIndicatorIsIndeterminate="False"
                                                 FrozenColumnsSplitterVisibility="Collapsed"
                                                 LeftFrozenColumnCount="0"
                                                 RowIndicatorVisibility="Collapsed"
                                                 ShowColumnFooters="True"
                                                 Height="460"
                                                 IsFilteringAllowed="False"
                                                 IsSynchronizedWithCurrentItem="{x:Null}"
                                                 ElementExportingToDocument="RadGridView_ElementExportingToDocument">
                                <telerik:RadGridView.Columns>
                                    <telerik:GridViewDataColumn Header="연도" DataMemberBinding="{Binding Path=XCatText}" MinWidth="80" Width="*" TextWrapping="Wrap" FooterTextAlignment="Center">
                                        <telerik:GridViewDataColumn.AggregateFunctions>
                                            <telerik:CountFunction ResultFormatString="{}{0:N0}건"/>
                                        </telerik:GridViewDataColumn.AggregateFunctions>
                                    </telerik:GridViewDataColumn>
                                    <telerik:GridViewDataColumn Header="문" DataMemberBinding="{Binding Path=YVal1}" DataFormatString="N0" MinWidth="60" Width="*" TextWrapping="Wrap" FooterTextAlignment="Center"/>
                                    <telerik:GridViewDataColumn Header="강" DataMemberBinding="{Binding Path=YVal2}" DataFormatString="N0" MinWidth="60" Width="*" TextWrapping="Wrap" FooterTextAlignment="Center"/>
                                    <telerik:GridViewDataColumn Header="목" DataMemberBinding="{Binding Path=YVal3}" DataFormatString="N0" MinWidth="60" Width="*" TextWrapping="Wrap" FooterTextAlignment="Center"/>
                                    <telerik:GridViewDataColumn Header="과" DataMemberBinding="{Binding Path=YVal4}" DataFormatString="N0" MinWidth="60" Width="*" TextWrapping="Wrap" FooterTextAlignment="Center"/>
                                    <telerik:GridViewDataColumn Header="종수" DataMemberBinding="{Binding Path=YVal5}" DataFormatString="N0" MinWidth="60" Width="*" TextWrapping="Wrap" FooterTextAlignment="Center"/>
                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>
                        </Grid>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>

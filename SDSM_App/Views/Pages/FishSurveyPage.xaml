<Page x:Class="SDSM_App.Views.Pages.FishSurveyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
      xmlns:helpers="clr-namespace:Telerik.Windows.Controls.Theming.Helpers;assembly=Telerik.Windows.Controls"
      xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:uc="clr-namespace:SDSM_App.Views.UserControls"
      xmlns:viewmodel="clr-namespace:SDSM_App.ViewModels"
      d:DataContext="{d:DesignInstance Type={x:Type viewmodel:FishSurveyPageViewModel}}"
      FontFamily="{StaticResource DefaultFontFamily}"
      FontSize="{StaticResource DefaultFontSize}"
      Title="어류조사">

    <Grid>
        <Grid MaxWidth="{StaticResource ContentMaxWidth}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--타이틀-->
            <StackPanel Style="{StaticResource TitleStackPanelStyle}">
                <TextBlock Text="생물조사" Style="{StaticResource TitleTextBlockStyle}"/>
                <telerik:RadGlyph Glyph="{StaticResource GlyphArrowChevronRight}" Style="{StaticResource TitleRadGlyphStyle}"/>
                <TextBlock Text="어류" Style="{StaticResource TitleTextBlockStyle}"/>
            </StackPanel>

            <Border Grid.Row="1" Margin="30 30 30 0" Padding="0" BorderThickness="0" Background="Transparent" Style="{StaticResource ContentBoxStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="SearchLayout" Margin="0 0 0 5" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                        <Grid Height="{StaticResource DefaultHeight}" Margin="0 0 0 5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Height="{StaticResource DefaultHeight}">
                                <StackPanel.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PrimaryTextBlcokStyle}"/>
                                </StackPanel.Resources>
                                <TextBlock Text="전체" Margin="0 0 5 0"/>
                                <TextBlock Text="{Binding Path=ModelCollection.Count, Mode=OneWay, StringFormat={}{0:N0}}" Margin="3 0 0 0"/>
                                <TextBlock Text="건" Margin="0 0 5 0"/>
                                <TextBlock Text="/" Margin="5 0"/>
                                <TextBlock Text="페이지" Margin="5 0 5 0"/>
                                <TextBlock Text="{Binding Path=Items.Count, Mode=OneWay, ElementName=DataRadGridView, StringFormat={}{0:N0}}" Margin="3 0 0 0" Foreground="{telerik:Windows11Resource ResourceKey=ValidationBrush}"/>
                                <TextBlock Text="건"/>
                            </StackPanel>

                            <!--검색/출력-->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10 0">
                                <telerik:RadComboBox ItemsSource="{Binding Path=SearchModeSource}" 
                                                     SelectedValue="{Binding Path=SearchModeSelectedValue}"
                                                     DisplayMemberPath="DisplayName"
                                                     SelectedValuePath="Value"
                                                     Width="120"
                                                     IsTabStop="False"
                                                     Margin="0 0 5 0"
                                                     Cursor="Hand"/>
                                <telerik:RadAutoSuggestBox Text="{Binding Path=SearchText}" Style="{StaticResource SearhcBoxStyle}" QuerySubmitted="SearchBox_QuerySubmitted" KeyDown="SearchBox_KeyDown"/>
                                <!--새로고침-->
                                <telerik:RadButton Style="{StaticResource ResetButtonStyle}" Click="ResetButton_Click"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Height="{StaticResource DefaultHeight}">
                                <StackPanel Orientation="Horizontal" Margin="0 0 10 0">
                                    <!--종목록 포함-->
                                    <CheckBox x:Name="SubContainCheckBox" Content="출현종 포함" Cursor="Hand" Margin="0 0 10 0"/>
                                    <!--페이지 출력-->
                                    <telerik:RadButton Style="{StaticResource ExportButtonStyle}" Click="DataExportButton_Click"/>
                                </StackPanel>
                                <!--종목록-->
                                <CheckBox IsChecked="{Binding Path=SubViewVisibility, Converter={StaticResource VisibilityToBooleanConverter}, Mode=TwoWay}" Style="{StaticResource SideCheckBoxStyle}"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!--기본정보 목록-->
                    <telerik:RadGridView x:Name="DataRadGridView"
                                         Grid.Row="1"
                                         ItemsSource="{Binding Path=ModelCollection}"
                                         SelectedItem="{Binding Path=ModelSelectedItem}"
                                         HeaderRowStyle="{StaticResource CustomRadGridViewHeaderRowStyle}"
                                         BusyIndicatorContentTemplate="{StaticResource ExportBusyGridViewTemplate}"
                                         BusyIndicatorIsIndeterminate="False"
                                         FrozenColumnsSplitterVisibility="Visible"
                                         RowIndicatorVisibility="Visible"
                                         LeftFrozenColumnCount="0">
                        <telerik:RadGridView.ColumnGroups>
                            <telerik:GridViewColumnGroup Name="item0" Header="조사개황"/>
                            <telerik:GridViewColumnGroup Name="item4" Header="채집방법"/>
                            <telerik:GridViewColumnGroup Name="item7" Header="서식처 하상구조"/>
                            <telerik:GridViewColumnGroup Name="item15" Header="서식처"/>
                            <telerik:GridViewColumnGroup Name="item17" Header="채집 불가시"/>
                            <telerik:GridViewColumnGroup Name="item19" Header="군집정보"/>
                            <telerik:GridViewColumnGroup Name="item30" Header="비정상종"/>
                            <telerik:GridViewColumnGroup Name="item46" Header="건강도등급"/>
                            <telerik:GridViewColumnGroup Name="item47" Header="메트릭_백분율"/>
                            <telerik:GridViewColumnGroup Name="item55" Header="통합평가_백분율"/>
                            <telerik:GridViewColumnGroup Name="species" Header="출현종"/>                           
                        </telerik:RadGridView.ColumnGroups>
                        <telerik:RadGridView.Columns>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SurveyYearChsu}" MinWidth="80" Width="160" MaxWidth="160" ColumnGroupName="item0"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Site}" MinWidth="80" Width="160" MaxWidth="160" ColumnGroupName="item0"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SurveyDate}" MinWidth="80" Width="160" MaxWidth="160" ColumnGroupName="item0"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=BigZone}" MinWidth="80" Width="160" MaxWidth="160" ColumnGroupName="item0"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=MiddleZone}" MinWidth="80" Width="160" MaxWidth="160" ColumnGroupName="item0"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=River}" MinWidth="80" Width="160" MaxWidth="160" ColumnGroupName="item0"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=RiverType}" MinWidth="80" Width="160" MaxWidth="160" ColumnGroupName="item0"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Lat}" DataFormatString="F6" MinWidth="80" Width="160" MaxWidth="160" ColumnGroupName="item0"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Lng}" DataFormatString="F6" MinWidth="80" Width="160" MaxWidth="160" ColumnGroupName="item0"/>
                            <telerik:GridViewDataColumn Header="날씨&#13;1 맑음, 2 흐림, 3 비(눈)" DataMemberBinding="{Binding Path=Item1}" MinWidth="80" Width="210" MaxWidth="210" ColumnGroupName="item0"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Item2}" MinWidth="80" Width="160" MaxWidth="160" ColumnGroupName="item0"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Item3}" MinWidth="80" Width="180" MaxWidth="180" ColumnGroupName="item0"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Item4}" MinWidth="80" Width="180" MaxWidth="180" ColumnGroupName="item4"/>
                            <telerik:GridViewDataColumn Header="채집도구&#13;1 투망/족대" DataMemberBinding="{Binding Path=Item5}" MinWidth="80" Width="180" MaxWidth="180" ColumnGroupName="item4"/>
                            <telerik:GridViewDataColumn Header="흐름상태&#13;1 여울, 2 흐름, 3 소" DataMemberBinding="{Binding Path=Item6}" MinWidth="80" Width="180" MaxWidth="180" ColumnGroupName="item4"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=ARiverChsu}" MinWidth="80" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Item7}" MinWidth="80" Width="180" MaxWidth="180" ColumnGroupName="item7"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Item8}" MinWidth="80" Width="180" MaxWidth="180" ColumnGroupName="item7"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Item9}" MinWidth="80" Width="200" MaxWidth="200" ColumnGroupName="item7"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Item10}" MinWidth="80" Width="180" MaxWidth="180" ColumnGroupName="item7"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Item11}" MinWidth="80" Width="180" MaxWidth="180" ColumnGroupName="item7"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Item12}" MinWidth="80" Width="180" MaxWidth="180" ColumnGroupName="item7"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Item13}" MinWidth="80" Width="200" MaxWidth="200" ColumnGroupName="item7"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Item14}" MinWidth="80" Width="180" MaxWidth="180" ColumnGroupName="item7"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=ATotalSum}" DataFormatString="F0" MinWidth="80" Width="140" MaxWidth="140"/>
                            <telerik:GridViewDataColumn Header="하천형태&#13;1(자연형), 2(직강화), 3(복합형), 4(댐/보/교각), 5(공사)" DataMemberBinding="{Binding Path=Item15}" MinWidth="80" Width="420" MaxWidth="420" ColumnGroupName="item15"/>
                            <telerik:GridViewDataColumn Header="흐름상태&#13;1(아주빠름), 2(빠름), 3(보통), 4(느림), 5(정체)" DataMemberBinding="{Binding Path=Item16}" DataFormatString="N0" MinWidth="80" Width="370" MaxWidth="370" ColumnGroupName="item15"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Item17}" DataFormatString="N0" MinWidth="80" Width="160" MaxWidth="160" ColumnGroupName="item17"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Item18}" DataFormatString="N0" MinWidth="80" Width="160" MaxWidth="160" ColumnGroupName="item17"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem19}" DataFormatString="N0" MinWidth="80" Width="180" MaxWidth="180" ColumnGroupName="item19"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem20}" DataFormatString="N0" MinWidth="80" Width="170" MaxWidth="170" ColumnGroupName="item19"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem21}" DataFormatString="N0" MinWidth="80" Width="160" MaxWidth="160" ColumnGroupName="item19"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem22}" DataFormatString="N0" MinWidth="80" Width="160" MaxWidth="160" ColumnGroupName="item19"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem23}" DataFormatString="N0" MinWidth="80" Width="160" MaxWidth="160" ColumnGroupName="item19"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem24}" DataFormatString="F2" MinWidth="80" Width="160" MaxWidth="160" ColumnGroupName="item19"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem25}" DataFormatString="F2" MinWidth="80" Width="160" MaxWidth="160" ColumnGroupName="item19"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem26}" DataFormatString="F2" MinWidth="80" Width="200" MaxWidth="200" ColumnGroupName="item19"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem27}" DataFormatString="N0" MinWidth="80" Width="200" MaxWidth="200" ColumnGroupName="item19"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem28}" DataFormatString="N0" MinWidth="80" Width="200" MaxWidth="200" ColumnGroupName="item19"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem29}" DataFormatString="N0" MinWidth="80" Width="200" MaxWidth="200" ColumnGroupName="item19"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem30}" DataFormatString="N0" MinWidth="80" Width="200" MaxWidth="200" ColumnGroupName="item30"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Item31}" DataFormatString="N0" MinWidth="80" Width="180" MaxWidth="180" ColumnGroupName="item30"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Item32}" DataFormatString="N0" MinWidth="80" Width="180" MaxWidth="180" ColumnGroupName="item30"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Item33}" DataFormatString="F2" MinWidth="80" Width="160" MaxWidth="160" ColumnGroupName="item30"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Item34}" DataFormatString="F2" MinWidth="80" Width="160" MaxWidth="160" ColumnGroupName="item30"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem35}" DataFormatString="F2" MinWidth="80" Width="200" MaxWidth="200" ColumnGroupName="item30"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem36}" DataFormatString="N0" MinWidth="80" Width="200" MaxWidth="200" ColumnGroupName="item30"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem37}" DataFormatString="N0" MinWidth="80" Width="200" MaxWidth="200" ColumnGroupName="item30"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem38}" DataFormatString="N0" MinWidth="80" Width="200" MaxWidth="200" ColumnGroupName="item30"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem39}" DataFormatString="N0" MinWidth="80" Width="240" MaxWidth="240" ColumnGroupName="item30"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem40}" DataFormatString="N0" MinWidth="80" Width="240" MaxWidth="240" ColumnGroupName="item30"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem41}" DataFormatString="N0" MinWidth="80" Width="280" MaxWidth="280" ColumnGroupName="item30"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem42}" DataFormatString="N0" MinWidth="80" Width="260" MaxWidth="260" ColumnGroupName="item30"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem43}" DataFormatString="N0" MinWidth="80" Width="240" MaxWidth="240" ColumnGroupName="item30"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem44}" DataFormatString="F2" MinWidth="80" Width="200" MaxWidth="200"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem45}" DataFormatString="F2" MinWidth="80" Width="200" MaxWidth="200"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem46}" DataFormatString="F2" MinWidth="80" Width="200" MaxWidth="200" ColumnGroupName="item46"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem47}" DataFormatString="F2" MinWidth="80" Width="200" MaxWidth="200" ColumnGroupName="item47"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem48}" DataFormatString="N0" MinWidth="80" Width="200" MaxWidth="200" ColumnGroupName="item47"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem49}" DataFormatString="N0" MinWidth="80" Width="200" MaxWidth="200" ColumnGroupName="item47"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem50}" DataFormatString="F2" MinWidth="80" Width="240" MaxWidth="240" ColumnGroupName="item47"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem51}" DataFormatString="N0" MinWidth="80" Width="240" MaxWidth="240" ColumnGroupName="item47"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem52}" DataFormatString="N0" MinWidth="80" Width="280" MaxWidth="280" ColumnGroupName="item47"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem53}" DataFormatString="F2" MinWidth="80" Width="260" MaxWidth="260" ColumnGroupName="item47"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem54}" DataFormatString="N0" MinWidth="80" Width="240" MaxWidth="240" ColumnGroupName="item47"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem55}" DataFormatString="N0" MinWidth="80" Width="200" MaxWidth="200" ColumnGroupName="item55"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem56}" DataFormatString="F2" MinWidth="80" Width="200" MaxWidth="200" ColumnGroupName="item55"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem57}" DataFormatString="F2" MinWidth="80" Width="200" MaxWidth="200" ColumnGroupName="item55"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem58}" DataFormatString="F2" MinWidth="80" Width="240" MaxWidth="240" ColumnGroupName="item55"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem59}" DataFormatString="F2" MinWidth="80" Width="240" MaxWidth="240" ColumnGroupName="item55"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem60}" DataFormatString="F2" MinWidth="80" Width="280" MaxWidth="280" ColumnGroupName="item55"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem61}" MinWidth="80" Width="280" MaxWidth="280" ColumnGroupName="item55"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem61}" MinWidth="80" Width="260" MaxWidth="260" ColumnGroupName="item55"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem62}" DataFormatString="F2" MinWidth="80" Width="260" MaxWidth="260" ColumnGroupName="item55"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem63}" MinWidth="80" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem64}" MinWidth="80" Width="260" MaxWidth="260"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=AItem65}" DataFormatString="F2" MinWidth="80" Width="160" MaxWidth="160"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SpeciesCount}" DataFormatString="N0" MinWidth="80" Width="120" MaxWidth="120" ColumnGroupName="species"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=NoUSum}" DataFormatString="N0" MinWidth="80" Width="120" MaxWidth="120" ColumnGroupName="species"/>
                        </telerik:RadGridView.Columns>
                    </telerik:RadGridView>
                </Grid>
            </Border>

            <!--페이징-->
            <Grid Grid.Row="2" Margin="30 10 30 30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <uc:PageSizeCommandControl MinCommand="{Binding Path=PageSizeMinExecutedCommand}" AvgCommand="{Binding Path=PageSizeAvgExecutedCommand}" MaxCommand="{Binding Path=PageSizeMaxExecutedCommand}"/>
                    <telerik:RadNumericUpDown Value="{Binding Path=PageSize}" Style="{StaticResource PageSizeRadNumericUpDownStyle}">
                        <telerik:EventToCommandBehavior.EventBindings>
                            <telerik:EventBinding EventName="ValueChanged" Command="{Binding Path=PageSizeChangedExecutedCommand}" PassEventArgsToCommand="True"/>
                        </telerik:EventToCommandBehavior.EventBindings>
                    </telerik:RadNumericUpDown>
                </StackPanel>

                <telerik:RadDataPager x:Name="DataRadDataPager"
                                      Grid.Column="1"
                                      ItemCount="{Binding Path=ModelTotal}"
                                      PageSize="{Binding Path=PageSize}"
                                      PageIndex="{Binding Path=PageIndex, Mode=TwoWay}"
                                      Margin="0">
                    <telerik:EventToCommandBehavior.EventBindings>
                        <telerik:EventBinding EventName="PageIndexChanged" Command="{Binding Path=PageIndexChangedExecutedCommand}" PassEventArgsToCommand="True"/>
                    </telerik:EventToCommandBehavior.EventBindings>
                </telerik:RadDataPager>
            </Grid>
            
            <!--출현종목록-->
            <Border Grid.Column="1" Grid.RowSpan="3" Visibility="{Binding Path=SubViewVisibility}" Style="{StaticResource SubViewContentBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0 0 0 20">
                        <TextBlock Text="출현종 목록" Style="{StaticResource SubTitleTextBlcokStyle}" Margin="0 0 20 0"/>
                        <telerik:RadButton Command="{Binding Path=SubViewCloseExecutedCommand}" Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Right">
                            <telerik:RadGlyph Glyph="{StaticResource GlyphClose}" Foreground="{telerik:Windows11Resource ResourceKey=IconBrush}"/>
                        </telerik:RadButton>
                    </DockPanel>

                    <telerik:RadGridView x:Name="SubDataRadGridView"
                                         Grid.Row="1"
                                         ItemsSource="{Binding Path=SubData.Subs}"
                                         HeaderRowStyle="{StaticResource CustomRadGridViewHeaderRowStyle}"
                                         BusyIndicatorContentTemplate="{StaticResource ExportBusyGridViewTemplate}"
                                         BusyIndicatorIsIndeterminate="False"
                                         FrozenColumnsSplitterVisibility="Collapsed"
                                         RowIndicatorVisibility="Collapsed"
                                         LeftFrozenColumnCount="0"
                                         ShowColumnFooters="True">
                        <telerik:RadGridView.Columns>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=OrderKo}" MinWidth="80" Width="140" MaxWidth="140"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=FamilyKo}" MinWidth="80" Width="140" MaxWidth="140"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SpeciesKo}" MinWidth="80" Width="160" MaxWidth="160" TextWrapping="Wrap"/>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SpeciesEn}" MinWidth="80" Width="220" MaxWidth="220" TextWrapping="Wrap">
                                <telerik:GridViewDataColumn.AggregateFunctions>
                                    <telerik:CountFunction ResultFormatString="{}{0:N0}종"/>
                                </telerik:GridViewDataColumn.AggregateFunctions>
                            </telerik:GridViewDataColumn>
                            <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=NoU}" DataFormatString="N0" MinWidth="80" Width="120" MaxWidth="120">
                                <telerik:GridViewDataColumn.AggregateFunctions>
                                    <telerik:SumFunction ResultFormatString="{}{0:N0}개체수"/>
                                </telerik:GridViewDataColumn.AggregateFunctions>
                            </telerik:GridViewDataColumn>
                        </telerik:RadGridView.Columns>
                    </telerik:RadGridView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>

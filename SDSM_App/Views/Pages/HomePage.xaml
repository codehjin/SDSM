<Page x:Class="SDSM_App.Views.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
      xmlns:helpers="clr-namespace:Telerik.Windows.Controls.Theming.Helpers;assembly=Telerik.Windows.Controls"
      xmlns:maps="clr-namespace:Telerik.Windows.Controls.Map;assembly=Telerik.Windows.Controls.DataVisualization"
      xmlns:ani="clr-namespace:SDSM_App.Animations"
      xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:properties="clr-namespace:SDSM_App.Properties"
      xmlns:behavior="clr-namespace:SDSM_App.Behaviors"
      xmlns:converter="clr-namespace:SDSM_App.Converters"
      xmlns:common="clr-namespace:SDSM_App.Commons"
      xmlns:viewmodel="clr-namespace:SDSM_App.ViewModels"
      d:DataContext="{d:DesignInstance Type={x:Type viewmodel:HomePageViewModel}}"
      FontFamily="{StaticResource DefaultFontFamily}"
      FontSize="{StaticResource DefaultFontSize}"
      Title="홈">
    <Page.Resources>

        <converter:StringToBrushConverter x:Key="StringToBrushConverter" />
        <converter:BackgroundStringToForegroundConverter x:Key="BackgroundStringToForegroundConverter"/>
        <converter:MultiBindingValueConverter x:Key="MultiBindingValueConverter"/>

        <!--클러스터-->
        <converter:ClusterChildrenToBoolConverter x:Key="ClusterChildrenToBoolConverter" />
        <telerik:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!--클러스터-->
        <DataTemplate x:Key="ClusterTemplate">
            <Grid x:Name="ParentRoot" Width="40" Height="30" Cursor="Hand" telerik:MapLayer.HotSpot="0.5, 0.5" MouseLeftButtonDown="ClusterMouseLeftButtonDown" MouseRightButtonDown="ClusterMouseRightButtonDown">
                <Path Width="{Binding Width,ElementName=ParentRoot}" 
	                  Height="{Binding Height,ElementName=ParentRoot}" 
	                  Stretch="Fill"
                      Data="M978.6509,491.334L958.6109,491.334L954.4549,500.874L949.9999,491.334L930.6259,491.334C928.4169,491.334,926.6259,489.543,926.6259,487.334L926.6259,433.272C926.6259,431.063,928.4169,429.272,930.6259,429.272L978.6509,429.272C980.8599,429.272,982.6509,431.063,982.6509,433.272L982.6509,487.334C982.6509,489.543,980.8599,491.334,978.6509,491.334z" 
	                  StrokeStartLineCap="Flat"
                      StrokeEndLineCap="Flat"
                      Stroke="White"
                      StrokeThickness="1"
                      StrokeMiterLimit="10"
                      StrokeLineJoin="Miter">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Fill" Value="#99000000"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=Children, Converter={StaticResource ClusterChildrenToBoolConverter}}" Value="True">
                                    <Setter Property="Fill" Value="#990078D4"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <StackPanel Margin="5,2,5,5">
                    <TextBlock Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Path=Count}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <Style x:Key="ContentBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=TertiaryBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="10 10 10 0"/>
            <Setter Property="Padding" Value="14 14 14 14"/>
            <Setter Property="CornerRadius" Value="{telerik:Windows11Resource ResourceKey=CornerRadius}"/>
        </Style>
        <Style x:Key="ExpanderCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource CustomCheckBoxStyle}">
            <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}"/>
            <Setter Property="helpers:ThemeHelper.CheckedBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}"/>
            <Setter Property="helpers:ThemeHelper.CheckedBrush" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
            <Setter Property="helpers:ThemeHelper.MouseOverBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}"/>
            <Setter Property="helpers:ThemeHelper.MouseOverBrush" Value="{telerik:Windows11Resource ResourceKey=FocusBrush}"/>
            <Setter Property="Tag" Value="expander"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Padding" Value="5 5"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Padding" Value="5 5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CaptionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=FocusInnerBrush}"/>
            <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0 0 0 10"/>
            <Setter Property="Padding" Value="10 13 10 11"/>
            <Setter Property="CornerRadius" Value="{telerik:Windows11Resource ResourceKey=CornerRadius}"/>
        </Style>
        <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource PrimaryTextBlcokStyle}">
            <Setter Property="FontFamily" Value="{StaticResource High1FontFamily}"/>
        </Style>
        <Style x:Key="PointBorderStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="5 3"/>
        </Style>

        <Style x:Key="PointTextBlcokStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource High1FontFamily}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!--조사위치포인트-->
        <DataTemplate x:Key="PointDataTemplate">
            <Border telerik:MapLayer.Location ="{Binding Path=Location}"
                    Cursor="Hand"
                    Padding="5"
                    CornerRadius="3"
                    BorderBrush="#33000000"
                    BorderThickness="0 0 2 2"
                    MouseLeftButtonDown="Point_MouseLeftButtonDown">
                <telerik:MapLayer.HotSpot>
                    <telerik:HotSpot X="0.5" Y="0.5"/>
                </telerik:MapLayer.HotSpot>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=Caption}" Value="식생">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=VegetationColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Caption}" Value="식물">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=PlantColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Caption}" Value="양서파충류">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=AmphibianReptileColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Caption}" Value="어류">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=FishColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Caption}" Value="저서동물">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=BenthosColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Caption}" Value="조류">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=BirdColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Caption}" Value="포유류">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=MammalColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Caption}" Value="서식수변">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=HabitatWaterEdgeColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Caption}" Value="수질">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=WaterQualityColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Path=Label}" FontFamily="{StaticResource High1FontFamily}" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=Caption}" Value="식생">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=VegetationColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Caption}" Value="식물">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=PlantColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Caption}" Value="양서파충류">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=AmphibianReptileColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Caption}" Value="어류">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=FishColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Caption}" Value="저서동물">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=BenthosColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Caption}" Value="조류">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=BirdColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Caption}" Value="포유류">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=MammalColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Caption}" Value="서식수변">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=HabitatWaterEdgeColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Caption}" Value="수질">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=WaterQualityColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>

        <Style x:Key="MapPinCalloutStyle" TargetType="telerik:RadCallout">
            <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=OverlayBrush}"/>
            <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=SecondaryBorderBrush}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="CalloutType" Value="RoundedRectangle"/>
            <Setter Property="ArrowType" Value="Triangle"/>
            <Setter Property="ArrowAnchorPoint" Value="0.5,1.05"/>
            <Setter Property="ArrowBasePoint1" Value="0.35,0.5"/>
            <Setter Property="ArrowBasePoint2" Value="0.65,0.5"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="MinWidth" Value="1020"/>
            <Setter Property="Width" Value="1020"/>
            <Setter Property="MaxWidth" Value="1020"/>
            <Setter Property="Margin" Value="0 0 0 0"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel UseLayoutRounding="True">
                            <Grid Margin="0 0 0 10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Height="{StaticResource DefaultHeight}">
                                    <StackPanel.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PrimaryTextBlcokStyle}">
                                            <Setter Property="FontFamily" Value="{StaticResource High1FontFamily}"/>
                                        </Style>
                                    </StackPanel.Resources>
                                    <TextBlock Text="전체" Margin="0 0 5 0"/>
                                    <TextBlock Text="{Binding Path=Items.Count, Mode=OneWay, ElementName=DataRadGridView, StringFormat={}{0:N0}}" Margin="3 0 0 0" Foreground="{telerik:Windows11Resource ResourceKey=ValidationBrush}"/>
                                    <TextBlock Text="건" Margin="0 0 20 0"/>
                                    <TextBlock Text="{Binding Path=Lat, StringFormat=({0:F6}}"/>
                                    <TextBlock Text="," Margin="2 0 10 5" FontFamily="{StaticResource DefaultFontFamily}"/>
                                    <TextBlock Text="{Binding Path=Lng, StringFormat={}{0:F6})}"/>
                                    <telerik:RadButton Margin="20 0 0 0" Height="36" Click="AllCopyRadButton_Click">
                                        <telerik:RadButton.Tag>
                                            <MultiBinding Converter="{StaticResource MultiBindingValueConverter}">
                                                <Binding ElementName="DataRadGridView"/>
                                                <Binding ElementName="CopyTextBlock"/>
                                            </MultiBinding>                                        
                                        </telerik:RadButton.Tag>
                                        <StackPanel Orientation="Horizontal">
                                            <telerik:RadGlyph Glyph="{StaticResource GlyphCopy}"/>
                                            <TextBlock x:Name="CopyTextBlock" Text="복사" Margin="5 0 0 0" FontFamily="{StaticResource DefaultFontFamily}"/>
                                        </StackPanel>
                                    </telerik:RadButton>
                                </StackPanel>
                                <telerik:RadButton Grid.Column="1"
                                                   DockPanel.Dock="Right"
                                                   Cursor="Hand"
                                                   IsBackgroundVisible="False"
                                                   Padding="7 0"
                                                   Height="32"
                                                   Margin="0 -10 0 0"
                                                   VerticalAlignment="Center" 
                                                   HorizontalAlignment="Right"
                                                   helpers:ThemeHelper.MouseOverBrush="{telerik:Windows11Resource ResourceKey=FocusBrush}"
                                                   helpers:ThemeHelper.PressedBrush="Transparent"
                                                   helpers:ThemeHelper.FocusBrush="Transparent"
                                                   Click="MapPinCalloutCloseRadButton_Click">
                                    <telerik:RadGlyph Glyph="&#xe11b;"/>
                                </telerik:RadButton>
                            </Grid>
                            <Grid Margin="0 0 0 0">
                                <telerik:RadGridView x:Name="DataRadGridView"
                                                     ItemsSource="{Binding Path=DataContext.SelectedCollection, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}"
                                                     BusyIndicatorContentTemplate="{StaticResource ExportBusyGridViewTemplate}"
                                                     BusyIndicatorIsIndeterminate="False"
                                                     FrozenColumnsSplitterVisibility="Collapsed"
                                                     RowIndicatorVisibility="Collapsed"
                                                     LeftFrozenColumnCount="0"
                                                     IsFilteringAllowed="False"
                                                     IsSynchronizedWithCurrentItem="{x:Null}"
                                                     MinHeight="110"
                                                     MaxHeight="560">
                                    <telerik:RadGridView.Columns>
                                        <telerik:GridViewDataColumn Header="구분" DataMemberBinding="{Binding Path=Caption}" MinWidth="80" Width="130" MaxWidth="130"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=YearChsu}" MinWidth="80" Width="140" MaxWidth="140"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SurveyDate}" DataFormatString="{}{0:yyyy-MM-dd}" MinWidth="80" Width="140" MaxWidth="140"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=River}" MinWidth="80" Width="140" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Site}" MinWidth="80" Width="140" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SpeciesKo}" MinWidth="80" Width="240" MaxWidth="240" TextWrapping="Wrap" IsVisible="{Binding Path=IsSpecies}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SpeciesEn}" MinWidth="80" Width="480" MaxWidth="480" TextWrapping="Wrap" IsVisible="{Binding Path=IsSpecies}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Surveyor}" MinWidth="80" Width="180" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Score}" DataFormatString="{}{0:F1}" MinWidth="80" Width="120" MaxWidth="120" IsVisible="{Binding Path=IsScoreGrade}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Grade}" MinWidth="80" Width="120" MaxWidth="120" IsVisible="{Binding Path=IsScoreGrade}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SpeciesCount}" DataFormatString="N0" MinWidth="80" Width="120" MaxWidth="120" IsVisible="{Binding Path=IsSpeciesCount}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=IndividualCount}" DataFormatString="{}{0:N1}" MinWidth="80" Width="120" MaxWidth="120" IsVisible="{Binding Path=IsIndividualCount}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=PHGrade}" MinWidth="80" Width="120" MaxWidth="120" IsVisible="{Binding Path=IsWaterQuality}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=BODGrade}" MinWidth="80" Width="120" MaxWidth="120" IsVisible="{Binding Path=IsWaterQuality}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=CODGrade}" MinWidth="80" Width="120" MaxWidth="120" IsVisible="{Binding Path=IsWaterQuality}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=TOCGrade}" MinWidth="80" Width="120" MaxWidth="120" IsVisible="{Binding Path=IsWaterQuality}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SSGrade}" MinWidth="80" Width="120" MaxWidth="120" IsVisible="{Binding Path=IsWaterQuality}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=DOGrade}" MinWidth="80" Width="120" MaxWidth="120" IsVisible="{Binding Path=IsWaterQuality}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=TPGrade}" MinWidth="80" Width="120" MaxWidth="120" IsVisible="{Binding Path=IsWaterQuality}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=EColiGrade}" MinWidth="80" Width="120" MaxWidth="120" IsVisible="{Binding Path=IsWaterQuality}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Lat}" MinWidth="80" Width="140" MaxWidth="140"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Lng}" MinWidth="80" Width="140" MaxWidth="140"/>
                                    </telerik:RadGridView.Columns>
                                </telerik:RadGridView>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <telerik:RadMap x:Name="radMap"
                        Language="ko-KR"
                        UseDefaultLayout="False"
                        UseSpringAnimations="False"
                        MinZoomLevel="3"
                        MaxZoomLevel="20"
                        ZoomLevel="12"
                        ZoomStep="1"
                        Zoom="{Binding Path=Zoom, Mode=TwoWay}"
                        Center="{Binding Path=Center, Mode=TwoWay}"
                        MouseClickMode="SelectItem" 
                        ZoomChanged="RadMap_ZoomChanged"
                        MouseRightButtonDown="RadMap_MouseRightButtonDown">
            <telerik:RadContextMenu.ContextMenu>
                <telerik:RadContextMenu IconColumnWidth="0">
                    <telerik:RadMenuItem x:Name="CopyRadMenuItem" Cursor="Hand" Click="CopyRadMenuItem_Click">
                        <telerik:RadMenuItem.Header>
                            <StackPanel>
                                <TextBlock Text="{Binding Path=Degress}" FontSize="15"/>
                                <TextBlock x:Name="CopyTextBlock" Text="복사" FontSize="15"/>
                            </StackPanel>
                        </telerik:RadMenuItem.Header>
                    </telerik:RadMenuItem>
                </telerik:RadContextMenu>
            </telerik:RadContextMenu.ContextMenu>
            <telerik:RadMap.Providers>
                <telerik:EmptyProvider/>
            </telerik:RadMap.Providers>

            <!--조사위치포인트-->
            <telerik:VisualizationLayer x:Name="PointVisualizationLayer"
                                        ItemsSource="{Binding Path=PointCollection}"
                                        ClusteringEnabled="True"
                                        AutoCalculateClusteringThreshold="False"
                                        ClusteringEnabledThreshold ="13"
                                        ClusterItemTemplate="{StaticResource ClusterTemplate}"
                                        ItemTemplate="{StaticResource PointDataTemplate}"/>
        </telerik:RadMap>

        <Grid>

            <!--상단-->
            <WrapPanel Orientation="Horizontal">
                <!--조사자료-->
                <Grid Margin="10 10 0 10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="SurveyDataVisibleCheckBox" HorizontalContentAlignment="Stretch" Style="{StaticResource ExpanderCheckBoxStyle}" Padding="20 5" IsChecked="True">
                        <Grid Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="조사자료" Margin="0 8 20 0" FontFamily="{StaticResource High1FontFamily}"/>
                            <telerik:RadGlyph Grid.Column="1">
                                <telerik:RadGlyph.Style>
                                    <Style TargetType="telerik:RadGlyph">
                                        <Setter Property="Glyph" Value="{StaticResource GlyphArrowChevronDown}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=CheckBox}}" Value="True">
                                                <Setter Property="Glyph" Value="{StaticResource GlyphArrowChevronUp}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </telerik:RadGlyph.Style>
                            </telerik:RadGlyph>
                        </Grid>
                    </CheckBox>

                    <Border Grid.Row="1" Style="{StaticResource ContentBorderStyle}" Margin="0 5 0 0" Visibility="{Binding Path=IsChecked, ElementName=SurveyDataVisibleCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBoxStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Height" Value="{StaticResource DefaultHeight}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Style>
                            </StackPanel.Resources>

                            <telerik:RadButton Content="전체 선택해제" Margin="0 0 0 10" Height="{StaticResource DefaultHeight}" HorizontalAlignment="Right" Command="{Binding Path=AllClearPointExecutedCommand}"/>

                            <ItemsControl ItemsSource="{Binding Path=SurveyDataCollection}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding Path=IsSelected, Mode=TwoWay}"
                                                      Margin="0 0 0 5"
                                                      Command="{Binding Path=DataContext.AddAndRemovePointExecutedCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" 
                                                      CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Path=Caption}"/>
                                                        <TextBlock>
                                                            <Run Text="("/>
                                                            <Run Text="{Binding Path=Count, StringFormat={}{0:N0}}"/>
                                                            <Run Text=")"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                                
                                                    <Rectangle Grid.Column="1" Width="20" Height="18" Margin="10 0 0 0" RadiusX="3" RadiusY="3">
                                                        <Rectangle.Style>
                                                            <Style TargetType="Rectangle">
                                                                <Setter Property="Fill" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Path=Caption}" Value="식생">
                                                                        <Setter Property="Fill" Value="{Binding Source={x:Static properties:Settings.Default}, Path=VegetationColor, Converter={StaticResource StringToBrushConverter}}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Path=Caption}" Value="식물">
                                                                        <Setter Property="Fill" Value="{Binding Source={x:Static properties:Settings.Default}, Path=PlantColor, Converter={StaticResource StringToBrushConverter}}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Path=Caption}" Value="양서파충류">
                                                                        <Setter Property="Fill" Value="{Binding Source={x:Static properties:Settings.Default}, Path=AmphibianReptileColor, Converter={StaticResource StringToBrushConverter}}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Path=Caption}" Value="어류">
                                                                        <Setter Property="Fill" Value="{Binding Source={x:Static properties:Settings.Default}, Path=FishColor, Converter={StaticResource StringToBrushConverter}}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Path=Caption}" Value="저서동물">
                                                                        <Setter Property="Fill" Value="{Binding Source={x:Static properties:Settings.Default}, Path=BenthosColor, Converter={StaticResource StringToBrushConverter}}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Path=Caption}" Value="조류">
                                                                        <Setter Property="Fill" Value="{Binding Source={x:Static properties:Settings.Default}, Path=BirdColor, Converter={StaticResource StringToBrushConverter}}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Path=Caption}" Value="포유류">
                                                                        <Setter Property="Fill" Value="{Binding Source={x:Static properties:Settings.Default}, Path=MammalColor, Converter={StaticResource StringToBrushConverter}}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Path=Caption}" Value="서식수변">
                                                                        <Setter Property="Fill" Value="{Binding Source={x:Static properties:Settings.Default}, Path=HabitatWaterEdgeColor, Converter={StaticResource StringToBrushConverter}}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Path=Caption}" Value="수질">
                                                                        <Setter Property="Fill" Value="{Binding Source={x:Static properties:Settings.Default}, Path=WaterQualityColor, Converter={StaticResource StringToBrushConverter}}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Rectangle.Style>
                                                    </Rectangle>
                                                </Grid>
                                            </CheckBox>
                                            <telerik:RadDropDownButton  Grid.Column="1" Margin="8 0 0 0" Cursor="Hand" Height="36">
                                                <telerik:RadDropDownButton.Content>
                                                    <TextBlock Text="{StaticResource GlyphPalette}" 
                                                               FontFamily="{x:Static telerik:RadGlyph.TelerikFontFamily}" 
                                                               FontSize="18"
                                                               Foreground="#AA000000"/>
                                                </telerik:RadDropDownButton.Content>
                                                <telerik:RadDropDownButton.DropDownContent>
                                                    <telerik:RadColorEditor Grid.Column="1" ColorMode="RGB" BorderThickness="0" Width="500" Margin="5">
                                                        <telerik:RadColorEditor.Style>
                                                            <Style TargetType="telerik:RadColorEditor">
                                                                <Setter Property="SelectedColor" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Path=Caption}" Value="식생">
                                                                        <Setter Property="SelectedColor" Value="{Binding Source={x:Static properties:Settings.Default}, Path=VegetationColor, Mode=TwoWay}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Path=Caption}" Value="식물">
                                                                        <Setter Property="SelectedColor" Value="{Binding Source={x:Static properties:Settings.Default}, Path=PlantColor, Mode=TwoWay}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Path=Caption}" Value="양서파충류">
                                                                        <Setter Property="SelectedColor" Value="{Binding Source={x:Static properties:Settings.Default}, Path=AmphibianReptileColor, Mode=TwoWay}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Path=Caption}" Value="어류">
                                                                        <Setter Property="SelectedColor" Value="{Binding Source={x:Static properties:Settings.Default}, Path=FishColor, Mode=TwoWay}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Path=Caption}" Value="저서동물">
                                                                        <Setter Property="SelectedColor" Value="{Binding Source={x:Static properties:Settings.Default}, Path=BenthosColor, Mode=TwoWay}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Path=Caption}" Value="조류">
                                                                        <Setter Property="SelectedColor" Value="{Binding Source={x:Static properties:Settings.Default}, Path=BirdColor, Mode=TwoWay}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Path=Caption}" Value="포유류">
                                                                        <Setter Property="SelectedColor" Value="{Binding Source={x:Static properties:Settings.Default}, Path=MammalColor, Mode=TwoWay}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Path=Caption}" Value="서식수변">
                                                                        <Setter Property="SelectedColor" Value="{Binding Source={x:Static properties:Settings.Default}, Path=HabitatWaterEdgeColor, Mode=TwoWay}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Path=Caption}" Value="수질">
                                                                        <Setter Property="SelectedColor" Value="{Binding Source={x:Static properties:Settings.Default}, Path=WaterQualityColor, Mode=TwoWay}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </telerik:RadColorEditor.Style>
                                                    </telerik:RadColorEditor>
                                                </telerik:RadDropDownButton.DropDownContent>
                                            </telerik:RadDropDownButton>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!--주제도-->
                <Grid Margin="10 10 0 10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="ThemeMapVisibleCheckBox" HorizontalContentAlignment="Stretch" Style="{StaticResource ExpanderCheckBoxStyle}" Padding="20 5">
                        <Grid Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="주제도" Margin="0 8 20 0" FontFamily="{StaticResource High1FontFamily}"/>
                            <telerik:RadGlyph Grid.Column="1">
                                <telerik:RadGlyph.Style>
                                    <Style TargetType="telerik:RadGlyph">
                                        <Setter Property="Glyph" Value="{StaticResource GlyphArrowChevronDown}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=CheckBox}}" Value="True">
                                                <Setter Property="Glyph" Value="{StaticResource GlyphArrowChevronUp}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </telerik:RadGlyph.Style>
                            </telerik:RadGlyph>
                        </Grid>
                    </CheckBox>

                    <Border Grid.Row="1" Style="{StaticResource ContentBorderStyle}" Margin="0 5 0 0" Padding="10 10 10 5" VerticalAlignment="Top" Visibility="{Binding Path=IsChecked, ElementName=ThemeMapVisibleCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.Resources>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBoxStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Height" Value="{StaticResource DefaultHeight}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Style>
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <telerik:RadButton Content="전체 선택해제" Margin="0 0 0 10" Height="{StaticResource DefaultHeight}" HorizontalAlignment="Right" Click="AllThemeMapUnCheckedRadButton_Click"/>

                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Margin="0 0 -10 0" Padding="0 0 10 0">
                                <ItemsControl ItemsSource="{Binding Path=ThemeMapCollection}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.Resources>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PrimaryTextBlcokStyle}"/>
                                                </Grid.Resources>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!--체크박스-->
                                                <DockPanel>
                                                    <telerik:RadToggleButton DockPanel.Dock="Right" Content="범례" IsChecked="{Binding Path=IsVisibleLegend, Mode=TwoWay}" Margin="20 0 0 0" Padding="15 5" VerticalAlignment="Center" Cursor="Hand"/>
                                                    <CheckBox DockPanel.Dock="Left" Content="{Binding Path=Caption}" IsChecked="{Binding Path=IsSelected, Mode=TwoWay}" Checked="ThemeMapCheckBox_Checked" Unchecked="ThemeMapCheckBox_Unchecked"/>
                                                </DockPanel>

                                                <!--불투명도-->
                                                <Grid Grid.Row="1" Margin="0 10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="불투명도" FontFamily="{StaticResource High1FontFamily}" Width="80"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Path=Value, ElementName=TransparencyRadSlider, StringFormat={}{0:P0}}" FontFamily="{StaticResource High1FontFamily}" TextAlignment="Right" Width="60" Margin="0 0 10 0"/>
                                                    <telerik:RadSlider x:Name="TransparencyRadSlider"
                                                                       Grid.Column="2"
                                                                       Maximum="1.0"
                                                                       Minimum="0"
                                                                       SmallChange="0.1"
                                                                       LargeChange="0.1"
                                                                       IsMoveToPointEnabled="True"
                                                                       Width="250">
                                                        <telerik:RadSlider.Style>
                                                            <Style TargetType="telerik:RadSlider">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Path=OpacityName}" Value="BiotopesRarityOpacity">
                                                                        <Setter Property="Value" Value="{Binding Path=DataContext.BiotopesRarityOpacity, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}, Mode=TwoWay}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Path=OpacityName}" Value="InvasiveSpeciesOpacity">
                                                                        <Setter Property="Value" Value="{Binding Path=DataContext.InvasiveSpeciesOpacity, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}, Mode=TwoWay}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </telerik:RadSlider.Style>
                                                    </telerik:RadSlider>
                                                </Grid>

                                                <!--범례-->
                                                <Border Grid.Row="2" Visibility="{Binding Path=IsVisibleLegend, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0 10 0 0">
                                                    <telerik:RadGridView x:Name="DataRadGridView"
                                                                         Grid.Column="1"
                                                                         Grid.Row="1"
                                                                         ItemsSource="{Binding Path=ContentSubItems}"
                                                                         BusyIndicatorIsIndeterminate="False"
                                                                         FrozenColumnsSplitterVisibility="Collapsed"
                                                                         LeftFrozenColumnCount="0"
                                                                         IsSynchronizedWithCurrentItem="{x:Null}"
                                                                         CanUserSortColumns="False"
                                                                         CanUserSelect="False"
                                                                         IsReadOnly="True"
                                                                         Width="400"
                                                                         MinHeight="100"
                                                                         HorizontalAlignment="Left"
                                                                         Background="Transparent"
                                                                         IsFilteringAllowed="False"
                                                                         VerticalGridLinesBrush="Transparent">
                                                        <telerik:RadGridView.Columns>
                                                            <telerik:GridViewDataColumn Header="범례" MinWidth="50" Width="50" MaxWidth="50" HeaderCellStyle="{StaticResource NotSortingGridViewHeaderCellStyle}">
                                                                <telerik:GridViewDataColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <Grid>
                                                                            <Rectangle Fill="{Binding Path=MarkerFill}" Stroke="#33000000" StrokeThickness="0.5" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                       Visibility="{Binding Path=IsBiotopesRarity, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                            <Ellipse Fill="{Binding Path=MarkerFill}" Stroke="#33000000" StrokeThickness="0.5" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                     Visibility="{Binding Path=IsInvasiveSpecies, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </telerik:GridViewDataColumn.CellTemplate>
                                                            </telerik:GridViewDataColumn>
                                                            <telerik:GridViewDataColumn Header="등급" DataMemberBinding="{Binding Path=Grade}" MinWidth="80" Width="140" MaxWidth="140" TextWrapping="Wrap" HeaderCellStyle="{StaticResource NotSortingGridViewHeaderCellStyle}" IsVisible="{Binding Path=IsBiotopesRarity}"/>
                                                            <telerik:GridViewDataColumn Header="개수" DataMemberBinding="{Binding Path=Count}" DataFormatString="N0" MinWidth="80" Width="100" MaxWidth="100" HeaderCellStyle="{StaticResource NotSortingGridViewHeaderCellStyle}" CellStyle="{StaticResource GridViewCellRightStyle}" IsVisible="{Binding Path=IsBiotopesRarity}"/>
                                                            <telerik:GridViewDataColumn Header="면적(km²)" DataMemberBinding="{Binding Path=Area}" DataFormatString="F2" MinWidth="80" Width="100" MaxWidth="100" HeaderCellStyle="{StaticResource NotSortingGridViewHeaderCellStyle}" CellStyle="{StaticResource GridViewCellRightStyle}" IsVisible="{Binding Path=IsBiotopesRarity}"/>
                                                            <telerik:GridViewDataColumn Header="교란종" DataMemberBinding="{Binding Path=Grade}" MinWidth="80" Width="240" MaxWidth="240" TextWrapping="Wrap" HeaderCellStyle="{StaticResource NotSortingGridViewHeaderCellStyle}" IsVisible="{Binding Path=IsInvasiveSpecies}"/>
                                                            <telerik:GridViewDataColumn Header="개체수" DataMemberBinding="{Binding Path=Count}" DataFormatString="N0" MinWidth="80" Width="100" MaxWidth="100" HeaderCellStyle="{StaticResource NotSortingGridViewHeaderCellStyle}" CellStyle="{StaticResource GridViewCellRightStyle}" IsVisible="{Binding Path=IsInvasiveSpecies}"/>                                                            
                                                        </telerik:RadGridView.Columns>
                                                    </telerik:RadGridView>
                                                </Border>
                                                <Grid Grid.Row="2" Visibility="Collapsed" Margin="0 10 0 0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="32"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Column="0" Text="범례" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="희소성 등급" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="개수" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="3" Text="면적(km²)" HorizontalAlignment="Right" Margin="0 0 10 0"/>
                                                </Grid>

                                                <ItemsControl Grid.Row="3" ItemsSource="{Binding Path=ContentSubItems}" Visibility="Collapsed">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="40"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="100"/>
                                                                    <ColumnDefinition Width="110"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="32"/>
                                                                </Grid.RowDefinitions>
                                                                <Rectangle Grid.Column="0" Fill="{Binding Path=MarkerFill}" StrokeThickness="1" Width="20" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Rectangle.Style>
                                                                        <Style TargetType="Rectangle">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Path=Grade}" Value="전체">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Rectangle.Style>
                                                                </Rectangle>
                                                                <TextBlock Grid.Column="1" Text="{Binding Path=Grade}" HorizontalAlignment="Center"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Path=Count, StringFormat={}{0:N0}}" HorizontalAlignment="Right"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding Path=Area, StringFormat={}{0:F2}}" HorizontalAlignment="Right" Margin="0 0 10 0"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Rectangle Grid.Row="4" Style="{StaticResource HorizontalRectangleStyle}" Margin="0 20"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </WrapPanel>

            <!--우측-->
            <Grid HorizontalAlignment="Right" Margin="0 10 0 10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="2" HorizontalAlignment="Right" Margin="0 0 10 6">
                    <Border Background="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}" BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="1" Width="53">
                        <StackPanel>
                            <telerik:RadRadioButton IsChecked="True" FontSize="14" Cursor="Hand" FontFamily="{StaticResource High1FontFamily}" CornerRadius="3 3 0 0" Tag="vworld_road" Checked="MapLayerRadRadioButton_Checked">
                                <StackPanel>
                                    <TextBlock Text="일반"/>
                                    <TextBlock Text="지도"/>
                                </StackPanel>
                            </telerik:RadRadioButton>
                            <telerik:RadRadioButton FontSize="14" Cursor="Hand" FontFamily="{StaticResource High1FontFamily}" CornerRadius="0 0 3 3" Tag="vworld_hybrid" Checked="MapLayerRadRadioButton_Checked">
                                <StackPanel>
                                    <TextBlock Text="영상"/>
                                    <TextBlock Text="지도"/>
                                </StackPanel>
                            </telerik:RadRadioButton>
                        </StackPanel>
                    </Border>
                </Grid>

                <!--확대/축소/다운로드-->
                <Grid Grid.Row="3" HorizontalAlignment="Right" Margin="0 0 10 6">
                    <Border Background="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}" BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}" BorderThickness="1" CornerRadius="3">
                        <StackPanel>
                            <telerik:RadButton CornerRadius="3 3 0 0"
                                               Width="50"
                                               Height="44"
                                               Cursor="Hand"
                                               Background="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}"
                                               BorderBrush="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}"
                                               BorderThickness="0"
                                               helpers:ThemeHelper.FocusBrush="Transparent"
                                               telerik:RadToolTipService.ToolTipContentTemplate ="{x:Null}"
                                               telerik:RadToolTipService.Placement ="Left"
                                               telerik:RadToolTipService.HorizontalOffset ="5"
                                               telerik:RadToolTipService.VerticalOffset ="-8"
                                               telerik:RadToolTipService.InitialShowDelay ="0"
                                               telerik:RadToolTipService.ShowDuration ="30000"
                                               Click="ZoomInButton_Click">
                                <telerik:RadButton.Style>
                                    <Style TargetType="telerik:RadButton">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=radMap, Path=Zoom }" Value="20">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </telerik:RadButton.Style>
                                <telerik:RadGlyph Glyph="{StaticResource GlyphPlus}"/>
                                <telerik:RadToolTipService.ToolTipContent>
                                    <telerik:RadCallout Content="확대" Style="{StaticResource TooltipRadCalloutStyle}"/>
                                </telerik:RadToolTipService.ToolTipContent>
                            </telerik:RadButton>

                            <Border>
                                <telerik:RadSlider Value="{Binding ElementName=radMap, Path=Zoom}"
                                                   Maximum="20"
                                                   Minimum="3" 
                                                   IsDirectionReversed="False"
                                                   Orientation="Vertical" 
                                                   TickFrequency="1"
                                                   SmallChange="1"
                                                   LargeChange="1"
                                                   IsMoveToPointEnabled="True"
                                                   MinHeight="80"
                                                   Margin="0 0 0 0"
                                                   HorizontalAlignment="Center"
                                                   BorderThickness="0"
                                                   AutoToolTipPlacement="TopLeft">
                                    <telerik:RadSlider.ThumbToolTipStyle>
                                        <Style TargetType="ToolTip">
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                    </telerik:RadSlider.ThumbToolTipStyle>
                                    <telerik:RadSlider.AutoToolTipContentTemplate>
                                        <DataTemplate>
                                            <telerik:RadCallout ArrowAnchorPoint="1.05, 0.5" ArrowBasePoint1="0.8, 0.2" ArrowBasePoint2="0.6, 1" CalloutType="RoundedRectangle" MinHeight="40" MinWidth="60"
                                                    Background="{telerik:Windows11Resource ResourceKey=FocusInnerBrush}">
                                                <TextBlock Text="{Binding .,  StringFormat=N0}" />
                                            </telerik:RadCallout>
                                        </DataTemplate>
                                    </telerik:RadSlider.AutoToolTipContentTemplate>
                                </telerik:RadSlider>
                            </Border>
                            <telerik:RadButton CornerRadius="0 0 3 3"
                                               Width="50"
                                               Height="44"
                                               BorderThickness="0"
                                               Cursor="Hand"
                                               Background="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}"
                                               BorderBrush="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}"
                                               helpers:ThemeHelper.FocusBrush="Transparent"
                                               telerik:RadToolTipService.ToolTipContentTemplate ="{x:Null}"
                                               telerik:RadToolTipService.Placement ="Left"
                                               telerik:RadToolTipService.HorizontalOffset ="5"
                                               telerik:RadToolTipService.VerticalOffset ="-8"
                                               telerik:RadToolTipService.InitialShowDelay ="0"
                                               telerik:RadToolTipService.ShowDuration ="30000"
                                               Click="ZoomOutButton_Click">
                                <telerik:RadButton.Style>
                                    <Style TargetType="telerik:RadButton">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=radMap, Path=Zoom }" Value="3">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </telerik:RadButton.Style>
                                <telerik:RadGlyph Glyph="{StaticResource GlyphMinus}"/>
                                <telerik:RadToolTipService.ToolTipContent>
                                    <telerik:RadCallout Content="축소" Style="{StaticResource TooltipRadCalloutStyle}"/>
                                </telerik:RadToolTipService.ToolTipContent>
                            </telerik:RadButton>
                        </StackPanel>
                    </Border>
                </Grid>

                <!--거리-->
                <telerik:MapScale Grid.Row="4"
                                  MapControl="{Binding ElementName=radMap}" 
                                  telerik:StyleManager.Theme="Office_Black"
                                  HorizontalAlignment="Right" 
                                  FontSize="14"
                                  Margin="0 0 10 0"
                                  Padding="5 3"
                                  DistanceUnit="Kilometer">
                    <telerik:MapScale.Style>
                        <Style TargetType="maps:MapScale"/>
                    </telerik:MapScale.Style>
                </telerik:MapScale>
            </Grid>
        </Grid>

    </Grid>
</Page>

                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </telerik:RadGlyph.Style>
                            </telerik:RadGlyph>
                        </Grid>
                    </CheckBox>

                    <Border Grid.Row="1" Style="{StaticResource ContentBorderStyle}" 
                            Margin="0 5 0 0"
                            Padding="14 14 14 4"
                            VerticalAlignment="Top" 
                            Visibility="{Binding Path=IsChecked, ElementName=ThemeMapVisibleCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.Resources>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBoxStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Height" Value="{StaticResource DefaultHeight}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Style>
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <telerik:RadButton Content="전체 선택해제" Margin="0 0 0 10" Height="{StaticResource DefaultHeight}" HorizontalAlignment="Right" Click="AllThemeMapUnCheckedRadButton_Click"/>

                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Margin="0 0 -14 0">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Padding" Value="0 0 14 0"/>
                                        <Style.Triggers>
                                            <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Visible">
                                                <Setter Property="Padding" Value="0 0 0 0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <ItemsControl ItemsSource="{Binding Path=ThemeMapCollection}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.Resources>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PrimaryTextBlcokStyle}"/>
                                                </Grid.Resources>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!--체크박스-->
                                                <DockPanel>
                                                    <telerik:RadToggleButton DockPanel.Dock="Right" Content="범례" IsChecked="{Binding Path=IsVisibleLegend, Mode=TwoWay}" Margin="20 0 0 0" Padding="15 5" VerticalAlignment="Center" Cursor="Hand"/>
                                                    <CheckBox DockPanel.Dock="Left" Content="{Binding Path=Caption}" IsChecked="{Binding Path=IsSelected, Mode=TwoWay}" Checked="ThemeMapCheckBox_Checked" Unchecked="ThemeMapCheckBox_Unchecked"/>
                                                </DockPanel>

                                                <!--불투명도-->
                                                <Grid Grid.Row="1" Margin="0 10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="불투명도" FontFamily="{StaticResource High1FontFamily}" Width="80"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Path=Value, ElementName=TransparencyRadSlider, StringFormat={}{0:P0}}" FontFamily="{StaticResource High1FontFamily}" TextAlignment="Right" Width="60" Margin="0 0 10 0"/>
                                                    <telerik:RadSlider x:Name="TransparencyRadSlider"
                                                                       Grid.Column="2"
                                                                       Maximum="1.0"
                                                                       Minimum="0"
                                                                       SmallChange="0.1"
                                                                       LargeChange="0.1"
                                                                       IsMoveToPointEnabled="True"
                                                                       Width="250">
                                                        <telerik:RadSlider.Style>
                                                            <Style TargetType="telerik:RadSlider">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Path=OpacityName}" Value="BiotopesRarityOpacity">
                                                                        <Setter Property="Value" Value="{Binding Path=DataContext.BiotopesRarityOpacity, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}, Mode=TwoWay}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Path=OpacityName}" Value="InvasiveSpeciesOpacity">
                                                                        <Setter Property="Value" Value="{Binding Path=DataContext.InvasiveSpeciesOpacity, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}, Mode=TwoWay}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </telerik:RadSlider.Style>
                                                    </telerik:RadSlider>
                                                </Grid>

                                                <!--범례-->
                                                <Border Grid.Row="2" Visibility="{Binding Path=IsVisibleLegend, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0 10 0 0">
                                                    <telerik:RadGridView x:Name="DataRadGridView"
                                                                         Grid.Column="1"
                                                                         Grid.Row="1"
                                                                         ItemsSource="{Binding Path=ContentSubItems}"
                                                                         BusyIndicatorIsIndeterminate="False"
                                                                         FrozenColumnsSplitterVisibility="Collapsed"
                                                                         LeftFrozenColumnCount="0"
                                                                         IsSynchronizedWithCurrentItem="{x:Null}"
                                                                         CanUserSortColumns="False"
                                                                         CanUserSelect="False"
                                                                         IsReadOnly="True"
                                                                         Width="400"
                                                                         MinHeight="100"
                                                                         HorizontalAlignment="Left"
                                                                         Background="Transparent"
                                                                         IsFilteringAllowed="False"
                                                                         VerticalGridLinesBrush="Transparent">
                                                        <telerik:RadGridView.Columns>
                                                            <telerik:GridViewDataColumn Header="범례" MinWidth="50" Width="50" MaxWidth="50" HeaderCellStyle="{StaticResource NotSortingGridViewHeaderCellStyle}">
                                                                <telerik:GridViewDataColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <Grid>
                                                                            <Rectangle Fill="{Binding Path=MarkerFill}" Stroke="#33000000" StrokeThickness="0.5" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                       Visibility="{Binding Path=IsBiotopesRarity, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                            <Ellipse Fill="{Binding Path=MarkerFill}" Stroke="#33000000" StrokeThickness="0.5" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                     Visibility="{Binding Path=IsInvasiveSpecies, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </telerik:GridViewDataColumn.CellTemplate>
                                                            </telerik:GridViewDataColumn>
                                                            <telerik:GridViewDataColumn Header="등급" DataMemberBinding="{Binding Path=Grade}" MinWidth="80" Width="140" MaxWidth="140" TextWrapping="Wrap" HeaderCellStyle="{StaticResource NotSortingGridViewHeaderCellStyle}" IsVisible="{Binding Path=IsBiotopesRarity}"/>
                                                            <telerik:GridViewDataColumn Header="개수" DataMemberBinding="{Binding Path=Count}" DataFormatString="N0" MinWidth="80" Width="100" MaxWidth="100" HeaderCellStyle="{StaticResource NotSortingGridViewHeaderCellStyle}" CellStyle="{StaticResource GridViewCellRightStyle}" IsVisible="{Binding Path=IsBiotopesRarity}"/>
                                                            <telerik:GridViewDataColumn Header="면적(km²)" DataMemberBinding="{Binding Path=Area}" DataFormatString="F2" MinWidth="80" Width="100" MaxWidth="100" HeaderCellStyle="{StaticResource NotSortingGridViewHeaderCellStyle}" CellStyle="{StaticResource GridViewCellRightStyle}" IsVisible="{Binding Path=IsBiotopesRarity}"/>
                                                            <telerik:GridViewDataColumn Header="교란종" DataMemberBinding="{Binding Path=Grade}" MinWidth="80" Width="240" MaxWidth="240" TextWrapping="Wrap" HeaderCellStyle="{StaticResource NotSortingGridViewHeaderCellStyle}" IsVisible="{Binding Path=IsInvasiveSpecies}"/>
                                                            <telerik:GridViewDataColumn Header="개체수" DataMemberBinding="{Binding Path=Count}" DataFormatString="N0" MinWidth="80" Width="100" MaxWidth="100" HeaderCellStyle="{StaticResource NotSortingGridViewHeaderCellStyle}" CellStyle="{StaticResource GridViewCellRightStyle}" IsVisible="{Binding Path=IsInvasiveSpecies}"/>
                                                        </telerik:RadGridView.Columns>
                                                    </telerik:RadGridView>
                                                </Border>
                                                <Grid Grid.Row="2" Visibility="Collapsed" Margin="0 10 0 0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="32"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Column="0" Text="범례" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="희소성 등급" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="개수" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Column="3" Text="면적(km²)" HorizontalAlignment="Right" Margin="0 0 10 0"/>
                                                </Grid>

                                                <ItemsControl Grid.Row="3" ItemsSource="{Binding Path=ContentSubItems}" Visibility="Collapsed">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="40"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="100"/>
                                                                    <ColumnDefinition Width="110"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="32"/>
                                                                </Grid.RowDefinitions>
                                                                <Rectangle Grid.Column="0" Fill="{Binding Path=MarkerFill}" StrokeThickness="1" Width="20" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Rectangle.Style>
                                                                        <Style TargetType="Rectangle">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Path=Grade}" Value="전체">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Rectangle.Style>
                                                                </Rectangle>
                                                                <TextBlock Grid.Column="1" Text="{Binding Path=Grade}" HorizontalAlignment="Center"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Path=Count, StringFormat={}{0:N0}}" HorizontalAlignment="Right"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding Path=Area, StringFormat={}{0:F2}}" HorizontalAlignment="Right" Margin="0 0 10 0"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Rectangle Grid.Row="4" Style="{StaticResource HorizontalRectangleStyle}" Margin="0 15"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </WrapPanel>

            <!--우측-->
            <Grid HorizontalAlignment="Right" Margin="0 10 0 10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="2" HorizontalAlignment="Right" Margin="0 0 10 6">
                    <Border Background="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}" BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="1" Width="53">
                        <StackPanel>
                            <telerik:RadRadioButton IsChecked="True" FontSize="14" Cursor="Hand" FontFamily="{StaticResource High1FontFamily}" CornerRadius="3 3 0 0" Tag="vworld_road" Checked="MapLayerRadRadioButton_Checked">
                                <StackPanel>
                                    <TextBlock Text="일반"/>
                                    <TextBlock Text="지도"/>
                                </StackPanel>
                            </telerik:RadRadioButton>
                            <telerik:RadRadioButton FontSize="14" Cursor="Hand" FontFamily="{StaticResource High1FontFamily}" CornerRadius="0 0 3 3" Tag="vworld_hybrid" Checked="MapLayerRadRadioButton_Checked">
                                <StackPanel>
                                    <TextBlock Text="영상"/>
                                    <TextBlock Text="지도"/>
                                </StackPanel>
                            </telerik:RadRadioButton>
                        </StackPanel>
                    </Border>
                </Grid>

                <!--확대/축소/다운로드-->
                <Grid Grid.Row="3" HorizontalAlignment="Right" Margin="0 0 10 10">
                    <Border Background="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}" BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}" BorderThickness="1" CornerRadius="3">
                        <StackPanel>
                            <telerik:RadButton CornerRadius="3 3 0 0"
                                               Width="50"
                                               Height="44"
                                               Cursor="Hand"
                                               Background="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}"
                                               BorderBrush="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}"
                                               BorderThickness="0"
                                               helpers:ThemeHelper.FocusBrush="Transparent"
                                               telerik:RadToolTipService.ToolTipContentTemplate ="{x:Null}"
                                               telerik:RadToolTipService.Placement ="Left"
                                               telerik:RadToolTipService.HorizontalOffset ="5"
                                               telerik:RadToolTipService.VerticalOffset ="-8"
                                               telerik:RadToolTipService.InitialShowDelay ="0"
                                               telerik:RadToolTipService.ShowDuration ="30000"
                                               Click="ZoomInButton_Click">
                                <telerik:RadButton.Style>
                                    <Style TargetType="telerik:RadButton">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=radMap, Path=Zoom }" Value="20">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </telerik:RadButton.Style>
                                <telerik:RadGlyph Glyph="{StaticResource GlyphPlus}"/>
                                <telerik:RadToolTipService.ToolTipContent>
                                    <telerik:RadCallout Content="확대" Style="{StaticResource TooltipRadCalloutStyle}"/>
                                </telerik:RadToolTipService.ToolTipContent>
                            </telerik:RadButton>

                            <Border>
                                <telerik:RadSlider Value="{Binding ElementName=radMap, Path=Zoom}"
                                                   Maximum="20"
                                                   Minimum="3" 
                                                   IsDirectionReversed="False"
                                                   Orientation="Vertical" 
                                                   TickFrequency="1"
                                                   SmallChange="1"
                                                   LargeChange="1"
                                                   IsMoveToPointEnabled="True"
                                                   MinHeight="80"
                                                   Margin="0 0 0 0"
                                                   HorizontalAlignment="Center"
                                                   BorderThickness="0"
                                                   AutoToolTipPlacement="TopLeft">
                                    <telerik:RadSlider.ThumbToolTipStyle>
                                        <Style TargetType="ToolTip">
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                    </telerik:RadSlider.ThumbToolTipStyle>
                                    <telerik:RadSlider.AutoToolTipContentTemplate>
                                        <DataTemplate>
                                            <telerik:RadCallout ArrowAnchorPoint="1.05, 0.5" ArrowBasePoint1="0.8, 0.2" ArrowBasePoint2="0.6, 1" CalloutType="RoundedRectangle" MinHeight="40" MinWidth="60"
                                                    Background="{telerik:Windows11Resource ResourceKey=FocusInnerBrush}">
                                                <TextBlock Text="{Binding .,  StringFormat=N0}" />
                                            </telerik:RadCallout>
                                        </DataTemplate>
                                    </telerik:RadSlider.AutoToolTipContentTemplate>
                                </telerik:RadSlider>
                            </Border>
                            <telerik:RadButton CornerRadius="0 0 3 3"
                                               Width="50"
                                               Height="44"
                                               BorderThickness="0"
                                               Cursor="Hand"
                                               Background="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}"
                                               BorderBrush="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}"
                                               helpers:ThemeHelper.FocusBrush="Transparent"
                                               telerik:RadToolTipService.ToolTipContentTemplate ="{x:Null}"
                                               telerik:RadToolTipService.Placement ="Left"
                                               telerik:RadToolTipService.HorizontalOffset ="5"
                                               telerik:RadToolTipService.VerticalOffset ="-8"
                                               telerik:RadToolTipService.InitialShowDelay ="0"
                                               telerik:RadToolTipService.ShowDuration ="30000"
                                               Click="ZoomOutButton_Click">
                                <telerik:RadButton.Style>
                                    <Style TargetType="telerik:RadButton">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=radMap, Path=Zoom }" Value="3">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </telerik:RadButton.Style>
                                <telerik:RadGlyph Glyph="{StaticResource GlyphMinus}"/>
                                <telerik:RadToolTipService.ToolTipContent>
                                    <telerik:RadCallout Content="축소" Style="{StaticResource TooltipRadCalloutStyle}"/>
                                </telerik:RadToolTipService.ToolTipContent>
                            </telerik:RadButton>
                        </StackPanel>
                    </Border>
                </Grid>

                <!--거리-->
                <telerik:MapScale Grid.Row="4"
                                  MapControl="{Binding ElementName=radMap}" 
                                  telerik:StyleManager.Theme="Office_Black"
                                  HorizontalAlignment="Right" 
                                  FontSize="14"
                                  Margin="0 0 10 0"
                                  Padding="5 3"
                                  DistanceUnit="Kilometer">
                    <telerik:MapScale.Style>
                        <Style TargetType="maps:MapScale"/>
                    </telerik:MapScale.Style>
                </telerik:MapScale>
            </Grid>
        </Grid>

        <!--위경도변경-->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0 10 10 10"
                CornerRadius="8"
                Background="White"
                BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"
                BorderThickness="1"
                Visibility="{Binding Path=LatLngChangeViewVisibility}">
            <Grid Margin="20 10 20 20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="0 0 0 20">
                    <TextBlock Text="위경도 변경" Style="{StaticResource PrimaryTitleTextBlcokStyle}"/>
                    <telerik:RadButton HorizontalAlignment="Right" BorderBrush="White" Margin="0 0 -10 0" Command="{Binding Path=LatLngChangeViewCloseExectedCommand}">
                        <telerik:RadGlyph Glyph="{StaticResource GlyphClose}"/>
                    </telerik:RadButton>
                </DockPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <icon:PackIconVaadinIcons Kind="InfoCircleOutline" Margin="0 1 10 0"  Foreground="{telerik:Windows11Resource ResourceKey=AccentBrush}"/>
                    <TextBlock Text="배경 지도에서 우측 버튼을 클릭하면 좌표를 취득 및 복사할 수 있습니다." Style="{StaticResource PrimaryTitleTextBlcokStyle}"/>
                </StackPanel>

                <telerik:RadButton Grid.Row="2" Margin="0 20 0 0" HorizontalAlignment="Left" Command="{Binding Path=LatLngChangeResetExecutedCommand}">
                    <StackPanel Orientation="Horizontal">
                        <telerik:RadGlyph Glyph="{StaticResource GlyphReset}"/>
                        <TextBlock Text="초기화" Margin="5 0 0 0"/>
                    </StackPanel>
                </telerik:RadButton>

                <Rectangle Grid.Row="3" Style="{StaticResource HorizontalRectangleStyle}"/>

                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0 0 0 10">
                    <Border Padding="10 0" Margin="0 0 20 0" Background="#666666" CornerRadius="2" Height="32">
                        <TextBlock Text="위도" Foreground="White" Style="{StaticResource PrimaryTextBlcokStyle}"/>
                    </Border>
                    <TextBlock Text="{Binding Path=BeforeLat, StringFormat={}{0:F6}, TargetNullValue=?, FallbackValue=?}" Style="{StaticResource PrimaryTitleTextBlcokStyle}"/>
                    <telerik:RadGlyph Glyph="{StaticResource GlyphArrow60Right}" Margin="10 0"/>
                    <telerik:RadNumericUpDown Value="{Binding Path=AfterLat}"
                                              UpdateValueEvent="PropertyChanged"
                                              Minimum="0"
                                              NumberDecimalDigits="6"
                                              ShowButtons="False"
                                              Width="170" 
                                              Style="{StaticResource FormDoubleNumericUpDownStyle}"/>

                    <Border Padding="10 0" Margin="30 0 20 0" Background="#666666" CornerRadius="2" Height="32">
                        <TextBlock Text="경도" Foreground="White" Style="{StaticResource PrimaryTextBlcokStyle}"/>
                    </Border>
                    <TextBlock Text="{Binding Path=BeforeLng, StringFormat={}{0:F6}, TargetNullValue=?, FallbackValue=?}" Style="{StaticResource PrimaryTitleTextBlcokStyle}"/>
                    <telerik:RadGlyph Glyph="{StaticResource GlyphArrow60Right}" Margin="10 0"/>
                    <telerik:RadNumericUpDown Value="{Binding Path=AfterLng}"
                                              UpdateValueEvent="PropertyChanged"
                                              Minimum="0"
                                              NumberDecimalDigits="6"
                                              ShowButtons="False"
                                              Width="170" 
                                              Style="{StaticResource FormDoubleNumericUpDownStyle}"/>
                </StackPanel>

                <telerik:RadButton Grid.Row="5" Margin="0 10 0 20" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Click="LatLngChangedSaveRadButton_Click" Command="{Binding Path=LatLngChangedSaveExecutedCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Path=LatLngChangeSelectedItems.Count, StringFormat={}{0:N0}건}"/>
                        <TextBlock Text="일괄 변경 후 자료 및 기능 초기화" Margin="5 0 0 0"/>
                    </StackPanel>
                </telerik:RadButton>

                <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0 0 0 10">
                    <TextBlock Text="전체" Margin="0 0 5 0"/>
                    <TextBlock Text="{Binding Path=Items.Count, Mode=OneWay, ElementName=LatLngChangeRadGridView, StringFormat={}{0:N0}}" Margin="3 0 0 0"/>
                    <TextBlock Text="건" Margin="0 0 5 0"/>
                    <TextBlock Text="/" Margin="5 0"/>
                    <TextBlock Text="선택" Margin="5 0 5 0"/>
                    <TextBlock Text="{Binding Path=LatLngChangeSelectedItems.Count, StringFormat={}{0:N0}}" Margin="3 0 0 0" Foreground="{telerik:Windows11Resource ResourceKey=ValidationBrush}"/>
                    <TextBlock Text="건"/>
                </StackPanel>

                <telerik:RadGridView x:Name="LatLngChangeRadGridView"
                                     Grid.Row="7"
                                     ItemsSource="{Binding Path=LatLngChangeCollection}"
                                     BusyIndicatorContentTemplate="{StaticResource ExportBusyGridViewTemplate}"
                                     BusyIndicatorIsIndeterminate="False"
                                     FrozenColumnsSplitterVisibility="Collapsed"
                                     RowIndicatorVisibility="Collapsed"
                                     LeftFrozenColumnCount="0"
                                     IsFilteringAllowed="False"
                                     IsSynchronizedWithCurrentItem="{x:Null}"
                                     MinHeight="110"
                                     MaxHeight="460"
                                     SelectionMode="Multiple"
                                     CanUserSelect ="False"
                                     SelectionChanged="LatLngChangeRadGridView_SelectionChanged">
                    <telerik:RadGridView.Resources>
                        <Style TargetType="telerik:GridViewRow" BasedOn="{StaticResource GridViewRowStyle}">
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="IsTabStop" Value="False"/>
                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                            <Setter Property="AllowDrop" Value="True"/>
                            <Setter Property="MinHeight" Value="40"/>
                            <Setter Property="MaxHeight" Value="40"/>
                            <Setter Property="SelectedBackground" Value="{x:Null}"/>
                            <Setter Property="MouseOverBackground" Value="{x:Null}"/>
                        </Style>
                        <Style TargetType="telerik:GridViewCell" BasedOn="{StaticResource GridViewCellStyle}">
                            <Setter Property="Padding" Value="7 0"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="15"/>
                        </Style>
                    </telerik:RadGridView.Resources>
                    <telerik:RadGridView.Columns>
                        <telerik:GridViewSelectColumn Width="80" HeaderCheckBoxStyle="{StaticResource HeaderCheckBoxStyle}" HeaderCellStyle="{StaticResource NotSortingGridViewHeaderCellStyle}"/>
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Caption}" MinWidth="80" Width="130" MaxWidth="130"/>
                        <telerik:GridViewDataColumn Header="(연도)차수" DataMemberBinding="{Binding Path=YearChsu}" MinWidth="80" Width="140" MaxWidth="140"/>
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SurveyDate}" DataFormatString="{}{0:yyyy-MM-dd}" MinWidth="80" Width="140" MaxWidth="140"/>
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=River}" MinWidth="80" Width="140" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Site}" MinWidth="80" Width="140" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                    </telerik:RadGridView.Columns>
                </telerik:RadGridView>
            </Grid>
        </Border>
    </Grid>
</Page>

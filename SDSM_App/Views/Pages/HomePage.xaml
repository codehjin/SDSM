<Page x:Class="SDSM_App.Views.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
      xmlns:helpers="clr-namespace:Telerik.Windows.Controls.Theming.Helpers;assembly=Telerik.Windows.Controls"
      xmlns:maps="clr-namespace:Telerik.Windows.Controls.Map;assembly=Telerik.Windows.Controls.DataVisualization"
      xmlns:ani="clr-namespace:SDSM_App.Animations"
      xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:behavior="clr-namespace:SDSM_App.Behaviors"
      xmlns:converter="clr-namespace:SDSM_App.Converters"
      xmlns:common="clr-namespace:SDSM_App.Commons"
      xmlns:viewmodel="clr-namespace:SDSM_App.ViewModels"
      d:DataContext="{d:DesignInstance Type={x:Type viewmodel:HomePageViewModel}}"
      FontFamily="{StaticResource DefaultFontFamily}"
      FontSize="{StaticResource DefaultFontSize}"
      Title="홈">
    <Page.Resources>
        <!--클러스터-->
        <converter:ClusterChildrenToBoolConverter x:Key="ClusterChildrenToBoolConverter" />
        <telerik:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!--클러스터-->
        <DataTemplate x:Key="ClusterTemplate">
            <Grid x:Name="ParentRoot" Width="40" Height="30" Cursor="Hand" telerik:MapLayer.HotSpot="0.5, 0.5" MouseLeftButtonDown="ClusterMouseLeftButtonDown" MouseRightButtonDown="ClusterMouseRightButtonDown">
                <Path Width="{Binding Width,ElementName=ParentRoot}" 
	                  Height="{Binding Height,ElementName=ParentRoot}" 
	                  Stretch="Fill"
                      Data="M978.6509,491.334L958.6109,491.334L954.4549,500.874L949.9999,491.334L930.6259,491.334C928.4169,491.334,926.6259,489.543,926.6259,487.334L926.6259,433.272C926.6259,431.063,928.4169,429.272,930.6259,429.272L978.6509,429.272C980.8599,429.272,982.6509,431.063,982.6509,433.272L982.6509,487.334C982.6509,489.543,980.8599,491.334,978.6509,491.334z" 
	                  StrokeStartLineCap="Flat"
                      StrokeEndLineCap="Flat"
                      Stroke="White"
                      StrokeThickness="1"
                      StrokeMiterLimit="10"
                      StrokeLineJoin="Miter">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Fill" Value="#99000000"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=Children, Converter={StaticResource ClusterChildrenToBoolConverter}}" Value="True">
                                    <Setter Property="Fill" Value="#990078D4"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <StackPanel Margin="5,2,5,5">
                    <TextBlock Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Path=Count}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <Style x:Key="ContentBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=TertiaryBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="10 10 10 0"/>
            <Setter Property="Padding" Value="14 14 14 14"/>
            <Setter Property="CornerRadius" Value="{telerik:Windows11Resource ResourceKey=CornerRadius}"/>
        </Style>
        <Style x:Key="ExpanderCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource CustomCheckBoxStyle}">
            <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}"/>
            <Setter Property="helpers:ThemeHelper.CheckedBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}"/>
            <Setter Property="helpers:ThemeHelper.CheckedBrush" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
            <Setter Property="helpers:ThemeHelper.MouseOverBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}"/>
            <Setter Property="helpers:ThemeHelper.MouseOverBrush" Value="{telerik:Windows11Resource ResourceKey=FocusBrush}"/>
            <Setter Property="Tag" Value="expander"/>
            <Setter Property="IsChecked" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Padding" Value="5 5"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Padding" Value="5 5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CaptionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=FocusInnerBrush}"/>
            <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0 0 0 10"/>
            <Setter Property="Padding" Value="10 13 10 11"/>
            <Setter Property="CornerRadius" Value="{telerik:Windows11Resource ResourceKey=CornerRadius}"/>
        </Style>
        <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource PrimaryTextBlcokStyle}">
            <Setter Property="FontFamily" Value="{StaticResource High1FontFamily}"/>
        </Style>
        <Style x:Key="PointBorderStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="5 3"/>
        </Style>

        <Style x:Key="PointTextBlcokStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource High1FontFamily}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!--조사위치포인트-->
        <DataTemplate x:Key="PointDataTemplate">
            <Border telerik:MapLayer.Location ="{Binding Path=Location}"
                    Cursor="Hand"
                    Padding="2 3 2 2"
                    CornerRadius="3"
                    BorderBrush="{Binding Path=MarkerFill}"
                    BorderThickness="2"
                    MouseLeftButtonDown="Point_MouseLeftButtonDown">
                <telerik:MapLayer.HotSpot>
                    <telerik:HotSpot X="0.5" Y="0.5"/>
                </telerik:MapLayer.HotSpot>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{Binding Path=MarkerFill}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=IsSelected}" Value="True">
                                <Setter Property="Background" Value="#AA000000"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Path=Label}" FontFamily="{StaticResource High1FontFamily}" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=IsSelected}" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>

        <Style x:Key="MapPinCalloutStyle" TargetType="telerik:RadCallout">
            <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=OverlayBrush}"/>
            <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=SecondaryBorderBrush}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="CalloutType" Value="RoundedRectangle"/>
            <Setter Property="ArrowType" Value="Triangle"/>
            <Setter Property="ArrowAnchorPoint" Value="0.5,1.05"/>
            <Setter Property="ArrowBasePoint1" Value="0.35,0.5"/>
            <Setter Property="ArrowBasePoint2" Value="0.65,0.5"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="MinWidth" Value="860"/>
            <Setter Property="Width" Value="860"/>
            <Setter Property="MaxWidth" Value="860"/>
            <Setter Property="Margin" Value="0 0 0 0"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel UseLayoutRounding="True">
                            <Grid Height="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="전체" Margin="0 0 5 0" FontFamily="{StaticResource High1FontFamily}"/>
                                    <TextBlock Text="{Binding Path=Items.Count, Mode=OneWay, ElementName=DataRadGridView, StringFormat={}{0:N0}}" Margin="3 0 0 0" FontFamily="{StaticResource High1FontFamily}" Foreground="{telerik:Windows11Resource ResourceKey=ValidationBrush}"/>
                                    <TextBlock Text="건" Margin="0 0 5 0" FontFamily="{StaticResource High1FontFamily}"/>
                                </StackPanel>
                                <telerik:RadButton Grid.Column="1"
                                                   DockPanel.Dock="Right"
                                                   Cursor="Hand"
                                                   IsBackgroundVisible="False"
                                                   Padding="7 0"
                                                   Height="32"
                                                   Margin="0 -10 0 0"
                                                   VerticalAlignment="Center" 
                                                   HorizontalAlignment="Right"
                                                   helpers:ThemeHelper.MouseOverBrush="{telerik:Windows11Resource ResourceKey=FocusBrush}"
                                                   helpers:ThemeHelper.PressedBrush="Transparent"
                                                   helpers:ThemeHelper.FocusBrush="Transparent"
                                                   Click="MapPinCalloutCloseRadButton_Click">
                                    <telerik:RadGlyph Glyph="&#xe11b;"/>
                                </telerik:RadButton>
                            </Grid>
                            <Grid Margin="0 0 0 0">
                                <telerik:RadGridView x:Name="DataRadGridView"
                                                     ItemsSource="{Binding Path=DataContext.SelectedCollection, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}"
                                                     BusyIndicatorContentTemplate="{StaticResource ExportBusyGridViewTemplate}"
                                                     BusyIndicatorIsIndeterminate="False"
                                                     FrozenColumnsSplitterVisibility="Collapsed"
                                                     RowIndicatorVisibility="Collapsed"
                                                     LeftFrozenColumnCount="0"
                                                     IsFilteringAllowed="False"
                                                     IsSynchronizedWithCurrentItem="{x:Null}"
                                                     MinHeight="100"
                                                     MaxHeight="560">
                                    <telerik:RadGridView.Columns>
                                        <telerik:GridViewDataColumn Header="구분" DataMemberBinding="{Binding Path=Caption}" MinWidth="80" Width="140" MaxWidth="140"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=YearChsu}" MinWidth="80" Width="160" MaxWidth="160"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SurveyDate}" DataFormatString="{}{0:yyyy-MM-dd}" MinWidth="80" Width="160" MaxWidth="160"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=River}" MinWidth="80" Width="160" MaxWidth="160"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Site}" MinWidth="80" Width="160" MaxWidth="160"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SpeciesKo}" MinWidth="80" Width="240" MaxWidth="240" TextWrapping="Wrap" IsVisible="{Binding Path=IsSpecies}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SpeciesEn}" MinWidth="80" Width="480" MaxWidth="480" TextWrapping="Wrap" IsVisible="{Binding Path=IsSpecies}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Lat}" DataFormatString="F6" MinWidth="80" Width="160" MaxWidth="160"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Lng}" DataFormatString="F6" MinWidth="80" Width="160" MaxWidth="160"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Surveyor}" MinWidth="80" Width="180" MaxWidth="180"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=EvaluationScore}" DataFormatString="{}{0:F1}" MinWidth="80" Width="160" MaxWidth="160" IsVisible="{Binding Path=IsHabitatWaterEdge}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=EvaluationGrade}" MinWidth="80" Width="160" MaxWidth="160" IsVisible="{Binding Path=IsHabitatWaterEdge}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=BMIScore}" DataFormatString="{}{0:F1}" MinWidth="80" Width="160" MaxWidth="160" IsVisible="{Binding Path=IsBMI}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=BMIGrade}" MinWidth="80" Width="160" MaxWidth="160" IsVisible="{Binding Path=IsBMI}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=FAIScore}" DataFormatString="{}{0:F1}" MinWidth="80" Width="160" MaxWidth="160" IsVisible="{Binding Path=IsFAI}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=FAIGrade}" MinWidth="80" Width="160" MaxWidth="160" IsVisible="{Binding Path=IsFAI}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SpeciesCount}" MinWidth="80" Width="160" MaxWidth="160" IsVisible="{Binding Path=IsSpeciesCount}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=IndividualCount}" DataFormatString="{}{0:N1}" MinWidth="80" Width="160" MaxWidth="160" IsVisible="{Binding Path=IsIndividualCount}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=PHGrade}" MinWidth="80" Width="160" MaxWidth="160" IsVisible="{Binding Path=IsWaterQuality}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=BODGrade}" MinWidth="80" Width="160" MaxWidth="160" IsVisible="{Binding Path=IsWaterQuality}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=CODGrade}" MinWidth="80" Width="160" MaxWidth="160" IsVisible="{Binding Path=IsWaterQuality}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=TOCGrade}" MinWidth="80" Width="160" MaxWidth="160" IsVisible="{Binding Path=IsWaterQuality}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SSGrade}" MinWidth="80" Width="160" MaxWidth="160" IsVisible="{Binding Path=IsWaterQuality}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=DOGrade}" MinWidth="80" Width="160" MaxWidth="160" IsVisible="{Binding Path=IsWaterQuality}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=TPGrade}" MinWidth="80" Width="160" MaxWidth="160" IsVisible="{Binding Path=IsWaterQuality}"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=EColiGrade}" MinWidth="80" Width="160" MaxWidth="160" IsVisible="{Binding Path=IsWaterQuality}"/>
                                    </telerik:RadGridView.Columns>
                                </telerik:RadGridView>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <telerik:RadMap x:Name="radMap"
                        Language="ko-KR"
                        UseDefaultLayout="False"
                        UseSpringAnimations="False"
                        MinZoomLevel="6"
                        MaxZoomLevel="20"
                        ZoomLevel="12"
                        ZoomStep="1"
                        Zoom="{Binding Path=Zoom, Mode=TwoWay}"
                        Center="{Binding Path=Center, Mode=TwoWay}"
                        MouseClickMode="SelectItem" 
                        ZoomChanged="RadMap_ZoomChanged"
                        MouseRightButtonDown="RadMap_MouseRightButtonDown">
            <telerik:RadContextMenu.ContextMenu>
                <telerik:RadContextMenu IconColumnWidth="0">
                    <telerik:RadMenuItem x:Name="CopyRadMenuItem" Cursor="Hand" Click="CopyRadMenuItem_Click">
                        <telerik:RadMenuItem.Header>
                            <StackPanel>
                                <TextBlock Text="{Binding Path=Degress}" FontSize="15"/>
                                <TextBlock x:Name="CopyTextBlock" Text="복사" FontSize="15"/>
                            </StackPanel>
                        </telerik:RadMenuItem.Header>
                    </telerik:RadMenuItem>
                </telerik:RadContextMenu>
            </telerik:RadContextMenu.ContextMenu>
            <telerik:RadMap.Providers>
                <telerik:EmptyProvider/>
            </telerik:RadMap.Providers>

            <!--조사위치포인트-->
            <telerik:VisualizationLayer x:Name="PointVisualizationLayer"
                                        ItemsSource="{Binding Path=PointCollection}"
                                        ClusteringEnabled="True"
                                        AutoCalculateClusteringThreshold="False"
                                        ClusteringEnabledThreshold ="13"
                                        ClusterItemTemplate="{StaticResource ClusterTemplate}"
                                        ItemTemplate="{StaticResource PointDataTemplate}"/>
        </telerik:RadMap>

        <Grid>

            <!--상단-->
            <WrapPanel>
                <!--조사자료-->
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="SurveyDataVisibleCheckBox" HorizontalContentAlignment="Stretch" Style="{StaticResource ExpanderCheckBoxStyle}" Width="220">
                        <Grid Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="조사자료" Margin="5 8 0 0" FontFamily="{StaticResource High1FontFamily}"/>
                            <telerik:RadGlyph Grid.Column="1">
                                <telerik:RadGlyph.Style>
                                    <Style TargetType="telerik:RadGlyph">
                                        <Setter Property="Glyph" Value="{StaticResource GlyphArrowChevronDown}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=CheckBox}}" Value="True">
                                                <Setter Property="Glyph" Value="{StaticResource GlyphArrowChevronUp}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </telerik:RadGlyph.Style>
                            </telerik:RadGlyph>
                        </Grid>
                    </CheckBox>

                    <Border x:Name="SurveyDataLayout" Grid.Row="1" Style="{StaticResource ContentBorderStyle}" Margin="0 5 0 0" Width="220" Visibility="{Binding Path=IsChecked, ElementName=SurveyDataVisibleCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBoxStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Height" Value="{StaticResource DefaultHeight}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Style>
                            </StackPanel.Resources>

                            <telerik:RadButton Content="전체 선택해제" Margin="0 0 0 10" Height="{StaticResource DefaultHeight}" HorizontalAlignment="Right" Command="{Binding Path=AllClearPointExecutedCommand}"/>

                            <ItemsControl ItemsSource="{Binding Path=SurveyDataCollection}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Path=IsSelected, Mode=TwoWay}"
                                                  Margin="0 0 0 5"
                                                  Command="{Binding Path=DataContext.AddAndRemovePointExecutedCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}" 
                                                  CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding Path=Caption}"/>
                                                <Rectangle Grid.Column="1" Fill="{Binding Path=MarkerFill}" Width="20" Height="18" Margin="10 0 0 0" RadiusX="3" RadiusY="3"/>
                                            </Grid>
                                        </CheckBox>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </WrapPanel>

            <!--우측-->
            <Grid HorizontalAlignment="Right" Margin="0 10 0 10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="2" HorizontalAlignment="Right" Margin="0 0 10 6">
                    <Border Background="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}" BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="1" Width="53">
                        <StackPanel>
                            <telerik:RadRadioButton IsChecked="True" FontSize="14" Cursor="Hand" FontFamily="{StaticResource High1FontFamily}" CornerRadius="3 3 0 0" Tag="vworld_road" Checked="MapLayerRadRadioButton_Checked">
                                <StackPanel>
                                    <TextBlock Text="일반"/>
                                    <TextBlock Text="지도"/>
                                </StackPanel>
                            </telerik:RadRadioButton>
                            <telerik:RadRadioButton FontSize="14" Cursor="Hand" FontFamily="{StaticResource High1FontFamily}" CornerRadius="0 0 3 3" Tag="vworld_hybrid" Checked="MapLayerRadRadioButton_Checked">
                                <StackPanel>
                                    <TextBlock Text="영상"/>
                                    <TextBlock Text="지도"/>
                                </StackPanel>
                            </telerik:RadRadioButton>
                        </StackPanel>
                    </Border>
                </Grid>

                <!--확대/축소/다운로드-->
                <Grid Grid.Row="3" HorizontalAlignment="Right" Margin="0 0 10 6">
                    <Border Background="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}" BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}" BorderThickness="1" CornerRadius="3">
                        <StackPanel>
                            <telerik:RadButton CornerRadius="3 3 0 0"
                                               Width="50"
                                               Height="44"
                                               Cursor="Hand"
                                               Background="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}"
                                               BorderBrush="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}"
                                               BorderThickness="0"
                                               helpers:ThemeHelper.FocusBrush="Transparent"
                                               telerik:RadToolTipService.ToolTipContentTemplate ="{x:Null}"
                                               telerik:RadToolTipService.Placement ="Left"
                                               telerik:RadToolTipService.HorizontalOffset ="5"
                                               telerik:RadToolTipService.VerticalOffset ="-8"
                                               telerik:RadToolTipService.InitialShowDelay ="0"
                                               telerik:RadToolTipService.ShowDuration ="30000"
                                               Click="ZoomInButton_Click">
                                <telerik:RadButton.Style>
                                    <Style TargetType="telerik:RadButton">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=radMap, Path=Zoom }" Value="20">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </telerik:RadButton.Style>
                                <telerik:RadGlyph Glyph="{StaticResource GlyphPlus}"/>
                                <telerik:RadToolTipService.ToolTipContent>
                                    <telerik:RadCallout Content="확대" Style="{StaticResource TooltipRadCalloutStyle}"/>
                                </telerik:RadToolTipService.ToolTipContent>
                            </telerik:RadButton>

                            <Border>
                                <telerik:RadSlider Value="{Binding ElementName=radMap, Path=Zoom}"
                                                   Maximum="18"
                                                   Minimum="6" 
                                                   IsDirectionReversed="False"
                                                   Orientation="Vertical" 
                                                   TickFrequency="1"
                                                   SmallChange="1"
                                                   LargeChange="1"
                                                   IsMoveToPointEnabled="True"
                                                   MinHeight="80"
                                                   Margin="0 0 0 0"
                                                   HorizontalAlignment="Center"
                                                   BorderThickness="0"
                                                   AutoToolTipPlacement="TopLeft">
                                    <telerik:RadSlider.ThumbToolTipStyle>
                                        <Style TargetType="ToolTip">
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                    </telerik:RadSlider.ThumbToolTipStyle>
                                    <telerik:RadSlider.AutoToolTipContentTemplate>
                                        <DataTemplate>
                                            <telerik:RadCallout ArrowAnchorPoint="1.05, 0.5" ArrowBasePoint1="0.8, 0.2" ArrowBasePoint2="0.6, 1" CalloutType="RoundedRectangle" MinHeight="40" MinWidth="60"
                                                    Background="{telerik:Windows11Resource ResourceKey=FocusInnerBrush}">
                                                <TextBlock Text="{Binding .,  StringFormat=N0}" />
                                            </telerik:RadCallout>
                                        </DataTemplate>
                                    </telerik:RadSlider.AutoToolTipContentTemplate>
                                </telerik:RadSlider>
                            </Border>
                            <telerik:RadButton CornerRadius="0 0 3 3"
                                               Width="50"
                                               Height="44"
                                               BorderThickness="0"
                                               Cursor="Hand"
                                               Background="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}"
                                               BorderBrush="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}"
                                               helpers:ThemeHelper.FocusBrush="Transparent"
                                               telerik:RadToolTipService.ToolTipContentTemplate ="{x:Null}"
                                               telerik:RadToolTipService.Placement ="Left"
                                               telerik:RadToolTipService.HorizontalOffset ="5"
                                               telerik:RadToolTipService.VerticalOffset ="-8"
                                               telerik:RadToolTipService.InitialShowDelay ="0"
                                               telerik:RadToolTipService.ShowDuration ="30000"
                                               Click="ZoomOutButton_Click">
                                <telerik:RadButton.Style>
                                    <Style TargetType="telerik:RadButton">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=radMap, Path=Zoom }" Value="6">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </telerik:RadButton.Style>
                                <telerik:RadGlyph Glyph="{StaticResource GlyphMinus}"/>
                                <telerik:RadToolTipService.ToolTipContent>
                                    <telerik:RadCallout Content="축소" Style="{StaticResource TooltipRadCalloutStyle}"/>
                                </telerik:RadToolTipService.ToolTipContent>
                            </telerik:RadButton>
                        </StackPanel>
                    </Border>
                </Grid>

                <!--거리-->
                <telerik:MapScale Grid.Row="4"
                                  MapControl="{Binding ElementName=radMap}" 
                                  telerik:StyleManager.Theme="Office_Black"
                                  HorizontalAlignment="Right" 
                                  FontSize="14"
                                  Margin="0 0 10 0"
                                  Padding="5 3"
                                  DistanceUnit="Kilometer">
                    <telerik:MapScale.Style>
                        <Style TargetType="maps:MapScale"/>
                    </telerik:MapScale.Style>
                </telerik:MapScale>
            </Grid>
        </Grid>

    </Grid>
</Page>

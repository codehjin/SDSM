<Page x:Class="SDSM_App.Views.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
      xmlns:helpers="clr-namespace:Telerik.Windows.Controls.Theming.Helpers;assembly=Telerik.Windows.Controls"
      xmlns:maps="clr-namespace:Telerik.Windows.Controls.Map;assembly=Telerik.Windows.Controls.DataVisualization"
      xmlns:ani="clr-namespace:SDSM_App.Animations"
      xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:properties="clr-namespace:SDSM_App.Properties"
      xmlns:behavior="clr-namespace:SDSM_App.Behaviors"
      xmlns:converter="clr-namespace:SDSM_App.Converters"
      xmlns:common="clr-namespace:SDSM_App.Commons"
      xmlns:viewmodel="clr-namespace:SDSM_App.ViewModels"
      d:DataContext="{d:DesignInstance Type={x:Type viewmodel:HomePageViewModel}}"
      FontFamily="{StaticResource DefaultFontFamily}"
      FontSize="{StaticResource DefaultFontSize}"
      Title="홈">
    <Page.Resources>

        <converter:StringToBrushConverter x:Key="StringToBrushConverter" />
        <converter:BackgroundStringToForegroundConverter x:Key="BackgroundStringToForegroundConverter"/>
        <converter:MultiBindingValueConverter x:Key="MultiBindingValueConverter"/>

        <converter:CommaSplitConverter x:Key="CommaSplitConverter"/>
        <behavior:AutoCompleteBoxFilteringBehavior x:Key="AutoCompleteBoxFilteringBehavior"/>

        <!--클러스터-->
        <converter:ClusterChildrenToBoolConverter x:Key="ClusterChildrenToBoolConverter" />
        <telerik:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!--클러스터-->
        <DataTemplate x:Key="ClusterTemplate">
            <Grid x:Name="ParentRoot" Width="40" Height="30" Cursor="Hand" telerik:MapLayer.HotSpot="0.5, 0.5" MouseLeftButtonDown="ClusterMouseLeftButtonDown" MouseRightButtonDown="ClusterMouseRightButtonDown">
                <Path Width="{Binding Width,ElementName=ParentRoot}" 
	                  Height="{Binding Height,ElementName=ParentRoot}" 
	                  Stretch="Fill"
                      Data="M978.6509,491.334L958.6109,491.334L954.4549,500.874L949.9999,491.334L930.6259,491.334C928.4169,491.334,926.6259,489.543,926.6259,487.334L926.6259,433.272C926.6259,431.063,928.4169,429.272,930.6259,429.272L978.6509,429.272C980.8599,429.272,982.6509,431.063,982.6509,433.272L982.6509,487.334C982.6509,489.543,980.8599,491.334,978.6509,491.334z" 
	                  StrokeStartLineCap="Flat"
                      StrokeEndLineCap="Flat"
                      Stroke="White"
                      StrokeThickness="1"
                      StrokeMiterLimit="10"
                      StrokeLineJoin="Miter">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Fill" Value="#99000000"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=Children, Converter={StaticResource ClusterChildrenToBoolConverter}}" Value="True">
                                    <Setter Property="Fill" Value="#990078D4"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <StackPanel Margin="5,2,5,5">
                    <TextBlock Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Path=Count}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <Style x:Key="ContentBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=TertiaryBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="10 10 10 0"/>
            <Setter Property="Padding" Value="14 14 14 14"/>
            <Setter Property="CornerRadius" Value="{telerik:Windows11Resource ResourceKey=CornerRadius}"/>
        </Style>
        <Style x:Key="ExpanderCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource CustomCheckBoxStyle}">
            <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}"/>
            <Setter Property="helpers:ThemeHelper.CheckedBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}"/>
            <Setter Property="helpers:ThemeHelper.CheckedBrush" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
            <Setter Property="helpers:ThemeHelper.MouseOverBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=PrimarySolidBackgroundBrush}"/>
            <Setter Property="helpers:ThemeHelper.MouseOverBrush" Value="{telerik:Windows11Resource ResourceKey=FocusBrush}"/>
            <Setter Property="Tag" Value="expander"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Padding" Value="5 5"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Padding" Value="5 5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CaptionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=FocusInnerBrush}"/>
            <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0 0 0 10"/>
            <Setter Property="Padding" Value="10 13 10 11"/>
            <Setter Property="CornerRadius" Value="{telerik:Windows11Resource ResourceKey=CornerRadius}"/>
        </Style>
        <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource PrimaryTextBlcokStyle}">
            <Setter Property="FontFamily" Value="{StaticResource High1FontFamily}"/>
        </Style>
        <Style x:Key="PointBorderStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="5 3"/>
        </Style>

        <Style x:Key="PointTextBlcokStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource High1FontFamily}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!--조사위치포인트-->
        <DataTemplate x:Key="PointDataTemplate">
            <Border telerik:MapLayer.Location ="{Binding Path=Location}"
                    Cursor="Hand"
                    Padding="5"
                    CornerRadius="3"
                    BorderBrush="#33000000"
                    BorderThickness="0 0 2 2"
                    MouseLeftButtonDown="Point_MouseLeftButtonDown">
                <telerik:MapLayer.HotSpot>
                    <telerik:HotSpot X="0.5" Y="0.5"/>
                </telerik:MapLayer.HotSpot>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=Division}" Value="방_어">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=FishDischargeColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Division}" Value="방_저">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=BenthosDischargeColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Division}" Value="방_조">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=BirdDischargeColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Division}" Value="방_포">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=MammalDischargeColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Division}" Value="방_양">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=AmphibianReptileDischargeColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Division}" Value="방_식물">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=PlantDischargeColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Division}" Value="방_식생">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=VegetationDischargeColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Division}" Value="방_서">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=HabitatWaterEdgeDischargeColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Division}" Value="방_수">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=WaterQualityDischargeColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Division}" Value="생_어">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=FishEcologyColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Division}" Value="생_저">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=BenthosEcologyColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Division}" Value="생_조">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=BirdEcologyColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Division}" Value="생_포">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=MammalEcologyColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Division}" Value="생_양">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=AmphibianReptileEcologyColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Division}" Value="생_식물">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=PlantEcologyColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Division}" Value="생_식생">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=VegetationEcologyColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Division}" Value="생_서">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=HabitatWaterEdgeEcologyColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Path=Division}" Value="생_수">
                                <Setter Property="Background" Value="{Binding Source={x:Static properties:Settings.Default}, Path=WaterQualityEcologyColor, Converter={StaticResource StringToBrushConverter}}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Path=Label}" FontFamily="{StaticResource High1FontFamily}" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=Division}" Value="방_어">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=FishDischargeColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Division}" Value="방_저">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=BenthosDischargeColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Division}" Value="방_조">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=BirdDischargeColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Division}" Value="방_포">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=MammalDischargeColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Division}" Value="방_식물">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=PlantDischargeColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Division}" Value="방_식생">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=VegetationDischargeColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Division}" Value="방_양">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=AmphibianReptileDischargeColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Division}" Value="방_서">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=HabitatWaterEdgeDischargeColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Division}" Value="방_수">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=WaterQualityDischargeColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Division}" Value="생_어">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=FishEcologyColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Division}" Value="생_저">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=BenthosEcologyColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Division}" Value="생_조">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=BirdEcologyColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Division}" Value="생_포">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=MammalEcologyColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Division}" Value="생_식물">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=PlantEcologyColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Division}" Value="생_식생">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=VegetationEcologyColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Division}" Value="생_양">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=AmphibianReptileEcologyColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Division}" Value="생_서">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=HabitatWaterEdgeEcologyColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=Division}" Value="생_수">
                                    <Setter Property="Foreground" Value="{Binding Source={x:Static properties:Settings.Default}, Path=WaterQualityEcologyColor, Converter={StaticResource BackgroundStringToForegroundConverter}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>

        <Style x:Key="MapPinCalloutStyle" TargetType="telerik:RadCallout">
            <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=OverlayBrush}"/>
            <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=SecondaryBorderBrush}"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="CalloutType" Value="RoundedRectangle"/>
            <Setter Property="ArrowType" Value="Triangle"/>
            <Setter Property="ArrowAnchorPoint" Value="0.5,1.05"/>
            <Setter Property="ArrowBasePoint1" Value="0.35,0.5"/>
            <Setter Property="ArrowBasePoint2" Value="0.65,0.5"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="MinWidth" Value="1400"/>
            <Setter Property="Width" Value="1400"/>
            <Setter Property="MaxWidth" Value="1400"/>
            <Setter Property="Margin" Value="0 0 0 0"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel UseLayoutRounding="True">
                            <Grid Margin="0 0 0 10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Height="{StaticResource DefaultHeight}">
                                    <StackPanel.Resources>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PrimaryTextBlcokStyle}">
                                            <Setter Property="FontFamily" Value="{StaticResource High1FontFamily}"/>
                                        </Style>
                                    </StackPanel.Resources>
                                    <TextBlock Text="전체" Margin="0 0 5 0"/>
                                    <TextBlock Text="{Binding Path=Items.Count, Mode=OneWay, ElementName=DataRadGridView, StringFormat={}{0:N0}}" Margin="3 0 0 0" Foreground="{telerik:Windows11Resource ResourceKey=ValidationBrush}"/>
                                    <TextBlock Text="건" Margin="0 0 20 0"/>
                                    <TextBlock Text="{Binding Path=Location.Latitude, StringFormat=({0:F6}}"/>
                                    <TextBlock Text="," Margin="2 0 10 5" FontFamily="{StaticResource DefaultFontFamily}"/>
                                    <TextBlock Text="{Binding Path=Location.Longitude, StringFormat={}{0:F6})}"/>
                                    <telerik:RadButton Margin="20 0 0 0" Height="36" Click="LatLngChangeViewOpenRadButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <telerik:RadGlyph Glyph="{StaticResource GlyphEdit}"/>
                                            <TextBlock Text="위경도 변경" Margin="5 0 0 0" FontFamily="{StaticResource DefaultFontFamily}"/>
                                        </StackPanel>
                                    </telerik:RadButton>
                                    <telerik:RadButton Margin="10 0 0 0" Height="36" Click="AllCopyRadButton_Click">
                                        <telerik:RadButton.Tag>
                                            <MultiBinding Converter="{StaticResource MultiBindingValueConverter}">
                                                <Binding ElementName="DataRadGridView"/>
                                                <Binding ElementName="CopyTextBlock"/>
                                            </MultiBinding>
                                        </telerik:RadButton.Tag>
                                        <StackPanel Orientation="Horizontal">
                                            <telerik:RadGlyph Glyph="{StaticResource GlyphCopy}"/>
                                            <TextBlock x:Name="CopyTextBlock" Text="목록 복사" Margin="5 0 0 0" FontFamily="{StaticResource DefaultFontFamily}"/>
                                        </StackPanel>
                                    </telerik:RadButton>
                                </StackPanel>
                                <telerik:RadButton Grid.Column="1"
                                                   DockPanel.Dock="Right"
                                                   Cursor="Hand"
                                                   IsBackgroundVisible="False"
                                                   Padding="7 0"
                                                   Height="32"
                                                   Margin="0 -10 0 0"
                                                   VerticalAlignment="Center" 
                                                   HorizontalAlignment="Right"
                                                   helpers:ThemeHelper.MouseOverBrush="{telerik:Windows11Resource ResourceKey=FocusBrush}"
                                                   helpers:ThemeHelper.PressedBrush="Transparent"
                                                   helpers:ThemeHelper.FocusBrush="Transparent"
                                                   Click="MapPinCalloutCloseRadButton_Click">
                                    <telerik:RadGlyph Glyph="&#xe11b;"/>
                                </telerik:RadButton>
                            </Grid>
                            <Grid Margin="0 0 0 0">
                                <telerik:RadGridView x:Name="DataRadGridView"
                                                     ItemsSource="{Binding Path=DataContext.PopupPointCollection, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Page}}"
                                                     BusyIndicatorContentTemplate="{StaticResource ExportBusyGridViewTemplate}"
                                                     BusyIndicatorIsIndeterminate="False"
                                                     FrozenColumnsSplitterVisibility="Collapsed"
                                                     RowIndicatorVisibility="Collapsed"
                                                     LeftFrozenColumnCount="0"
                                                     IsFilteringAllowed="False"
                                                     IsSynchronizedWithCurrentItem="{x:Null}"
                                                     MinHeight="110"
                                                     MaxHeight="450">
                                    <telerik:RadGridView.Resources>
                                        <Style TargetType="telerik:GridViewRow" BasedOn="{StaticResource GridViewRowStyle}">
                                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="IsTabStop" Value="False"/>
                                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                                            <Setter Property="AllowDrop" Value="True"/>
                                            <Setter Property="MinHeight" Value="40"/>
                                            <Setter Property="MaxHeight" Value="40"/>
                                            <Setter Property="SelectedBackground" Value="{x:Null}"/>
                                            <Setter Property="MouseOverBackground" Value="{x:Null}"/>
                                        </Style>
                                        <Style TargetType="telerik:GridViewCell" BasedOn="{StaticResource GridViewCellStyle}">
                                            <Setter Property="Padding" Value="7 0"/>
                                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="FontSize" Value="15"/>
                                        </Style>
                                        <Style x:Key="SubGridViewCellStyle" TargetType="telerik:GridViewCell" BasedOn="{StaticResource GridViewCellStyle}">
                                            <Setter Property="Padding" Value="7 0"/>
                                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                            <Setter Property="FontSize" Value="15"/>
                                            <Setter Property="telerik:RadToolTipService.ToolTipContentTemplate" Value="{x:Null}"/>
                                            <Setter Property="telerik:RadToolTipService.Placement" Value="Bottom"/>
                                            <Setter Property="telerik:RadToolTipService.HorizontalOffset" Value="0"/>
                                            <Setter Property="telerik:RadToolTipService.VerticalOffset" Value="0"/>
                                            <Setter Property="telerik:RadToolTipService.InitialShowDelay" Value="0"/>
                                            <Setter Property="telerik:RadToolTipService.ShowDuration" Value="30000"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="telerik:RadToolTipService.ToolTipContent">
                                                        <Setter.Value>
                                                            <telerik:RadCallout CalloutType="RoundedRectangle"
                                                                                ArrowType="None"
                                                                                MinWidth="40"
                                                                                MinHeight="40"
                                                                                Margin="0"
                                                                                Padding="10 10 0 10"
                                                                                FontSize="15"
                                                                                BorderBrush="#333333"
                                                                                Background="#333333"
                                                                                Foreground="White"
                                                                                TextWrapping="Wrap"
                                                                                TextAlignment="Left">
                                                                <ItemsControl ItemsSource="{Binding Path=SubSpeciesData}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <UniformGrid Columns="2"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{Binding Path=Name}" Margin="0 0 10 0"/>
                                                                                <TextBlock Grid.Column="2" Text="{Binding Path=Value}" Margin="0 0 15 0"/>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </telerik:RadCallout>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </telerik:RadGridView.Resources>
                                    <telerik:RadGridView.Columns>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Caption}" MinWidth="80" MaxWidth="120"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Project}" MinWidth="80" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Workplace}" MinWidth="80" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=WorkplaceRiver}" MinWidth="80" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                        <telerik:GridViewDataColumn Header="(연도)차수" DataMemberBinding="{Binding Path=YearChsu}" MinWidth="80" MaxWidth="140"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=SurveyDate}" DataFormatString="{}{0:yyyy-MM-dd}" MinWidth="80" MaxWidth="140"/>
                                        <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=River}" MinWidth="80" MaxWidth="140" TextTrimming="CharacterEllipsis"/>

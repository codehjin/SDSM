<Page x:Class="SDSM_App.Views.Pages.SettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
      xmlns:helpers="clr-namespace:Telerik.Windows.Controls.Theming.Helpers;assembly=Telerik.Windows.Controls"
      xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:uc="clr-namespace:SDSM_App.Views.UserControls"
      xmlns:common="clr-namespace:SDSM_App.Commons"
      xmlns:viewmodel="clr-namespace:SDSM_App.ViewModels"
      d:DataContext="{d:DesignInstance Type={x:Type viewmodel:SettingPageViewModel}}"
      FontFamily="{StaticResource DefaultFontFamily}"
      FontSize="{StaticResource DefaultFontSize}"
      Title="일괄등록">
    <Page.Resources>
        
    </Page.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--타이틀-->
            <StackPanel Style="{StaticResource TitleStackPanelStyle}"  MaxWidth="{StaticResource ContentXSmallMaxWidth}">
                <TextBlock Text="설정" Style="{StaticResource TitleTextBlockStyle}"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Margin="0 0 5 0">
                <StackPanel  Grid.Row="1" Margin="30"  MaxWidth="{StaticResource ContentXSmallMaxWidth}">

                    <!--프로젝트별 지점목록-->
                    <TextBlock Text="프로젝트 사업장 지점" Style="{StaticResource SubTitleTextBlcokStyle}" Margin="0 0 0 10"/>
                    <Border Style="{StaticResource ContentBoxStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>

                                <Grid Height="{StaticResource DefaultHeight}" Margin="0 0 0 10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Path=SiteDivisionTitle}" Margin="5 0 10 0" Style="{StaticResource PrimaryTitleTextBlcokStyle}"/>
                                    <TextBlock Grid.Column="1" Text="※" Style="{StaticResource PrimaryTitleTextBlcokStyle}" Margin="0 0 5 0"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource PrimaryTitleTextBlcokStyle}">
                                        <Run Text="지점명 : " Foreground="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                                        <Run Text="하천명" Foreground="{telerik:Windows11Resource ResourceKey=AccentBrush}"/>
                                        <Run Text=" 이외" Foreground="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                                        <Run Text="숫자 등 " Foreground="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                                        <Run Text="제외" Foreground="{telerik:Windows11Resource ResourceKey=ValidationBrush}"/>
                                    </TextBlock>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Style="{StaticResource FormStackPanelStyle}">
                                        <Border Style="{StaticResource FormLabelBorderStyle}" Width="151">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="사업장" Style="{StaticResource FormLabelStyle}" />
                                                <TextBlock Text="*" Style="{StaticResource FormLabelRequiredStyle}" />
                                            </StackPanel>
                                        </Border>
                                        <telerik:RadWatermarkTextBox Text="{Binding Path=Workplace, UpdateSourceTrigger=PropertyChanged}" 
                                                                     Width="{StaticResource FormControlWidth}" 
                                                                     Style="{StaticResource FormWatermarkTextBoxStyle}" 
                                                                     LostFocus="EmptyClear_LostFocus"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FormStackPanelStyle}">
                                        <Border Style="{StaticResource FormLabelBorderStyle}" Width="151">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="과업 대표하천" Style="{StaticResource FormLabelStyle}" />
                                                <TextBlock Text="*" Style="{StaticResource FormLabelRequiredStyle}" />
                                            </StackPanel>
                                        </Border>
                                        <telerik:RadWatermarkTextBox Text="{Binding Path=WorkplaceRiver, UpdateSourceTrigger=PropertyChanged}" 
                                                                     Width="{StaticResource FormControlWidth}" 
                                                                     Style="{StaticResource FormWatermarkTextBoxStyle}" 
                                                                     LostFocus="EmptyClear_LostFocus"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FormStackPanelStyle}">
                                        <Border Style="{StaticResource FormLabelBorderStyle}" Width="151">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="지점명" Style="{StaticResource FormLabelStyle}" />
                                                <TextBlock Text="*" Style="{StaticResource FormLabelRequiredStyle}" />
                                            </StackPanel>
                                        </Border>
                                        <telerik:RadWatermarkTextBox Text="{Binding Path=WorkplaceSite, UpdateSourceTrigger=PropertyChanged}" 
                                                                     Width="{StaticResource FormControlWidth}" 
                                                                     WatermarkContent="최저 2자 ~ 최대 20자"
                                                                     Style="{StaticResource FormWatermarkTextBoxStyle}" 
                                                                     LostFocus="EmptyClear_LostFocus"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0 20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="※ 수정 내용이 저장이 되면 모든 자료에 일괄 적용됩니다." 
                                               Foreground="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}" 
                                               TextTrimming="CharacterEllipsis" 
                                               Style="{StaticResource PrimaryTitleTextBlcokStyle}"
                                               Visibility="{Binding Path=IsEdit, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <telerik:RadButton Grid.Column="1" Content="저장" Width="120" Style="{StaticResource AccentButtonStyle}" Command="{Binding Path=SiteDivisionSaveExecutedCommand}"/>
                                    <telerik:RadButton Grid.Column="2" Content="초기화" HorizontalAlignment="Right" Command="{Binding Path=SiteDivisionRestExecutedCommand}" />
                                </Grid>
                                   
                            </StackPanel>
                            
                            <!--기본정보 목록-->
                            <telerik:RadGridView x:Name="DataRadGridView"
                                                 Grid.Row="1"
                                                 ItemsSource="{Binding Path=SiteDivisionCollection}"
                                                 SelectedItem="{Binding Path=SiteDivisionSelectedItem}"
                                                 HeaderRowStyle="{StaticResource CustomRadGridViewHeaderRowStyle}"
                                                 BusyIndicatorContentTemplate="{StaticResource ExportBusyGridViewTemplate}"
                                                 BusyIndicatorIsIndeterminate="False"
                                                 FrozenColumnsSplitterVisibility="Collapsed"
                                                 RowIndicatorVisibility="Visible"
                                                 LeftFrozenColumnCount="0"
                                                 MinHeight="110"
                                                 MaxHeight="460">
                                <telerik:RadGridView.Columns>
                                    <telerik:GridViewDataColumn Header="수정" HeaderCellStyle="{StaticResource NotSortingGridViewHeaderCellStyle}">
                                        <telerik:GridViewDataColumn.CellTemplate>
                                            <DataTemplate>
                                                <telerik:RadButton MinWidth="60" MinHeight="32" Margin="0" PreviewMouseDown="EditRadButton_PreviewMouseDown" Style="{StaticResource EditButtonStyle}">
                                                    <telerik:RadGlyph Glyph="{StaticResource GlyphEdit}"/>
                                                </telerik:RadButton>
                                            </DataTemplate>
                                        </telerik:GridViewDataColumn.CellTemplate>
                                    </telerik:GridViewDataColumn>
                                    <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Project}" MinWidth="80" Width="*" MaxWidth="460" IsFilterable="False"/>
                                    <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=Workplace}" MinWidth="80" Width="*" MaxWidth="460"/>
                                    <telerik:GridViewDataColumn Header="과업 대표하천" DataMemberBinding="{Binding Path=WorkplaceRiver}" MinWidth="80" Width="*" MaxWidth="460"/>
                                    <telerik:GridViewDataColumn DataMemberBinding="{Binding Path=WorkplaceSite}" MinWidth="80" Width="*" MaxWidth="460"/>
                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</Page>

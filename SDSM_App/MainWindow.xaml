                                                                <DataTrigger Binding="{Binding Path=IsOpen, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadDropDownButton}}" Value="True">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="45" Duration="0:0:0.15"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.15"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </telerik:RadGlyph.Style>
                                                </telerik:RadGlyph>
                                            </Grid>
                                        </telerik:RadDropDownButton.Content>
                                        <telerik:RadDropDownButton.DropDownContent>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <UniformGrid Columns="2" Margin="20 20 20 0">
                                                    <!--로그아웃-->
                                                    <telerik:RadButton Height="{StaticResource DefaultHeight}" Margin="0 0 5 0" Click="LogoutButton_Click">
                                                        <StackPanel Orientation="Horizontal" >
                                                            <TextBlock Text="로그아웃" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 10 0"/>
                                                            <icon:PackIconVaadinIcons Kind="SignOut" Foreground="{telerik:Windows11Resource ResourceKey=IconBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </telerik:RadButton>
                                                    <!--화면잠금-->
                                                    <telerik:RadButton Height="{StaticResource DefaultHeight}" Margin="5 0 0 0" Click="ScreenLockRadButton_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="화면잠금" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 10 0"/>
                                                            <icon:PackIconMaterial Kind="MonitorLock" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </telerik:RadButton>
                                                </UniformGrid>

                                                <Rectangle Grid.Row="1" Style="{StaticResource HorizontalRectangleStyle}" Margin="20"/>

                                                <ContentControl x:Name="PasswordChangeContentControl" Grid.Row="2" IsTabStop="False" Margin="20 0 20 20"/>
                                            </Grid>
                                        </telerik:RadDropDownButton.DropDownContent>
                                    </telerik:RadDropDownButton>
                                </Grid>
                            </Border>

                            <!--메뉴-->
                            <ScrollViewer x:Name="MenuScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="VerticalScrollBarVisibility" Value="Visible"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <!--주메뉴-->
                                <StackPanel Margin="0 0 0 20" >
                                    <StackPanel.Resources>
                                        <Style TargetType="Expander" BasedOn="{StaticResource MenuExpanderStyle}">
                                            <Setter Property="Padding" Value="25 25 25 25"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=ComputedVerticalScrollBarVisibility, ElementName=MenuScrollViewer}" Value="Visible">
                                                    <Setter Property="Padding" Value="25 25 11 25"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style TargetType="telerik:RadRadioButton" BasedOn="{StaticResource MainMenuRadRadioButtonStyle}">
                                            <Setter Property="Margin" Value="10 2 10 2"/>
                                            <Setter Property="Padding" Value="15 10 15 10"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=ComputedVerticalScrollBarVisibility, ElementName=MenuScrollViewer}" Value="Visible">
                                                    <Setter Property="Margin" Value="10 2 4 2"/>
                                                    <Setter Property="Padding" Value="15 10 1 10"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Resources>

                                    <!--홈-->
                                    <Border Grid.Row="0" BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}" BorderThickness="0 0 0 1" Margin="0 12 0 0" Padding="0 0 0 12">
                                        <telerik:RadRadioButton x:Name="FirstButton" Tag="HomePage" IsChecked="{Binding Path=IsCheckedHome, Mode=TwoWay}" Click="MenuItem_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <icon:PackIconPhosphorIcons Kind="HouseLight" Style="{StaticResource PackIconPhosphorIconsStyle}"/>
                                                <TextBlock Text="홈" Style="{StaticResource MenuContentTextBlcokStyle}" FontFamily="{StaticResource DefaultFontFamily}"/>
                                            </StackPanel>
                                        </telerik:RadRadioButton>
                                    </Border>

                                    <Border BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}" BorderThickness="0 0 0 0">
                                        <Expander IsExpanded="True" BorderThickness="0">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <icon:PackIconPhosphorIcons Style="{StaticResource ExpanderPackIconPhosphorIconsStyle}"/>
                                                    <TextBlock Text="생물조사" Style="{StaticResource MenuContentTextBlcokStyle}"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <StackPanel>
                                                <telerik:RadRadioButton IsChecked="{Binding Path=IsCheckedVeSurvey, Mode=TwoWay}" Tag="VeSurveyPage" Click="MenuItem_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <icon:PackIconBootstrapIcons Style="{StaticResource MenuContentIconStyle}"/>
                                                        <TextBlock Text="식생"/>
                                                    </StackPanel>
                                                </telerik:RadRadioButton>
                                                <telerik:RadRadioButton IsChecked="{Binding Path=IsCheckedSurveyPlant, Mode=TwoWay}" Tag="PlantSurveyPage" Click="MenuItem_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <icon:PackIconBootstrapIcons Style="{StaticResource MenuContentIconStyle}"/>
                                                        <TextBlock Text="식물"/>
                                                    </StackPanel>
                                                </telerik:RadRadioButton>
                                                <telerik:RadRadioButton IsChecked="{Binding Path=IsCheckedARSurvey, Mode=TwoWay}" Tag="ARSurveyPage" Click="MenuItem_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <icon:PackIconBootstrapIcons Style="{StaticResource MenuContentIconStyle}"/>
                                                        <TextBlock Text="양서파충류"/>
                                                    </StackPanel>
                                                </telerik:RadRadioButton>
                                                <telerik:RadRadioButton IsChecked="{Binding Path=IsCheckedSurveyFish, Mode=TwoWay}" Tag="FishSurveyPage" Click="MenuItem_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <icon:PackIconBootstrapIcons Style="{StaticResource MenuContentIconStyle}"/>
                                                        <TextBlock Text="어류"/>
                                                    </StackPanel>
                                                </telerik:RadRadioButton>
                                                <telerik:RadRadioButton IsChecked="{Binding Path=IsCheckedBirdSurvey, Mode=TwoWay}" Tag="BirdSurveyPage" Click="MenuItem_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <icon:PackIconBootstrapIcons Style="{StaticResource MenuContentIconStyle}"/>
                                                        <TextBlock Text="조류"/>
                                                    </StackPanel>
                                                </telerik:RadRadioButton>
                                                <telerik:RadRadioButton IsChecked="{Binding Path=IsCheckedMammalSurvey, Mode=TwoWay}" Tag="MammalSurveyPage" Click="MenuItem_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <icon:PackIconBootstrapIcons Style="{StaticResource MenuContentIconStyle}"/>
                                                        <TextBlock Text="포유류"/>
                                                    </StackPanel>
                                                </telerik:RadRadioButton>
                                            </StackPanel>
                                        </Expander>
                                    </Border>

                                    <Border BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}" BorderThickness="0 0 0 0">
                                        <Expander IsExpanded="True" BorderThickness="0">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <icon:PackIconPhosphorIcons Style="{StaticResource ExpanderPackIconPhosphorIconsStyle}"/>
                                                    <TextBlock Text="환경자료" Style="{StaticResource MenuContentTextBlcokStyle}"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <StackPanel>
                                                <telerik:RadRadioButton IsChecked="{Binding Path=IsCheckedSeedVault, Mode=TwoWay}" Tag="SeedVaultPage" Click="MenuItem_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <icon:PackIconBootstrapIcons Style="{StaticResource MenuContentIconStyle}"/>
                                                        <TextBlock Text="수질"/>
                                                    </StackPanel>
                                                </telerik:RadRadioButton>
                                            </StackPanel>
                                        </Expander>
                                    </Border>

                                    <Border BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}" BorderThickness="0 0 0 0">
                                        <Expander IsExpanded="True" BorderThickness="0">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <icon:PackIconPhosphorIcons Style="{StaticResource ExpanderPackIconPhosphorIconsStyle}"/>
                                                    <TextBlock Text="주제도" Style="{StaticResource MenuContentTextBlcokStyle}"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <StackPanel>
                                                <telerik:RadRadioButton IsChecked="{Binding Path=IsCheckedSeedVault, Mode=TwoWay}" Tag="SeedVaultPage" Click="MenuItem_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <icon:PackIconBootstrapIcons Style="{StaticResource MenuContentIconStyle}"/>
                                                        <TextBlock Text="보호구역"/>
                                                    </StackPanel>
                                                </telerik:RadRadioButton>
                                                <telerik:RadRadioButton IsChecked="{Binding Path=IsCheckedSeedVaultBatch, Mode=TwoWay}" Tag="SeedVaultBatchPage" Click="MenuItem_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <icon:PackIconBootstrapIcons Style="{StaticResource MenuContentIconStyle}"/>
                                                        <TextBlock Text="토지피복도"/>
                                                    </StackPanel>
                                                </telerik:RadRadioButton>
                                                <telerik:RadRadioButton IsChecked="{Binding Path=IsCheckedSeedVaultBatch, Mode=TwoWay}" Tag="SeedVaultBatchPage" Click="MenuItem_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <icon:PackIconBootstrapIcons Style="{StaticResource MenuContentIconStyle}"/>
                                                        <TextBlock Text="산사태위험"/>
                                                    </StackPanel>
                                                </telerik:RadRadioButton>
                                                <telerik:RadRadioButton IsChecked="{Binding Path=IsCheckedSeedVaultBatch, Mode=TwoWay}" Tag="SeedVaultBatchPage" Click="MenuItem_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <icon:PackIconBootstrapIcons Style="{StaticResource MenuContentIconStyle}"/>
                                                        <TextBlock Text="식생현황(임상도)"/>
                                                    </StackPanel>
                                                </telerik:RadRadioButton>
                                                <telerik:RadRadioButton IsChecked="{Binding Path=IsCheckedSeedVaultBatch, Mode=TwoWay}" Tag="SeedVaultBatchPage" Click="MenuItem_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <icon:PackIconBootstrapIcons Style="{StaticResource MenuContentIconStyle}"/>
                                                        <TextBlock Text="야생생물 서식현황(에코뱅크)"/>
                                                    </StackPanel>
                                                </telerik:RadRadioButton>
                                                <telerik:RadRadioButton IsChecked="{Binding Path=IsCheckedSeedVaultBatch, Mode=TwoWay}" Tag="SeedVaultBatchPage" Click="MenuItem_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <icon:PackIconBootstrapIcons Style="{StaticResource MenuContentIconStyle}"/>
                                                        <TextBlock Text="수생생물 서식현황(물환경정보시스템)"/>
                                                    </StackPanel>
                                                </telerik:RadRadioButton>
                                                <telerik:RadRadioButton IsChecked="{Binding Path=IsCheckedSeedVaultBatch, Mode=TwoWay}" Tag="SeedVaultBatchPage" Click="MenuItem_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <icon:PackIconBootstrapIcons Style="{StaticResource MenuContentIconStyle}"/>
                                                        <TextBlock Text="생태자연도"/>
                                                    </StackPanel>
                                                </telerik:RadRadioButton>
                                                <telerik:RadRadioButton IsChecked="{Binding Path=IsCheckedSeedVaultBatch, Mode=TwoWay}" Tag="SeedVaultBatchPage" Click="MenuItem_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <icon:PackIconBootstrapIcons Style="{StaticResource MenuContentIconStyle}"/>
                                                        <TextBlock Text="생태현황도"/>
                                                    </StackPanel>
                                                </telerik:RadRadioButton>
                                            </StackPanel>
                                        </Expander>
                                    </Border>

                                    <Border BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}" BorderThickness="0 0 0 0">
                                        <Expander x:Name="LastExpander" IsExpanded="True" BorderThickness="0">
                                            <Expander.Style>
                                                <Style TargetType="Expander" BasedOn="{StaticResource MenuExpanderStyle}">
                                                    <Setter Property="Padding" Value="25 25 25 25"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Path=ComputedVerticalScrollBarVisibility, ElementName=MenuScrollViewer}" Value="Visible">
                                                            <Setter Property="Padding" Value="25 25 11 25"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Expander.Style>
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <icon:PackIconPhosphorIcons Style="{StaticResource ExpanderPackIconPhosphorIconsStyle}"/>
                                                    <TextBlock Text="설정" Style="{StaticResource MenuContentTextBlcokStyle}"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <StackPanel>
                                                <telerik:RadRadioButton IsChecked="{Binding Path=IsCheckedSettingInstt, Mode=TwoWay}" Tag="SettingInsttPage" Click="MenuItem_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <icon:PackIconBootstrapIcons Style="{StaticResource MenuContentIconStyle}"/>
                                                        <TextBlock Text="설정1"/>
                                                    </StackPanel>
                                                </telerik:RadRadioButton>
                                                <telerik:RadRadioButton IsChecked="{Binding Path=IsCheckedSettingInstt, Mode=TwoWay}" Tag="SettingInsttPage" Click="MenuItem_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <icon:PackIconBootstrapIcons Style="{StaticResource MenuContentIconStyle}"/>
                                                        <TextBlock Text="설정2"/>
                                                    </StackPanel>
                                                </telerik:RadRadioButton>
                                                <telerik:RadRadioButton IsChecked="{Binding Path=IsCheckedSettingInstt, Mode=TwoWay}" Tag="SettingInsttPage" Click="MenuItem_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <icon:PackIconBootstrapIcons Style="{StaticResource MenuContentIconStyle}"/>
                                                        <TextBlock Text="설정3"/>
                                                    </StackPanel>
                                                </telerik:RadRadioButton>
                                            </StackPanel>
                                        </Expander>
                                    </Border>

                                    <!--새창-->
                                    <Border Grid.Row="2" Margin="0" Padding="10 15" BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}" Visibility="Collapsed">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderThickness" Value="0 1 0 0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=IsExpanded, ElementName=LastExpander}" Value="True">
                                                        <Setter Property="BorderThickness" Value="0 0 0 0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <StackPanel.Resources>
                                                <Style TargetType="icon:PackIconFeatherIcons">
                                                    <Setter Property="Width" Value="10"/>
                                                    <Setter Property="Height" Value="10"/>
                                                    <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=IconBrush}"/>
                                                    <Setter Property="Margin" Value="0 0 0 0"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Opacity" Value="0.8"/>
                                                </Style>
                                                <Style TargetType="telerik:RadButton">
                                                    <Setter Property="Height" Value="44"/>
                                                    <Setter Property="Margin" Value="0 0 0 5"/>
                                                    <Setter Property="Padding" Value="16 0"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=AlternativeBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=AlternativeBrush}"/>
                                                    <Setter Property="helpers:ThemeHelper.MouseOverBrush" Value="{telerik:Windows11Resource ResourceKey=FocusBrush}"/>
                                                    <Setter Property="helpers:ThemeHelper.FocusBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Path=ComputedVerticalScrollBarVisibility, ElementName=MenuScrollViewer}" Value="Visible">
                                                            <Setter Property="Margin" Value="0 0 -6 5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Resources>
                                            <telerik:RadButton Command="{Binding Path=FloatingWindowOpenExecutedCommand}" CommandParameter="ManualPane">
                                                <DockPanel>
                                                    <icon:PackIconVaadinIcons Kind="InfoCircleOutline" Style="{StaticResource InfoIconStyle}" />
                                                    <TextBlock Text="사용설명서" VerticalAlignment="Center"/>
                                                    <icon:PackIconFeatherIcons Kind="ArrowUpRight" HorizontalAlignment="Right"/>
                                                </DockPanel>
                                            </telerik:RadButton>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="{telerik:Windows11Resource ResourceKey=AlternativeBrush}">
                        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                Background="{telerik:Windows11Resource ResourceKey=OverlayBrush}"
                                BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"
                                BorderThickness="1 1 0 0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8 0 0 0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=IsChecked, ElementName=ShowHideMenuButton}" Value="False">
                                            <Setter Property="CornerRadius" Value="0 0 0 0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden" KeyboardNavigation.IsTabStop="False"/>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!--알림메세지-->
        <uc:ToastControl HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 80 0 0"/>

        <!--로그인창-->
        <Border x:Name="LoginLayout" Visibility="Collapsed" Margin="0 55 0 0" Background="{telerik:Windows11Resource ResourceKey=AlternativeBrush}">
            <ContentControl x:Name="LoginContentControl"  KeyboardNavigation.IsTabStop="False"/>
        </Border>

        <!--화면잠금-->
        <Border x:Name="ScreenLockLayout" Background="#EE000000" Visibility="Collapsed">
            <Grid>
                <Image Source="/Assets/Images/Samsung_black.png" Opacity="0.4"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="삼성DS" 
                                FontSize="28"
                                Margin="0 0 10 10"
                                FontFamily="{StaticResource High1FontFamily}"
                                Foreground="{StaticResource GreenBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 20" HorizontalAlignment="Left">
                        <TextBlock Text="모니터링DB 통합관리 프로그램" 
                                   FontSize="28"
                                   Margin="0 0 10 0"
                                   FontFamily="{StaticResource High1FontFamily}"
                                   Foreground="#AAFFFFFF"/>
                    </StackPanel>
                    <icon:PackIconMaterial Kind="MonitorLock" HorizontalAlignment="Center" Width="64" Height="64" Foreground="{telerik:Windows11Resource ResourceKey=AccentBrush}">
                        <icon:PackIconMaterial.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Direction="270" Opacity="0.4"/>
                        </icon:PackIconMaterial.Effect>
                    </icon:PackIconMaterial>
                    <TextBlock Text="비밀번호를 입력하세요." Style="{StaticResource PrimaryTextBlcokStyle}" Margin="0 20 0 10" HorizontalAlignment="Center" Foreground="#66FFFFFF"/>
                    <telerik:RadPasswordBox x:Name="ScreenLockRadPasswordBox"
                                            Background="{telerik:Windows11Resource ResourceKey=TertiaryBackgroundBrush}"
                                            Width="360"
                                            Height="60"
                                            FontSize="24"
                                            TextAlignment="Center"
                                            Margin="0 0 0 20" 
                                            TextChanged="ScreenLockRadPasswordBox_TextChanged"/>

                </StackPanel>

                <!--시계-->
                <ContentControl x:Name="AnalogClockContentControl" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 30 30 0"/>

                <TextBlock HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0 0 30 30"
                           FontFamily="{StaticResource High1FontFamily}"
                           Foreground="#FFEBEBEB">
                    <Run Text="버전"/>
                    <Run Text="{x:Static main:GB.Version}"/>
                </TextBlock>

            </Grid>
        </Border>

        <!--로딩 표시 및 lock-->
        <Border Background="Transparent">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=(main:GB.IsBusy)}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <telerik:RadBusyIndicator Foreground="{telerik:Windows11Resource ResourceKey=AccentBrush}"
                              FontSize="14"
                              Padding="10"
                              BusyContent="{Binding Path=(main:GB.BusyContent)}" 
                              IsIndeterminate="{Binding Path=(main:GB.IsIndeterminate)}"
                              ProgressValue="{Binding Path=(main:GB.ProgressValue)}"
                              Visibility="{Binding Path=(main:GB.BusyIndicatorVisibility)}"
                              Style="{StaticResource CustomRadBusyIndicatorStyle}">
            </telerik:RadBusyIndicator>
        </Border>

    </Grid>
</Window>

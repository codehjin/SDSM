                                            <Expander.Style>
                                                <Style TargetType="Expander" BasedOn="{StaticResource MenuExpanderStyle}">
                                                    <Setter Property="Padding" Value="25 25 25 25"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Path=ComputedVerticalScrollBarVisibility, ElementName=MenuScrollViewer}" Value="Visible">
                                                            <Setter Property="Padding" Value="25 25 11 25"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Expander.Style>
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <icon:PackIconPhosphorIcons Style="{StaticResource ExpanderPackIconPhosphorIconsStyle}"/>
                                                    <TextBlock Text="설정" Style="{StaticResource MenuContentTextBlcokStyle}"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <StackPanel>
                                                <telerik:RadRadioButton IsChecked="{Binding Path=IsCheckedSettingInstt, Mode=TwoWay}" Tag="SettingInsttPage" Click="MenuItem_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <icon:PackIconBootstrapIcons Style="{StaticResource MenuContentIconStyle}"/>
                                                        <TextBlock Text="설정1"/>
                                                    </StackPanel>
                                                </telerik:RadRadioButton>
                                                <telerik:RadRadioButton IsChecked="{Binding Path=IsCheckedSettingInstt, Mode=TwoWay}" Tag="SettingInsttPage" Click="MenuItem_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <icon:PackIconBootstrapIcons Style="{StaticResource MenuContentIconStyle}"/>
                                                        <TextBlock Text="설정2"/>
                                                    </StackPanel>
                                                </telerik:RadRadioButton>
                                                <telerik:RadRadioButton IsChecked="{Binding Path=IsCheckedSettingInstt, Mode=TwoWay}" Tag="SettingInsttPage" Click="MenuItem_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <icon:PackIconBootstrapIcons Style="{StaticResource MenuContentIconStyle}"/>
                                                        <TextBlock Text="설정3"/>
                                                    </StackPanel>
                                                </telerik:RadRadioButton>
                                            </StackPanel>
                                        </Expander>
                                    </Border>

                                    <Border Padding="0 15" BorderBrush="{StaticResource MainSelectedBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderThickness" Value="0 1 0 0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=IsExpanded, ElementName=LastExpander}" Value="True">
                                                        <Setter Property="BorderThickness" Value="0 0 0 0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <StackPanel.Resources>
                                                <Style TargetType="icon:PackIconFeatherIcons">
                                                    <Setter Property="Width" Value="10"/>
                                                    <Setter Property="Height" Value="10"/>
                                                    <Setter Property="Foreground" Value="{StaticResource MenuForegroundBrush}"/>
                                                    <Setter Property="Margin" Value="0 0 3 0"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Opacity" Value="0.8"/>
                                                </Style>
                                                <Style TargetType="telerik:RadButton">
                                                    <Setter Property="Height" Value="44"/>
                                                    <Setter Property="Margin" Value="10 2 10 2"/>
                                                    <Setter Property="Padding" Value="15 10 15 10"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Foreground" Value="{StaticResource MenuForegroundBrush}"/>
                                                    <Setter Property="FontFamily" Value="{StaticResource High1FontFamily}"/>
                                                    <Setter Property="helpers:ThemeHelper.MouseOverBackgroundBrush" Value="{StaticResource MainMouseOverBrush}"/>
                                                    <Setter Property="helpers:ThemeHelper.PressedBackgroundBrush" Value="{StaticResource MainSelectedBrush}"/>
                                                    <Setter Property="helpers:ThemeHelper.FocusBackgroundBrush" Value="Transparent"/>
                                                    <Setter Property="helpers:ThemeHelper.FocusBrush" Value="Transparent"/>
                                                </Style>
                                            </StackPanel.Resources>
                                            <telerik:RadRadioButton Tag="BulkRegisterPage" IsChecked="{Binding Path=IsCheckedBulkRegister, Mode=TwoWay}" Click="MenuItem_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <icon:PackIconPhosphorIcons Kind="ListPlusLight" Style="{StaticResource PackIconPhosphorIconsStyle}"/>
                                                    <TextBlock Text="일괄등록" Style="{StaticResource MenuContentTextBlcokStyle}"/>
                                                </StackPanel>
                                            </telerik:RadRadioButton>
                                            <telerik:RadButton Command="{Binding Path=FloatingWindowOpenExecutedCommand}" CommandParameter="ManualPane" Visibility="Collapsed">
                                                <DockPanel>
                                                    <icon:PackIconVaadinIcons Kind="InfoCircleOutline" Style="{StaticResource InfoIconStyle}" Foreground="{StaticResource MenuForegroundBrush}"/>
                                                    <TextBlock Text="사용설명서" VerticalAlignment="Center" Foreground="{StaticResource MenuForegroundBrush}"/>
                                                    <icon:PackIconFeatherIcons Kind="ArrowUpRight" HorizontalAlignment="Right"/>
                                                </DockPanel>
                                            </telerik:RadButton>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource MainPrimaryBrush}">
                        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{telerik:Windows11Resource ResourceKey=OverlayBrush}" CornerRadius="0 0 0 8">
                            <Frame x:Name="ContentFrame" NavigationUIVisibility="Hidden" KeyboardNavigation.IsTabStop="False"/>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!--알림메세지-->
        <uc:ToastControl HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 80 0 0"/>

        <!--로그인창-->
        <Border x:Name="LoginLayout" Visibility="Collapsed" Margin="0 55 0 0" Background="{telerik:Windows11Resource ResourceKey=AlternativeBrush}">
            <ContentControl x:Name="LoginContentControl"  KeyboardNavigation.IsTabStop="False"/>
        </Border>

        <!--화면잠금-->
        <Border x:Name="ScreenLockLayout" Background="#EE000000" Visibility="Collapsed">
            <Grid>
                <Image Source="/Assets/Images/Samsung_black.png" Opacity="0.5" MaxWidth="600" Margin="0 -40 0 0"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="삼성DS" 
                                FontSize="28"
                                Margin="0 0 10 10"
                                FontFamily="{StaticResource High1FontFamily}"
                                Foreground="{StaticResource GreenBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 20" HorizontalAlignment="Left">
                        <TextBlock Text="모니터링DB 통합관리 프로그램" 
                                   FontSize="28"
                                   Margin="0 0 10 0"
                                   FontFamily="{StaticResource High1FontFamily}"
                                   Foreground="#AAFFFFFF"/>
                    </StackPanel>
                    <icon:PackIconMaterial Kind="MonitorLock" HorizontalAlignment="Center" Width="64" Height="64" Foreground="{telerik:Windows11Resource ResourceKey=AccentBrush}">
                        <icon:PackIconMaterial.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Direction="270" Opacity="0.4"/>
                        </icon:PackIconMaterial.Effect>
                    </icon:PackIconMaterial>
                    <TextBlock Text="비밀번호를 입력하세요." Style="{StaticResource PrimaryTextBlcokStyle}" Margin="0 20 0 10" HorizontalAlignment="Center" Foreground="#66FFFFFF"/>
                    <telerik:RadPasswordBox x:Name="ScreenLockRadPasswordBox"
                                            Background="{telerik:Windows11Resource ResourceKey=TertiaryBackgroundBrush}"
                                            Width="360"
                                            Height="60"
                                            FontSize="24"
                                            TextAlignment="Center"
                                            Margin="0 0 0 20" 
                                            TextChanged="ScreenLockRadPasswordBox_TextChanged"/>

                </StackPanel>

                <!--시계-->
                <ContentControl x:Name="AnalogClockContentControl" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 30 30 0"/>

                <TextBlock HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0 0 30 30"
                           FontFamily="{StaticResource High1FontFamily}"
                           Foreground="#FFEBEBEB">
                    <Run Text="버전"/>
                    <Run Text="{x:Static main:GB.Version}"/>
                </TextBlock>

            </Grid>
        </Border>

        <!--로딩 표시 및 lock-->
        <Border Background="Transparent">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=(main:GB.IsBusy)}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <telerik:RadBusyIndicator Foreground="{telerik:Windows11Resource ResourceKey=AccentBrush}"
                                      FontSize="14"
                                      Padding="10"
                                      BusyContent="{Binding Path=(main:GB.BusyContent)}" 
                                      IsIndeterminate="{Binding Path=(main:GB.IsIndeterminate)}"
                                      ProgressValue="{Binding Path=(main:GB.ProgressValue)}"
                                      Visibility="{Binding Path=(main:GB.BusyIndicatorVisibility)}"
                                      Style="{StaticResource CustomRadBusyIndicatorStyle}">
            </telerik:RadBusyIndicator>
        </Border>

    </Grid>
</Window>

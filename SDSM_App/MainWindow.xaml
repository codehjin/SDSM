<Window x:Class="SDSM_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:helpers="clr-namespace:Telerik.Windows.Controls.Theming.Helpers;assembly=Telerik.Windows.Controls"
        xmlns:mat="clr-namespace:Telerik.Windows.Controls.MaterialControls;assembly=Telerik.Windows.Controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:icon ="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:uc="clr-namespace:SDSM_App.Views.UserControls"
        xmlns:properties="clr-namespace:SDSM_App.Properties"
        xmlns:main="clr-namespace:SDSM_App"
        xmlns:common="clr-namespace:SDSM_App.Commons"
        xmlns:viewmodel="clr-namespace:SDSM_App.ViewModels"
        d:DataContext="{d:DesignInstance Type={x:Type viewmodel:MainWindowViewModel}}"
        Background="Transparent"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        MinWidth="1260"
        MinHeight="720" 
        FontFamily="{StaticResource DefaultFontFamily}"
        FontSize="{StaticResource DefaultFontSize}"
        Icon="/Assets/Images/m.ico"
        Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="8" CaptionHeight="48" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <sys:Double x:Key="MainMenuFontSize">17</sys:Double>

        <Style x:Key="ExpanderPillStyle" TargetType="Rectangle">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="RadiusX" Value="0"/>
            <Setter Property="RadiusY" Value="0"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Width" Value="3"/>
        </Style>

        <ControlTemplate x:Key="MainMenuToggleButtonTemp" TargetType="{x:Type ToggleButton}">
            <Border x:Name="Border"
                    CornerRadius="0"
                    BorderThickness="0"
                    Background="Transparent"
                    Cursor="Hand" 
                    Padding="{TemplateBinding Padding}">
                <Grid>
                    <telerik:RadGlyph x:Name="ArrowIcon"
                                      Glyph="{StaticResource GlyphArrowChevronDown}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Foreground="{StaticResource MenuForegroundBrush}"
                                      RenderTransformOrigin="0.5,0.5"
                                      FontSize="18"
                                      Opacity="1">
                        <telerik:RadGlyph.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="ArrowRotateTransform" Angle="0"/>
                                <ScaleTransform x:Name="ArrowScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                            </TransformGroup>
                        </telerik:RadGlyph.RenderTransform>
                    </telerik:RadGlyph>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ArrowScaleTransform" Storyboard.TargetProperty="(ScaleTransform.ScaleX)" To="1.2" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="ArrowScaleTransform" Storyboard.TargetProperty="(ScaleTransform.ScaleY)" To="1.2" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ArrowScaleTransform" Storyboard.TargetProperty="(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="ArrowScaleTransform" Storyboard.TargetProperty="(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ArrowRotateTransform" Storyboard.TargetProperty="(RotateTransform.Angle)" To="45" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ArrowRotateTransform" Storyboard.TargetProperty="(RotateTransform.Angle)" To="0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!--Expander Template-->
        <Style x:Key="MenuExpanderStyle" TargetType="{x:Type Expander}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <Grid x:Name="Root">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Name="ContentRow" Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!--타이틀-->
                            <Border x:Name="border"
                                    Grid.Row="0"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Grid>
                                    <ContentPresenter ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Margin="25 0 0 0">
                                    </ContentPresenter>
                                    <ToggleButton IsChecked="{Binding Path=IsExpanded,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                  OverridesDefaultStyle="True"
                                                  Template="{StaticResource MainMenuToggleButtonTemp}"
                                                  BorderThickness="0"
                                                  Padding="{TemplateBinding Padding}"
                                                  IsTabStop="False">
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <!--하위메뉴-->
                            <Border x:Name="content"
                                    Grid.Row="1"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource MainSelectedBrush}"
                                    BorderThickness="0"
                                    Padding="0 0 0 12"
                                    CornerRadius="0">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="content" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="content" Property="BorderThickness" Value="0 0 0 1"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="0"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="content" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" TargetName="border" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="MainMenuRadRadioButtonTemplate" TargetType="telerik:RadRadioButton">
            <Grid Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="6" Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="BorderVisual" 
                        Grid.ColumnSpan="2"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Background="{StaticResource MainPrimaryBrush}"
                        CornerRadius="{telerik:Windows11Resource ResourceKey=CornerRadius}"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                <Rectangle x:Name="PART_Pill" Margin="0 0 0 0" Style="{StaticResource ExpanderPillStyle}" Height="0"/>

                <ContentPresenter x:Name="Content"
                                  Margin="{TemplateBinding Padding}"                                 
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                  RecognizesAccessKey="True"/>

            </Grid>

            <ControlTemplate.Triggers>
                <!-- MouseOver -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBackgroundBrush), Mode=OneWay}"/>
                    <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBrush), Mode=OneWay}"/>
                </Trigger>

                <!-- Focused & MouseOver -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsKeyboardFocusWithin" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBackgroundBrush), Mode=OneWay}"/>
                </MultiTrigger>

                <!-- Disabled -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Content" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}" Property="Opacity"/>
                    <Setter TargetName="Content" Property="TextBlock.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledForegroundBrush), Mode=OneWay}"/>
                </Trigger>

                <!-- IsSelected general setters -->
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.CheckedBackgroundBrush), Mode=OneWay}"/>
                    <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.CheckedBrush), Mode=OneWay}"/>
                    <Setter TargetName="PART_Pill" Property="Opacity" Value="1"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PART_Pill" Storyboard.TargetProperty="Height" From="0" To="20" BeginTime="0:0:0.3" Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PART_Pill" Storyboard.TargetProperty="Height" From="20" To="0" Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>

                <!-- Selected and MouseOver -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsChecked" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBackgroundBrush), Mode=OneWay}"/>
                </MultiTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="MainMenuRadRadioButtonStyle" TargetType="telerik:RadRadioButton">
            <Setter Property="GroupName" Value="mainMenuGroup"/>
            <Setter Property="helpers:ThemeHelper.FocusBackgroundBrush" Value="Transparent"/>
            <Setter Property="helpers:ThemeHelper.FocusBrush" Value="Transparent"/>
            <Setter Property="helpers:ThemeHelper.FocusVisualMargin" Value="0"/>
            <Setter Property="helpers:ThemeHelper.MouseOverBackgroundBrush" Value="{StaticResource MainMouseOverBrush}"/>
            <Setter Property="helpers:ThemeHelper.MouseOverBrush" Value="Transparent"/>
            <Setter Property="helpers:ThemeHelper.PressedBackgroundBrush" Value="{StaticResource MainMouseOverBrush}"/>
            <Setter Property="helpers:ThemeHelper.PressedBrush" Value="Transparent"/>
            <Setter Property="helpers:ThemeHelper.CheckedBackgroundBrush" Value="{StaticResource MainSelectedBrush}"/>
            <Setter Property="helpers:ThemeHelper.CheckedBrush" Value="Transparent"/>
            <Setter Property="helpers:ThemeHelper.DisabledForegroundBrush" Value="{telerik:Windows11Resource ResourceKey=DisabledForegroundBrush}"/>
            <Setter Property="helpers:ThemeHelper.DisabledBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=DisabledBackgroundBrush}"/>
            <Setter Property="helpers:ThemeHelper.DisabledBrush" Value="{telerik:Windows11Resource ResourceKey=DisabledBorderBrush}"/>
            <Setter Property="CornerRadius" Value="{telerik:Windows11Resource ResourceKey=CornerRadius}"/>
            <Setter Property="FontSize" Value="{StaticResource MainMenuFontSize}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource MenuForegroundBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource High1FontFamily}"/>
            <Setter Property="MinHeight" Value="{telerik:Windows11Resource ResourceKey=DefaultControlMinHeight}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Validation.ErrorTemplate" Value="{StaticResource ValidationTooltipTemplate}"/>
            <Setter Property="Template" Value="{StaticResource MainMenuRadRadioButtonTemplate}"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuContentTextBlcokStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0 0 0 0"/>
            <Setter Property="FontFamily" Value="{StaticResource High1FontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource MainMenuFontSize}"/>
            <Setter Property="Foreground" Value="{StaticResource MenuForegroundBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadRadioButton}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuContentIconStyle" TargetType="icon:PackIconBootstrapIcons">
            <Setter Property="Kind" Value="DashLg"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource MenuForegroundBrush}"/>
            <Setter Property="Margin" Value="5 0 16 0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadRadioButton}}" Value="True">
                    <Setter Property="Kind" Value="ArrowRight"/>
                    <Setter Property="Width" Value="15"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>                
            </Style.Triggers>
        </Style>

        <Style x:Key="PackIconPhosphorIconsStyle" TargetType="icon:PackIconPhosphorIcons">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource MenuForegroundBrush}"/>
            <Setter Property="Margin" Value="0 0 15 0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadRadioButton}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExpanderPackIconPhosphorIconsStyle" TargetType="icon:PackIconPhosphorIcons" BasedOn="{StaticResource PackIconPhosphorIconsStyle}">
            <Setter Property="Kind" Value="PlusSquareLight"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=IsExpanded, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Expander}}" Value="True">
                    <Setter Property="Kind" Value="MinusSquareLight"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate x:Key="AdminRadDropDownButtonTemplate" TargetType="telerik:RadDropDownButton">
            <Grid>
                <Border x:Name="FocusVisual" Style="{StaticResource FocusVisualBorderStyle}" CornerRadius="{TemplateBinding CornerRadius}"/>
                <Grid Margin="{TemplateBinding helpers:ThemeHelper.FocusVisualMargin}">
                    <Grid SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" MinHeight="{TemplateBinding MinHeight}" MinWidth="{TemplateBinding MinWidth}">
                        <Border x:Name="BorderVisual"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="Content"
                                              Grid.Row="1"
                                              Grid.Column="1"
                                              TextBlock.Foreground="{StaticResource MenuForegroundBrush}"
                                              Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                            <Grid x:Name="DropDownIndicator"
                                  Grid.Column="1"
                                  Grid.Row="2"
                                  Margin="{telerik:Windows11Resource ResourceKey=DropDownIndicatorMargin}"
                                  Canvas.ZIndex="2"
                                  IsHitTestVisible="False"
                                  Visibility="{TemplateBinding DropDownIndicatorVisibility}">
                                <telerik:RadGlyph x:Name="arrow"
                                                  FontSize="{telerik:Windows11Resource ResourceKey=GlyphFontSizeS}"
                                                  Foreground="{StaticResource MenuForegroundBrush}"
                                                  Glyph="{StaticResource GlyphArrowChevronDown}"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
                <Popup x:Name="DropDownPopup"
                       AllowsTransparency="True"
                       StaysOpen="False"
                       Focusable="False"
                       Placement="Bottom"
                       PopupAnimation="{TemplateBinding PopupAnimation}"
                       HorizontalOffset="0"
                       VerticalOffset="{telerik:Windows11Resource ResourceKey=PopupOffset}">
                    <Grid Margin="{telerik:Windows11Resource ResourceKey=PopupMargin}">
                        <mat:Shadow Background="{telerik:Windows11Resource ResourceKey=TertiaryBackgroundBrush}" ShadowDepth="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mat:MaterialAssist.ShadowDepth)}" CornerRadius="{telerik:Windows11Resource ResourceKey=OverlayCornerRadius}"/>
                        <Border x:Name="DropDownPopupBorder"
                                MinWidth="{TemplateBinding DropDownMinWidth}"
                                MinHeight="{TemplateBinding DropDownMinHeight}"
                                Width="{TemplateBinding DropDownWidth}"
                                Height="{TemplateBinding DropDownHeight}"
                                MaxWidth="{TemplateBinding DropDownMaxWidth}"
                                MaxHeight="{TemplateBinding DropDownMaxHeight}"
                                CornerRadius="{telerik:Windows11Resource ResourceKey=OverlayCornerRadius}"
                                Background="{telerik:Windows11Resource ResourceKey=TertiaryBackgroundBrush}"
                                BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"
                                BorderThickness="1">
                            <ContentControl x:Name="DropDownPopupContent"
                                            Content="{TemplateBinding DropDownContent}"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            ContentTemplate="{TemplateBinding DropDownContentTemplate}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            telerik:CornerRadiusHelper.ClipRadius="{telerik:Windows11Resource ResourceKey=OverlayCornerRadius}"
                                            DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DataContext}"
                                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>

                <!-- background is hidden -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsEnabled" Value="True"/>
                        <Condition Property="IsBackgroundVisible" Value="False"/>
                        <Condition Property="IsMouseOver" Value="False"/>
                        <Condition Property="IsOpen" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource MenuForegroundBrush}"/>
                </MultiTrigger>

                <!-- General IsKeyboardFocused setters -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsEnabled" Value="True"/>
                        <Condition Property="IsKeyboardFocused" Value="True"/>
                        <Condition Property="IsPressed" Value="False"/>
                        <Condition Property="IsMouseOver" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="FocusVisual" Property="Opacity" Value="1"/>
                    <Setter TargetName="FocusVisual" Property="Opacity" Value="1"/>
                    <Setter Property="Foreground" Value="{StaticResource MenuForegroundBrush}"/>
                </MultiTrigger>

                <!-- General setters for IsMouseOver -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BorderVisual" Property="Background" Value="{StaticResource MainMouseOverBrush}"/>
                    <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBrush)}"/>
                    <Setter Property="Foreground" Value="{StaticResource MenuForegroundBrush}"/>
                </Trigger>

                <!-- General setters for IsPressed -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsOpen" Value="False"/>
                        <Condition Property="IsPressed" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                    <Setter TargetName="arrow" Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=TertiaryForegroundBrush}"/>
                    <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.PressedBackgroundBrush)}"/>
                    <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.PressedBrush)}"/>
                </MultiTrigger>

                <!-- General setters for IsOpen -->
                <Trigger Property="IsOpen" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter TargetName="arrow" Property="Foreground" Value="White"/>
                    <Setter TargetName="BorderVisual" Property="Background" Value="{StaticResource MainSelectedBrush}"/>
                    <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.CheckedBrush)}"/>
                </Trigger>

                <!-- disabled -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Content" Property="Opacity" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}"/>
                    <Setter TargetName="DropDownIndicator" Property="Opacity" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}"/>
                    <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledBackgroundBrush)}"/>
                    <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledBrush)}"/>
                    <Setter TargetName="Content" Property="TextBlock.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledForegroundBrush)}"/>
                    <Setter TargetName="arrow" Property="Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledForegroundBrush)}"/>
                </Trigger>

                <!-- disabled and focused -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsEnabled" Value="False"/>
                        <Condition Property="IsKeyboardFocused" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="FocusVisual" Property="Opacity" Value="0"/>
                </MultiTrigger>

                <!-- disabled & background is hidden -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsEnabled" Value="False"/>
                        <Condition Property="IsBackgroundVisible" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="BorderVisual" Property="helpers:ThemeHelper.DisabledBackgroundBrush" Value="Transparent"/>
                    <Setter TargetName="BorderVisual" Property="helpers:ThemeHelper.DisabledBrush" Value="Transparent"/>
                </MultiTrigger>

                <!-- DropDownButtonPosition and DropDownPacement -->
                <Trigger Property="DropDownButtonPosition" Value="Bottom"/>
                <Trigger Property="DropDownButtonPosition" Value="Left">
                    <Setter TargetName="DropDownIndicator" Property="Grid.Column" Value="0"/>
                    <Setter TargetName="DropDownIndicator" Property="Grid.Row" Value="1"/>
                </Trigger>
                <Trigger Property="DropDownButtonPosition" Value="Top">
                    <Setter TargetName="DropDownIndicator" Property="Grid.Column" Value="1"/>
                    <Setter TargetName="DropDownIndicator" Property="Grid.Row" Value="0"/>
                </Trigger>
                <Trigger Property="DropDownButtonPosition" Value="Right">
                    <Setter TargetName="DropDownIndicator" Property="Grid.Column" Value="2"/>
                    <Setter TargetName="DropDownIndicator" Property="Grid.Row" Value="1"/>
                </Trigger>
                <Trigger Property="DropDownPlacement" Value="Bottom"/>
                <Trigger Property="DropDownPlacement" Value="Top">
                    <Setter TargetName="DropDownPopup" Property="HorizontalOffset" Value="0"/>
                    <Setter TargetName="DropDownPopup" Property="VerticalOffset" Value="{Binding Source={x:Static telerik:Windows11Palette.Palette}, Path=PopupOffset, Converter={StaticResource MultiplyValueConverter}, ConverterParameter=-1}"/>
                    <Setter TargetName="arrow" Property="Glyph" Value="{StaticResource GlyphArrowChevronUp}"/>
                </Trigger>
                <Trigger Property="DropDownPlacement" Value="Left">
                    <Setter TargetName="DropDownPopup" Property="HorizontalOffset" Value="{Binding Source={x:Static telerik:Windows11Palette.Palette}, Path=PopupOffset, Converter={StaticResource MultiplyValueConverter}, ConverterParameter=-1}"/>
                    <Setter TargetName="DropDownPopup" Property="VerticalOffset" Value="0"/>
                    <Setter TargetName="arrow" Property="Glyph" Value="{StaticResource GlyphArrowChevronLeft}"/>
                </Trigger>
                <Trigger Property="DropDownPlacement" Value="Right">
                    <Setter TargetName="DropDownPopup" Property="HorizontalOffset" Value="{telerik:Windows11Resource ResourceKey=PopupOffset}"/>
                    <Setter TargetName="DropDownPopup" Property="VerticalOffset" Value="0"/>
                    <Setter TargetName="arrow" Property="Glyph" Value="{StaticResource GlyphArrowChevronRight}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

    </Window.Resources>

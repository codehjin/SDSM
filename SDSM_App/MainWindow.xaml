<Window x:Class="SDSM_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:helpers="clr-namespace:Telerik.Windows.Controls.Theming.Helpers;assembly=Telerik.Windows.Controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:icon ="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:uc="clr-namespace:SDSM_App.Views.UserControls"
        xmlns:properties="clr-namespace:SDSM_App.Properties"
        xmlns:main="clr-namespace:SDSM_App"
        xmlns:common="clr-namespace:SDSM_App.Commons"
        xmlns:viewmodel="clr-namespace:SDSM_App.ViewModels"
        d:DataContext="{d:DesignInstance Type={x:Type viewmodel:MainWindowViewModel}}"
        Background="Transparent"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        MinWidth="1260"
        MinHeight="720" 
        FontFamily="{StaticResource DefaultFontFamily}"
        FontSize="{StaticResource DefaultFontSize}"
        Icon="/Assets/Images/m.ico"
        Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="8" CaptionHeight="48" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <sys:Double x:Key="MainMenuFontSize">16</sys:Double>

        <Style x:Key="ExpanderPillStyle" TargetType="Rectangle">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Fill" Value="{telerik:Windows11Resource ResourceKey=AccentBrush}"/>
            <Setter Property="RadiusX" Value="0"/>
            <Setter Property="RadiusY" Value="0"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Width" Value="3"/>
        </Style>

        <ControlTemplate x:Key="MainMenuToggleButtonTemp" TargetType="{x:Type ToggleButton}">
            <Border x:Name="Border"
                    CornerRadius="0"
                    BorderThickness="0"
                    Background="Transparent"
                    Cursor="Hand" 
                    Padding="{TemplateBinding Padding}">
                <Grid>
                    <telerik:RadGlyph x:Name="ArrowIcon"
                              Glyph="{StaticResource GlyphArrowChevronDown}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Foreground="{telerik:Windows11Resource ResourceKey=IconBrush}"
                              RenderTransformOrigin="0.5,0.5"
                              FontSize="18"
                              Opacity="1">
                        <telerik:RadGlyph.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="ArrowRotateTransform" Angle="0"/>
                                <ScaleTransform x:Name="ArrowScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                            </TransformGroup>
                        </telerik:RadGlyph.RenderTransform>
                    </telerik:RadGlyph>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ArrowScaleTransform" Storyboard.TargetProperty="(ScaleTransform.ScaleX)" To="1.2" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="ArrowScaleTransform" Storyboard.TargetProperty="(ScaleTransform.ScaleY)" To="1.2" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ArrowScaleTransform" Storyboard.TargetProperty="(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="ArrowScaleTransform" Storyboard.TargetProperty="(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ArrowRotateTransform" Storyboard.TargetProperty="(RotateTransform.Angle)" To="45" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ArrowRotateTransform" Storyboard.TargetProperty="(RotateTransform.Angle)" To="0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!--Expander Template-->
        <Style x:Key="MenuExpanderStyle" TargetType="{x:Type Expander}">
            <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <Grid x:Name="Root">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Name="ContentRow" Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!--타이틀-->
                            <Border x:Name="border"
                                    Grid.Row="0"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Grid>
                                    <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="25 0 0 0">
                                    </ContentPresenter>
                                    <ToggleButton IsChecked="{Binding Path=IsExpanded,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          OverridesDefaultStyle="True"
                                          Template="{StaticResource MainMenuToggleButtonTemp}"
                                          BorderThickness="0"
                                          Padding="{TemplateBinding Padding}"
                                          IsTabStop="False">
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <!--하위메뉴-->
                            <Border x:Name="content"
                                    Grid.Row="1"
                                    Background="Transparent"
                                    BorderBrush="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"
                                    BorderThickness="0"
                                    Padding="0 0 0 12"
                                    CornerRadius="0">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="content" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="content" Property="BorderThickness" Value="0 0 0 1"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="0"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="content" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" TargetName="border" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="MainMenuRadRadioButtonTemplate" TargetType="telerik:RadRadioButton">
            <Grid Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="6" Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="BorderVisual" 
                        Grid.ColumnSpan="2"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Background="{telerik:Windows11Resource ResourceKey=AlternativeBrush}"
                        CornerRadius="{telerik:Windows11Resource ResourceKey=CornerRadius}"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                <Rectangle x:Name="PART_Pill" Margin="0 0 0 0" Style="{StaticResource ExpanderPillStyle}" Height="0"/>

                <ContentPresenter x:Name="Content"
                                  Margin="{TemplateBinding Padding}"                                 
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                  RecognizesAccessKey="True"/>

            </Grid>

            <ControlTemplate.Triggers>

                <!-- MouseOver -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBackgroundBrush), Mode=OneWay}"/>
                    <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBrush), Mode=OneWay}"/>
                </Trigger>

                <!-- Focused & MouseOver -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsKeyboardFocusWithin" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBackgroundBrush), Mode=OneWay}"/>
                </MultiTrigger>

                <!-- Disabled -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Content" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}" Property="Opacity"/>
                    <Setter TargetName="Content" Property="TextBlock.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledForegroundBrush), Mode=OneWay}"/>
                </Trigger>

                <!-- IsSelected general setters -->
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.CheckedBackgroundBrush), Mode=OneWay}"/>
                    <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.CheckedBrush), Mode=OneWay}"/>
                    <Setter TargetName="PART_Pill" Property="Opacity" Value="1"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PART_Pill" Storyboard.TargetProperty="Height" From="0" To="20" BeginTime="0:0:0.3" Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PART_Pill" Storyboard.TargetProperty="Height" From="20" To="0" Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>

                <!-- Selected and MouseOver -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsChecked" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBackgroundBrush), Mode=OneWay}"/>
                </MultiTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="MainMenuRadRadioButtonStyle" TargetType="telerik:RadRadioButton">
            <Setter Property="GroupName" Value="mainMenuGroup"/>
            <Setter Property="helpers:ThemeHelper.FocusBackgroundBrush" Value="Transparent"/>
            <Setter Property="helpers:ThemeHelper.FocusBrush" Value="Transparent"/>
            <Setter Property="helpers:ThemeHelper.FocusVisualMargin" Value="0"/>
            <Setter Property="helpers:ThemeHelper.MouseOverBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=InputBorderBrush}"/>
            <Setter Property="helpers:ThemeHelper.MouseOverBrush" Value="Transparent"/>
            <Setter Property="helpers:ThemeHelper.PressedBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=SubtleBrush}"/>
            <Setter Property="helpers:ThemeHelper.PressedBrush" Value="Transparent"/>
            <Setter Property="helpers:ThemeHelper.CheckedBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=SubtleBrush}"/>
            <Setter Property="helpers:ThemeHelper.CheckedBrush" Value="Transparent"/>
            <Setter Property="helpers:ThemeHelper.DisabledForegroundBrush" Value="{telerik:Windows11Resource ResourceKey=DisabledForegroundBrush}"/>
            <Setter Property="helpers:ThemeHelper.DisabledBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=DisabledBackgroundBrush}"/>
            <Setter Property="helpers:ThemeHelper.DisabledBrush" Value="{telerik:Windows11Resource ResourceKey=DisabledBorderBrush}"/>
            <Setter Property="CornerRadius" Value="{telerik:Windows11Resource ResourceKey=CornerRadius}"/>
            <Setter Property="FontSize" Value="{StaticResource MainMenuFontSize}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="{telerik:Windows11Resource ResourceKey=DefaultControlMinHeight}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Validation.ErrorTemplate" Value="{StaticResource ValidationTooltipTemplate}"/>
            <Setter Property="Template" Value="{StaticResource MainMenuRadRadioButtonTemplate}"/>
        </Style>

        <ControlTemplate x:Key="SlidingMenuRadToggleButtonTemplate" TargetType="telerik:RadToggleButton">
            <Grid>
                <Border x:Name="FocusVisual" Style="{StaticResource FocusVisualBorderStyle}" CornerRadius="{TemplateBinding CornerRadius}"/>
                <Grid Margin="{TemplateBinding helpers:ThemeHelper.FocusVisualMargin}">
                    <Grid SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" MinHeight="{TemplateBinding MinHeight}" MinWidth="{TemplateBinding MinWidth}">
                        <Border x:Name="BorderVisual"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"/>
                        <ContentPresenter x:Name="Content"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                </Grid>
            </Grid>
            <ControlTemplate.Triggers>

                <!-- background is hidden -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsBackgroundVisible" Value="False"/>
                        <Condition Property="IsEnabled" Value="True"/>
                        <Condition Property="IsMouseOver" Value="False"/>
                        <Condition Property="IsChecked" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </MultiTrigger>

                <!-- general setters for IsKeyboardFocused -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsKeyboardFocused" Value="True"/>
                        <Condition Property="IsEnabled" Value="True"/>
                        <Condition Property="IsMouseOver" Value="False"/>
                        <Condition Property="IsPressed" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="FocusVisual" Property="Opacity" Value="1"/>
                </MultiTrigger>

                <!-- General setters for IsMouseOver -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBackgroundBrush)}"/>
                </Trigger>

                <!-- General setters for IsPressed -->
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=SecondaryForegroundBrush}"/>
                    <Setter Property="Background" Value="{telerik:Windows11Resource ResourceKey=PressedBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{telerik:Windows11Resource ResourceKey=PrimaryBorderBrush}"/>
                </Trigger>

                <!-- General setters for IsChecked -->
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.CheckedBackgroundBrush)}"/>
                    <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.CheckedBackgroundBrush)}"/>
                </Trigger>

                <!-- mouse over and toggled -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsChecked" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBackgroundBrush)}"/>
                    <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.MouseOverBrush)}"/>
                </MultiTrigger>

                <!-- pressed and toggled -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsPressed" Value="True"/>
                        <Condition Property="IsChecked" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.PressedBackgroundBrush)}"/>
                    <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.PressedBrush)}"/>
                </MultiTrigger>

                <!-- disabled -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledBackgroundBrush)}"/>
                    <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledBrush)}"/>
                    <Setter TargetName="Content" Property="TextBlock.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledForegroundBrush)}"/>
                    <Setter TargetName="Content" Property="Opacity" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}"/>
                </Trigger>

                <!-- disabled and toggled -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsEnabled" Value="False"/>
                        <Condition Property="IsChecked" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="BorderVisual" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.CheckedBackgroundBrush)}"/>
                    <Setter TargetName="BorderVisual" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.CheckedBrush)}"/>
                    <Setter TargetName="Content" Property="TextBlock.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledForegroundBrush)}"/>
                    <Setter TargetName="Content" Property="Opacity" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}"/>
                </MultiTrigger>

                <!-- disabled & background is hidden -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsEnabled" Value="False"/>
                        <Condition Property="IsBackgroundVisible" Value="False"/>
                        <Condition Property="IsChecked" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="helpers:ThemeHelper.DisabledBackgroundBrush" Value="Transparent"/>
                    <Setter Property="helpers:ThemeHelper.DisabledBrush" Value="Transparent"/>
                    <Setter TargetName="Content" Property="Opacity" Value="{telerik:Windows11Resource ResourceKey=DisabledOpacity}"/>
                    <Setter TargetName="Content" Property="TextBlock.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(helpers:ThemeHelper.DisabledForegroundBrush)}"/>
                </MultiTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="MenuContentTextBlcokStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0 0 0 0"/>
            <Setter Property="FontFamily" Value="{StaticResource High1FontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource MainMenuFontSize}"/>
            <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
        </Style>

        <Style x:Key="MenuContentIconStyle" TargetType="icon:PackIconBootstrapIcons">
            <Setter Property="Kind" Value="DashLg"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=PrimaryForegroundBrush}"/>
            <Setter Property="Margin" Value="5 0 16 0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=telerik:RadRadioButton}}" Value="True">
                    <Setter Property="Kind" Value="ArrowRight"/>
                    <Setter Property="Width" Value="15"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PackIconPhosphorIconsStyle" TargetType="icon:PackIconPhosphorIcons">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Foreground" Value="{telerik:Windows11Resource ResourceKey=IconBrush}"/>
            <Setter Property="Margin" Value="0 0 15 0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ExpanderPackIconPhosphorIconsStyle" TargetType="icon:PackIconPhosphorIcons" BasedOn="{StaticResource PackIconPhosphorIconsStyle}">
            <Setter Property="Kind" Value="PlusSquareLight"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Path=IsExpanded, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Expander}}" Value="True">
                    <Setter Property="Kind" Value="MinusSquareLight"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>
    <Grid>
        <Border>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Margin" Value="0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                            <Setter Property="Margin" Value="8"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!--상단-->
                <Border Background="{telerik:Windows11Resource ResourceKey=AlternativeBrush}" Panel.ZIndex="99">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="15 0 0 0">
                            <telerik:RadToggleButton x:Name="ShowHideMenuButton"
                                                     Visibility="Visible"
                                                     WindowChrome.IsHitTestVisibleInChrome="True"
                                                     Padding="10"
                                                     BorderThickness="0"                                                    
                                                     IsChecked="{Binding Source={x:Static properties:Settings.Default}, Path=IsSideShow, Mode=TwoWay}"
                                                     VerticalAlignment="Center"
                                                     Cursor="Hand"
                                                     Checked="ShowHideMenuButton_Checked"
                                                     Unchecked="ShowHideMenuButton_Unchecked"
                                                     Background="Transparent"
                                                     helpers:ThemeHelper.CheckedBackgroundBrush="Transparent"
                                                     helpers:ThemeHelper.CheckedBrush="Transparent"
                                                     helpers:ThemeHelper.FocusBackgroundBrush="Transparent"
                                                     helpers:ThemeHelper.FocusBrush="Transparent"
                                                     Template="{StaticResource SlidingMenuRadToggleButtonTemplate}">
                                <telerik:RadToggleButton.Style>
                                    <Style TargetType="telerik:RadToggleButton">
                                        <Setter Property="helpers:ThemeHelper.MouseOverBackgroundBrush" Value="{StaticResource NoThemeMouseOverBackgroundBrush}"/>
                                        <Setter Property="helpers:ThemeHelper.PressedBackgroundBrush" Value="{StaticResource NoThemeMouseOverBackgroundBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source={x:Static properties:Settings.Default}, Path=IsDark}" Value="True">
                                                <Setter Property="helpers:ThemeHelper.MouseOverBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=MouseOverBackgroundBrush}"/>
                                                <Setter Property="helpers:ThemeHelper.PressedBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=MouseOverBackgroundBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </telerik:RadToggleButton.Style>
                                <icon:PackIconPhosphorIcons Width="18" Height="18">
                                    <icon:PackIconPhosphorIcons.Style>
                                        <Style TargetType="icon:PackIconPhosphorIcons">
                                            <Setter Property="Kind" Value="LayoutFill"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=IsChecked,ElementName=ShowHideMenuButton}" Value="True">
                                                    <Setter Property="Kind" Value="Layout"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </icon:PackIconPhosphorIcons.Style>
                                </icon:PackIconPhosphorIcons>
                            </telerik:RadToggleButton>
                            <telerik:RadToggleButton x:Name="SlidingMenuButton"
                                                     WindowChrome.IsHitTestVisibleInChrome="True"
                                                     Padding="10"
                                                     BorderThickness="0"
                                                     Visibility="{Binding Path=IsChecked, ElementName=ShowHideMenuButton, Converter={StaticResource InvertedBooleanToVisibilityConverter}}" 
                                                     IsChecked="False"
                                                     VerticalAlignment="Center"                                                         
                                                     Cursor="Hand"
                                                     Checked="SlidingMenuButton_Checked"
                                                     Unchecked="SlidingMenuButton_Unchecked"
                                                     Background="Transparent"
                                                     helpers:ThemeHelper.CheckedBackgroundBrush="Transparent"
                                                     helpers:ThemeHelper.CheckedBrush="Transparent"
                                                     helpers:ThemeHelper.FocusBackgroundBrush="Transparent"
                                                     helpers:ThemeHelper.FocusBrush="Transparent"
                                                     Template="{StaticResource SlidingMenuRadToggleButtonTemplate}">
                                <telerik:RadToggleButton.Style>
                                    <Style TargetType="telerik:RadToggleButton">
                                        <Setter Property="helpers:ThemeHelper.MouseOverBackgroundBrush" Value="{StaticResource NoThemeMouseOverBackgroundBrush}"/>
                                        <Setter Property="helpers:ThemeHelper.PressedBackgroundBrush" Value="{StaticResource NoThemeMouseOverBackgroundBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source={x:Static properties:Settings.Default}, Path=IsDark}" Value="True">
                                                <Setter Property="helpers:ThemeHelper.MouseOverBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=MouseOverBackgroundBrush}"/>
                                                <Setter Property="helpers:ThemeHelper.PressedBackgroundBrush" Value="{telerik:Windows11Resource ResourceKey=MouseOverBackgroundBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>m.ico</ApplicationIcon>
    <!-- 판 — 프로그램 정보 창(Commons\AppInfo)에 보인다. 제품 버전 뒤 +커밋 해시는 빌드 때 SDK 가 붙인다(2026-10-22 §21-5) -->
    <Version>1.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- 빌드 날짜 — 프로그램 정보 창 -->
    <AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::Now.ToString('yyyy-MM-dd'))" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Assets\Fonts\high1 Wonchuri Title B.ttf" />
    <None Remove="Assets\Fonts\high1 Wonchuri Title L.ttf" />
    <None Remove="Assets\Fonts\high1 Wonchuri Title M.ttf" />
    <None Remove="Assets\Fonts\KoPubWorld Dotum Bold.ttf" />
    <None Remove="Assets\Fonts\KoPubWorld Dotum Light.ttf" />
    <None Remove="Assets\Fonts\KoPubWorld Dotum Medium.ttf" />
    <None Remove="Assets\Fonts\ROKG_R.TTF" />
    <None Remove="Assets\Images\m.ico" />
    <None Remove="Assets\Images\m.png" />
    <None Remove="Assets\Images\marker_black.png" />
    <None Remove="Assets\Images\marker_blue.png" />
    <None Remove="Assets\Images\marker_grey.png" />
    <None Remove="Assets\Images\marker_red.png" />
    <None Remove="Assets\Images\noimage.png" />
    <None Remove="Assets\Images\Samsung_black.png" />
    <None Remove="Assets\Images\samsung_blue.png" />
    <None Remove="Assets\Images\samsung_white.png" />
    <None Remove="Assets\MBTiles\os_1-6.mbtiles" />
    <None Remove="Assets\Pdfs\guideline_2026-30.pdf" />
    <None Remove="Assets\Pdfs\manual.pdf" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="m.ico" />
    <!-- 조사지점 마스터 초기본(조사자 번들 sites-20261018 · 생태현황 149곳 포함). 실행 폴더의 sites.json 을 [조사지점 관리]로 편집한다(CLAUDE.md §8-1) -->
    <Content Include="sites.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Fonts\KoPubWorld Dotum Bold.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Fonts\KoPubWorld Dotum Light.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Fonts\KoPubWorld Dotum Medium.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Images\m.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Images\m.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Images\Samsung_black.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Assets\Excels\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="MahApps.Metro.IconPacks" Version="6.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.7" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.8" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NinjaNye.SearchExtensions" Version="4.0.1" />
    <PackageReference Include="RestoreWindowPlace" Version="3.1.0" />
    <PackageReference Include="Scrutor" Version="6.1.0" />
    <PackageReference Include="System.ComponentModel.Composition" Version="9.0.7" />
    <PackageReference Include="System.Data.SQLite" Version="1.0.119" />
    <PackageReference Include="Telerik.UI.for.Wpf.AllControls.Xaml">
      <Version>2026.2.520</Version>
    </PackageReference>
    <PackageReference Include="WindowsAPICodePack" Version="8.0.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SDSM_Models\SDSM_Models.csproj" />
    <ProjectReference Include="..\SDSM_Core\SDSM_Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Fonts\high1 Wonchuri Title B.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Fonts\high1 Wonchuri Title L.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Fonts\high1 Wonchuri Title M.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Fonts\ROKG_R.TTF">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Images\marker_black.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Images\marker_blue.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Images\marker_grey.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Images\marker_red.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Images\noimage.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Images\samsung_blue.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Images\samsung_white.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\MBTiles\os_1-6.mbtiles">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Assets\Pdfs\manual.pdf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <!-- 지침 원본(국립환경과학원고시 제2026-30호) — 프로그램 정보 창 [지침 원본 보기](2026-10-22 §21-5) -->
    <Resource Include="Assets\Pdfs\guideline_2026-30.pdf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
</Project>